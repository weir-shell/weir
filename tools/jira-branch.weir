#!/usr/bin/env weir
// jira-branch: pick an issue, branch, empty-commit. --clean resets first.
// Originally a nu translation; in its final form the cleanup is a
// command district (line-end ! + bare command lines, no per-line tax).

type Issue = { Key: string; Title: string }

// typed argv [D:typed-argv]: --clean derives -c anyway; the explicit
// [<Short>] pins the contract against future fields stealing it
type Cli =
    {
        [<Short "c">]
        /// reset to main first
        clean: bool }
let cli = Args.load Cli

let branch = git rev-parse --abbrev-ref HEAD |> Seq.exactlyOne

if cli.clean then
    git checkout main
    git pull
    git branch -D $branch

let query = "(status = 'Requires Spec' OR status = 'To Do') AND (assignee = currentUser() OR creator = currentUser())"

let picked =
    jira issue list --jql $query --plain --columns key,summary --no-headers --order-by key --reverse
    | fzf --no-sort
    |> Seq.exactlyOne

let fields = picked |> Str.split "\t"

let issue =
    { Key = fields[0]
      Title = fields[1] }

git switch -c (issue.Key)
git commit --allow-empty -m $"{issue.Key} {issue.Title}"

let json = issue |> to json
File.write "lock.tmp.fsx" json
