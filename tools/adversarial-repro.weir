#!/usr/bin/env weir
// Repro harness for dev/plans/PLAN-adversarial-review.md. Each finding probe
// prints OK when the finding is FIXED and anything else (or a nonzero exit)
// when it still reproduces, so one script is both the bug report and the gate.
//
//     weir tools/adversarial-repro.weir --bin ./path/to/weir
//
// Probe labels match the plan's numbering exactly (F1a, F1b, F2a-F2d, F3, F4,
// F5), and so do the binding names, so a fixer never translates between the
// two documents.
//
// Probes run as CHILD processes against the binary under test: F2a RAISES
// today, and a raise is not data in-process (no general try) — a child's exit
// code is. That also follows the behavioral-pins rule: measure the built
// binary, not a parse shape.
//
// LOUD, and in every direction:
//   - a probe that fails to RUN counts as reproducing, never as a pass;
//   - a MISSING INSTRUMENT (PyYAML, `timeout`) is a named SKIP that keeps its
//     finding OPEN — absence is never a pass;
//   - "fixed" for a depth/budget probe means exit 1, a located diagnostic. A
//     crash (>=128) is NOT a fix, so those probes test == 1, never <> n.
//
// Positive controls are INDEPENDENT OF EVERY FINDING'S STATE — a control that
// passes only while a bug exists is measuring the bug twice, not controlling.
//   - control-sees-broken: the OK/BROKEN channel can report failure.
//   - control-shallow-checks: the depth runner tells a clean check from a crash.
//   - control-oracle-rejects: the external YAML oracle FAILS on a STRUCTURAL
//     mismatch (emit "abc", tell the oracle to expect "xyz") — it never reuses
//     a finding's payload, so it stays valid after every fix lands.
//
// Note the shape of this file: every command-running helper is a TOP-LEVEL
// function, because F3 is that a block `let` with a command RHS silently loses
// its reifier off the topLet spine.

type Cli = {
    /// the weir binary under test
    [<Default "weir">]
    bin: string
}

let cli = Args.load Cli

// ---- probes whose verdict weir can reach on its own ------------------------

let probeF2a =
    [ @"type Doc = { k: string }"
      @"let orig = "" a\nb"""
      @"let back = { k = orig } |> to yaml |> from yaml Doc"
      @"print (if back.k == orig then ""OK"" else ""BROKEN"")" ]

let probeF2b =
    [ @"type Doc = { k: string }"
      @"let orig = ""a\n """
      @"let back = { k = orig } |> to yaml |> from yaml Doc"
      @"print (if back.k == orig then ""OK"" else ""BROKEN"")" ]

// F3, RE-POINTED at the teaching: the shipped fix makes the off-spine
// boundary TEACH (the fifth refusal cell) rather than degrade to a
// PATH lookup — supporting the reifier there is a separate bless
// question. The probe asserts the located teaching, and silent
// success (the old degradation running a PATH tool) stays BROKEN.
let probeF3 =
    [ @"if 1 > 0 then"
      @"    let r = sh -c ""exit 7"" | complete"
      @"    print (if r.exitCode == 7 then ""OK"" else ""BROKEN"")" ]

// F4, RE-POINTED at the rejection (the plan's acceptance rule): fix (1)
// landed, so the base64 construction must REFUSE with the not-text
// teaching; and because NUL still has routes in (File.read of a
// NUL-bearing file), the argv boundary must refuse ON ITS OWN with the
// truncation diagnostic. Silent truncation (a child seeing 1 byte)
// stays BROKEN.
let probeF4construct =
    [ @"let v = Str.fromBase64 ""YQBi"""
      @"print (show (Str.length v))" ]

let probeF4argv nulPath =
    [ $"""let v = File.read "{nulPath}" |> Seq.head"""
      @"python3 -c ""import sys; print(len(sys.argv[1]))"" $v" ]

// F5: the POST-PARSE seam. Parse depth here is ~1 — no parse-depth guard can
// ever see this file — but each line DOUBLES the inferred type, so the
// checker's tree walk never returns. This is the probe a parser-only fix would
// sail past, which is the whole reason it exists separately.
let inferBomb =
    [ @"let f0 x = (x, x)"
      @"let f1 x = f0 (f0 x)"
      @"let f2 x = f1 (f1 x)"
      @"let f3 x = f2 (f2 x)"
      @"let f4 x = f3 (f3 x)"
      @"let f5 x = f4 (f4 x)"
      @"let v = f5 1"
      @"print ""done""" ]

let probeControl = [ @"print ""BROKEN""" ]

// ---- the external interop oracle -------------------------------------------
// F2c/F2d name an INTEROP property, so weir cannot referee them: the question
// is what a DIFFERENT YAML reader makes of weir's bytes. sh -c is the stated
// escape for what weir cannot do itself (repo scripting policy).

let checker =
    [ @"import sys, base64, yaml"
      @"expected = base64.b64decode(sys.argv[1]).decode(""utf-8"")"
      @"try:"
      @"    got = yaml.safe_load(sys.stdin.read())"
      @"except Exception as e:"
      @"    print(""PARSE-FAIL "" + type(e).__name__)"
      @"    sys.exit(1)"
      @"if got == {""k"": expected}:"
      @"    sys.exit(0)"
      @"print(""MISMATCH "" + repr(got))"
      @"sys.exit(1)" ]

let emitProbe b64 =
    [ @"type Doc = { k: string }"
      $"""let v = Str.fromBase64 "{b64}" """
      @"{ k = v } |> to yaml |> Seq.iter print" ]

// instrument availability — probed, never assumed. `timeout` is GNU coreutils
// and absent on a stock macOS, where sh would return 127 and a `<> 124` test
// would have read that as a pass.
let oracleReady = sh -c "python3 -c 'import yaml' 2>/dev/null" | succeeds
let timeoutReady = sh -c "command -v timeout >/dev/null 2>&1" | succeeds

// ---- runners (top-level: see the F3 note) ----------------------------------

let runProbe path =
    let r = sh -c $"'{cli.bin}' '{path}' 2>/dev/null" | complete
    r

// stderr merged in: the re-pointed F3/F4 verdicts read the teaching
// text of a REFUSAL, which lands on stderr
let runProbeMerged path =
    let r = sh -c $"'{cli.bin}' '{path}' 2>&1" | complete
    r

let checkExit path =
    let r = sh -c $"'{cli.bin}' check '{path}' >/dev/null 2>&1" | complete
    r.exitCode

// a HANG is not a crash: rc >= 128 cannot see it, so this seam needs a clock
let timedCheckExit path =
    let r = sh -c $"timeout 20 '{cli.bin}' check '{path}' >/dev/null 2>&1" | complete
    r.exitCode

let interopExit binPath probePath checkPath b64 =
    let r = sh -c $"'{binPath}' '{probePath}' 2>/dev/null | python3 '{checkPath}' '{b64}'" | complete
    r

let nest n opener =
    [1..n] |> Seq.map (fun _ -> opener) |> Str.join ""

let deepType n =
    let opened = nest n "seq<"
    let closed = nest n ">"
    $"type T = {{ x: {opened}int{closed} }}"

let deepPattern n =
    let opened = nest n "("
    let closed = nest n ")"
    $"let v = match 1 with | {opened}0{closed} -> 0 | _ -> 1"

let verdict d name lines =
    let path = $"{d}/{name}.weir"
    File.write path lines
    let r = runProbe path
    let said = r.stdout |> Seq.tryHead |> Option.defaultValue ""
    let fixed = r.exitCode == 0 && said == "OK"

    let how =
        if fixed then "fixed"
        elif said == "BROKEN" then "REPRODUCES (probe ran, verdict BROKEN)"
        else $"REPRODUCES (probe RAISED, exit {r.exitCode})"

    print $"  {name}: {how}"
    fixed

// controls get their own verb: a working control must not print the word a
// reader scans for as failure
let control d name lines =
    let path = $"{d}/{name}.weir"
    File.write path lines
    let r = runProbe path
    let said = r.stdout |> Seq.tryHead |> Option.defaultValue ""
    let ok = r.exitCode == 0 && said == "BROKEN"
    let word = if ok then "control OK (correctly saw BROKEN)" else "*** CONTROL FAILED"
    print $"  {name}: {word}"
    ok

// emit and expect are SEPARATE payloads, so a control can assert a structural
// mismatch instead of borrowing a finding's value
let interopRun d name emitB64 expectB64 =
    let probePath = $"{d}/{name}.weir"
    let checkPath = $"{d}/oracle.py"
    File.write probePath (emitProbe emitB64)
    let r = interopExit cli.bin probePath checkPath expectB64
    let said = r.stdout |> Seq.tryHead |> Option.defaultValue ""
    (r.exitCode == 0, said)

let interop d name b64 =
    let res = interopRun d name b64 b64
    let fixed = fst res
    let word = if fixed then "fixed" else "REPRODUCES"
    print $"  {name}: {word} ({snd res})"
    fixed

let interopControl d =
    // emit "abc", tell the oracle to expect "xyz": the oracle MUST reject.
    // Independent of every finding, so it stays valid after the fixes land.
    let res = interopRun d "control-oracle-rejects" "YWJj" "eHl6"
    let rejected = not (fst res)
    let word = if rejected then "control OK (correctly rejected)" else "*** CONTROL FAILED"
    print $"  control-oracle-rejects: {word}"
    rejected

let depthExit d name head =
    let path = $"{d}/{name}.weir"
    File.write path [head; @"print ""x"""]
    checkExit path

// 1 = a located diagnostic, which IS the fix. 0 means the probe stopped
// reaching the seam (re-point it deeper); >=128 is a crash, never a fix.
let depthWord code =
    if code == 1 then "fixed"
    elif code == 0 then "*** probe no longer reaches the seam — re-point it deeper"
    elif code >= 128 then $"REPRODUCES (crashed, exit {code})"
    else $"REPRODUCES (exit {code})"

within tmp d
    print $"weir under test: {cli.bin}"
    print ""
    print "round-trip findings (weir refereeing itself):"

    let f2a = verdict d "F2a-block-scalar-roundtrip" probeF2a
    let f2b = verdict d "F2b-trailing-ws-roundtrip" probeF2b

    File.write $"{d}/F3-reifier-in-block-let.weir" probeF3
    let f3r = runProbeMerged $"{d}/F3-reifier-in-block-let.weir"

    let f3taught = f3r.stdout |> Seq.exists (fun l -> Str.contains "is a reifier, not a PATH program" l)
    let f3 = f3r.exitCode <> 0 && f3taught

    let f3Word =
        if f3 then "fixed (off-spine reifier teaches, fifth cell)"
        elif f3r.exitCode == 0 then "REPRODUCES (the reifier degraded or PATH-resolved silently)"
        else $"REPRODUCES (refused WITHOUT the reifier teaching, exit {f3r.exitCode})"

    print $"  F3-reifier-in-block-let: {f3Word}"

    // F4 verdicts run OUTSIDE the probe (both faces are REJECTIONS now,
    // and a raise is not data in-process)
    File.write $"{d}/f4-construct.weir" probeF4construct
    sh -c $"printf 'a\\0b' > '{d}/f4-nul.bin'"
    File.write $"{d}/f4-argv.weir" (probeF4argv $"{d}/f4-nul.bin")

    let f4c = runProbeMerged $"{d}/f4-construct.weir"

    let f4cTaught = f4c.stdout |> Seq.exists (fun l -> Str.contains "it contains NUL bytes" l)
    let f4cFixed = f4c.exitCode <> 0 && f4cTaught

    let f4cWord =
        if f4cFixed then "fixed (construction refused, not-text teaching)"
        elif f4c.exitCode == 0 then "REPRODUCES (NUL string constructed silently)"
        else $"REPRODUCES (refused WITHOUT the teaching, exit {f4c.exitCode})"

    print $"  F4-nul-fromBase64: {f4cWord}"

    let f4a = runProbeMerged $"{d}/f4-argv.weir"
    let f4aSaid = f4a.stdout |> Seq.tryHead |> Option.defaultValue ""

    let f4aTaught = f4a.stdout |> Seq.exists (fun l -> Str.contains "would silently truncate" l)
    let f4aFixed = f4a.exitCode <> 0 && f4aTaught

    let f4aWord =
        if f4aFixed then "fixed (argv boundary refused, truncation named)"
        elif f4aSaid == "1" then "REPRODUCES (child saw 1 byte — silent truncation)"
        else $"REPRODUCES (said '{f4aSaid}', exit {f4a.exitCode})"

    print $"  F4-nul-truncates-at-argv: {f4aWord}"
    let f4 = f4cFixed && f4aFixed

    print ""
    print "interop findings (an EXTERNAL YAML reader referees):"
    File.write $"{d}/oracle.py" checker

    let interopPairs =
        [ ("F2c-inf", "LmluZg==")
          ("F2c-nan", "Lm5hbg==")
          ("F2d-cr", "YQ1i")
          ("F2d-ls", "YeKAqGI=")
          ("F2d-nel", "YcKFYg==") ]

    let interopResults =
        if oracleReady then
            interopPairs |> Seq.map (fun p -> interop d (fst p) (snd p)) |> Seq.force
        else
            print "  SKIPPED: python3 + PyYAML absent — F2c/F2d stay OPEN"
            print "  (the property is interop; weir cannot referee it, so absence is not a pass)"
            [false]

    let interopOk = interopResults |> Seq.forall (fun b -> b)

    print ""
    print "depth guards:"
    let shallow = depthExit d "shallow-10" (deepType 10)
    print $"  control-shallow-checks: depth 10 -> exit {shallow} (expect 0)"

    let deepT = depthExit d "type-20000" (deepType 20000)
    let f1a = deepT == 1
    print $"  F1a-type-grammar: {depthWord deepT} (depth 20000)"

    let deepP = depthExit d "pattern-20000" (deepPattern 20000)
    let f1b = deepP == 1
    print $"  F1b-pattern-grammar: {depthWord deepP} (depth 20000)"

    print "  (type: Option<...>, Map<string, ...>, {| a: ... |} nest identically)"
    print "  (pattern: tuple, ctor, list, cons-chain, let-binder, lambda-param too)"

    print ""
    print "inference budget:"
    let bombPath = $"{d}/infer-bomb.weir"
    File.write bombPath inferBomb

    let f5 =
        if timeoutReady then
            let bomb = timedCheckExit bombPath
            let word = if bomb == 124 then "REPRODUCES (timed out at 20s)" else depthWord bomb
            print $"  F5-no-time-bound: {word} (149-byte file, parse depth ~1)"
            bomb == 1
        else
            print "  SKIPPED: `timeout` absent (GNU coreutils; a stock macOS has none) — F5 stays OPEN"
            false

    print ""
    print "positive controls:"
    let ctl = control d "control-sees-broken" probeControl

    let oracleCtl =
        if oracleReady then
            interopControl d
        else
            print "  control-oracle-rejects: SKIPPED (no oracle to control)"
            true

    let broken =
        [ ("F1a", f1a)
          ("F1b", f1b)
          ("F2a", f2a)
          ("F2b", f2b)
          ("F2c/F2d", interopOk)
          ("F3", f3)
          ("F4", f4)
          ("F5", f5) ]
        |> Seq.where (fun p -> not (snd p))
        |> Seq.map fst
        |> Seq.force

    print ""

    if not ctl then
        fail "positive control failed: the OK/BROKEN channel could not report a deliberately-broken probe"

    if not oracleCtl then
        fail "positive control failed: the external oracle accepted a structural mismatch"

    if shallow <> 0 then
        fail $"positive control failed: a depth-10 type must check clean, got exit {shallow}"

    if (broken |> Seq.length) > 0 then
        let names = broken |> Str.join ", "
        fail $"still reproducing: {names}"

    print "all findings fixed"
