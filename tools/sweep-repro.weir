let ctlJsonlPlain d =
    let src = ["type T = { a: int }"; """let xs = ["{\"a\": 1}"; "{\"a\": 2}"] |> from jsonl T |> Seq.freeze"""; """print $"{xs |> Seq.length}" """]
    prints "2" (runAt d "30" (put d "c-jsonl.weir" src))

let ctlEqMessage d =
    let r = checkW (put d "c-eq.weir" ["let x = None == None"; """print $"{x}" """])
    codeOf r == 1 && (diagOf r |> Str.contains "equality")

let ctlTabFirstLine d = codeOf (checkW (put d "c-tab-first.weir" ["let x = <<<"; "    \ta"; "    b"; "x |> Seq.iter print"])) == 1

let ctlTabMidContent d = codeOf (checkW (put d "c-tab-mid.weir" ["let x = <<<"; "    a\tb"; "x |> Seq.iter print"])) == 0

let ctlPlanUnit d =
    codeOf (checkW (put d "c-plan-unit.weir" ["let p ="; "    plan"; """        File.write "c-out" ["x"]"""; """print $"{p |> Plan.isEmpty}" """])) == 0

let controls =
    [ ("control-runs", ctlRuns)
      ("control-check-clean", ctlCheckClean)
      ("control-check-refuses", ctlCheckRefuses)
      ("control-fmt-formats", ctlFmt)
      ("control-plan-applies (B1)", ctlPlanApplies)
      ("control-pipe-early-close (B3)", ctlPipeEarlyClose)
      ("control-exhaustive-clean (B6)", ctlExhaustiveClean)
      ("control-concrete-nonexhaustive (B6)", ctlConcreteNonExhaustive)
      ("control-pure-refuses-write (B7)", ctlPureRefusesWrite)
      ("control-readonly-admits-pwd (B7)", ctlReadonlyAdmitsPwd)
      ("control-yaml-quoted-null (B8)", ctlYamlQuotedNull)
      ("control-seq-blame (B12)", ctlSeqBlame)
      ("control-interp-hole (B16)", ctlInterpHole)
      ("control-splice-heredoc (B17)", ctlSpliceHeredoc)
      ("control-match-no-pipe (B18)", ctlMatchNoPipe)
      ("control-groupby-scalar (B19)", ctlGroupByScalar)
      ("control-overapply-user (B20)", ctlOverapplyUser)
      ("control-param-tuple (B21)", ctlParamTuple)
      ("control-plan-direct-cmd-refused (B22)", ctlPlanDirectCmd)
      ("control-plan-helper-clean (B22)", ctlPlanHelperClean)
      ("control-import-direct (B23)", ctlImportDirect)
      ("control-unit-literal (B24)", ctlUnitLiteral)
      ("control-yaml-plain-key (B25)", ctlYamlPlainKey)
      ("control-dircopy-plain (B26)", ctlDirCopyPlain)
      ("control-jsonl-plain (B27)", ctlJsonlPlain)
      ("control-eq-message (B38)", ctlEqMessage)
      ("control-tab-first-line (B39)", ctlTabFirstLine)
      ("control-tab-mid-content (B39)", ctlTabMidContent)
      ("control-plan-unit (B40)", ctlPlanUnit) ]

let probes =
    [ ("B1", b1); ("B2", b2); ("B3", b3); ("B4", b4); ("B5", b5); ("B6", b6); ("B7", b7); ("B8", b8)
      ("B9", b9); ("B10", b10); ("B11", b11); ("B12", b12); ("B13", b13); ("B14", b14); ("B15", b15)
      ("B16", b16); ("B17", b17); ("B18", b18); ("B19", b19); ("B20", b20); ("B21", b21); ("B22", b22)
      ("B23", b23); ("B24", b24); ("B25", b25); ("B26", b26); ("B27", b27); ("B28", b28)
      ("B29", b29); ("B30", b30); ("B31", b31); ("B32", b32); ("B33", b33); ("B34", b34); ("B35", b35)
      ("B36", b36); ("B37", b37); ("B38", b38); ("B39", b39); ("B40", b40) ]

// ---- the verdict channel ------------------------------------------------------

let record vpath line =
    print $"  {line}"
    File.append vpath [line]

let runProbe vpath d (label, probe) =
    let w = $"{d}/{label |> Str.replace " " "-" |> Str.replace "(" "" |> Str.replace ")" ""}"
    Dir.create w
    let res = probe w |> try result
    match res with
    | Ok fs when fs |> Seq.isEmpty -> record vpath $"{label} OK"
    | Ok fs -> record vpath $"""{label} REPRODUCES ({fs |> Str.join "; "})"""
    | Error m -> record vpath $"{label} REPRODUCES (the probe failed to run: {m})"

let runControl vpath d (label, ctl) =
    let w = $"{d}/{label |> Str.replace " " "-" |> Str.replace "(" "" |> Str.replace ")" ""}"
    Dir.create w
    let res = ctl w |> try
    match res with
    | Some true -> record vpath $"{label} OK"
    | Some false -> record vpath $"*** CONTROL FAILED: {label}"
    | None -> record vpath $"*** CONTROL FAILED: {label} (the control failed to run)"

// ---- the gate ----------------------------------------------------------------

print "bug sweep — repro gate (dev/plans/PLAN-sweep-fixes.md)"
print $"  binary: {cli.bin}"

within tmp d
    let vpath = $"{d}/verdicts"
    [] |> File.write vpath

    if not toolsReady then
        record vpath "instruments SKIP (timeout/sh/ln/kill/head/env missing) — every item stays OPEN"

    if toolsReady then
        print ""
        print "controls"
        controls |> Seq.iter (runControl vpath d)
        print ""
        print "probes"
        probes |> Seq.iter (runProbe vpath d)

    print ""
    let verdicts = File.read vpath |> Seq.freeze
    let open =
        verdicts
        |> Seq.where (fun l ->
            (l |> Str.contains "REPRODUCES") || (l |> Str.contains "CONTROL FAILED") || (l |> Str.contains "SKIP"))
        |> Seq.freeze

    let repro = verdicts |> Seq.where (fun l -> l |> Str.contains "REPRODUCES") |> Seq.length
    let ok = verdicts |> Seq.where (fun l -> (l |> Str.startsWith "B") && (l |> Str.contains " OK")) |> Seq.length
    print $"summary: {ok} probe(s) OK, {repro} REPRODUCE"

    if open |> Seq.isEmpty then
        print "ALL ITEMS FIXED"
    else
        print $"{open |> Seq.length} line(s) keep the gate shut (a SKIP or a failed control counts):"
        open |> Seq.iter (fun l -> print $"  {l}")
        exit 1
