    [ ("H1", h1); ("H2", h2); ("H3", h3); ("H4", h4); ("H5", h5); ("H6", h6); ("H7", h7); ("H8", h8)
      ("H9", h9); ("H10", h10); ("H11", h11); ("H12", h12); ("H13", h13); ("H14", h14); ("H15", h15)
      ("H16", h16); ("H17", h17); ("H18", h18); ("H19", h19); ("H20", h20); ("H21", h21); ("H22", h22)
      ("H23", h23); ("H24", h24); ("H25", h25); ("H26", h26); ("H27", h27); ("H28", h28); ("H29", h29)
      ("H30", h30); ("H31", h31); ("H32", h32); ("H33", h33); ("H34", h34); ("H35", h35); ("H36", h36)
      ("H37", h37); ("H38", h38); ("H39", h39); ("H40", h40); ("H41", h41); ("H42", h42); ("H43", h43)
      ("H44", h44); ("H45", h45); ("H46", h46); ("H47", h47); ("H48", h48); ("H49", h49); ("H50", h50)
      ("H51", h51); ("H52", h52); ("H53", h53); ("H54", h54); ("H55", h55); ("H56", h56); ("H57", h57)
      ("H58", h58); ("H59", h59); ("H60", h60) ]

// ---- the verdict channel ------------------------------------------------------

let record vpath line =
    print $"  {line}"
    File.append vpath [line]

// every probe and control gets its own temp dir
let runProbe vpath (label, probe) =
    within tmp w
        let res = probe w |> try result
        match res with
        | Ok fs when fs |> Seq.isEmpty -> record vpath $"{label} OK"
        | Ok fs -> record vpath $"""{label} REPRODUCES ({fs |> Str.join "; "})"""
        | Error m -> record vpath $"{label} REPRODUCES (the probe failed to run: {m})"

let runControl vpath (label, ctl) =
    within tmp w
        let res = ctl w |> try
        match res with
        | Some true -> record vpath $"{label} OK"
        | Some false -> record vpath $"*** CONTROL FAILED: {label}"
        | None -> record vpath $"*** CONTROL FAILED: {label} (the control failed to run)"

// ---- the gate ----------------------------------------------------------------

print "second bug hunt — repro gate (dev/plans/PLAN-hunt2-fixes.md)"
print $"  binary: {cli.bin}"

within tmp d
    let vpath = $"{d}/verdicts"
    [] |> File.write vpath

    if not toolsReady then
        record vpath "instruments SKIP (timeout/python3/curl/pgrep/pkill/kill/chmod/printf missing) — every item stays OPEN"

    if toolsReady then
        print ""
        print "controls"
        controls |> Seq.iter (runControl vpath)
        print ""
        print "probes"
        probes |> Seq.iter (runProbe vpath)

    print ""
    let verdicts = File.read vpath |> Seq.freeze
    let open =
        verdicts
        |> Seq.where (fun l ->
            (l |> Str.contains "REPRODUCES") || (l |> Str.contains "CONTROL FAILED") || (l |> Str.contains "SKIP"))
        |> Seq.freeze

    let repro = verdicts |> Seq.where (fun l -> l |> Str.contains "REPRODUCES") |> Seq.length
    let ok = verdicts |> Seq.where (fun l -> (l |> Str.startsWith "H") && (l |> Str.contains " OK")) |> Seq.length
    print $"summary: {ok} probe(s) OK, {repro} REPRODUCE"

    if open |> Seq.isEmpty then
        print "ALL ITEMS FIXED"
    else
        print $"{open |> Seq.length} line(s) keep the gate shut (a SKIP or a failed control counts):"
        open |> Seq.iter (fun l -> print $"  {l}")
        exit 1
