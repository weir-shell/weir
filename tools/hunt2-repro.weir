    let src = ["import \"./a.weir\" as A"; "let area s ="; "    match s with"; "    | Circle r -> r * 3"; "    | Square w -> w * w"; "print $\"{area (A.Circle 2)}\""]
    let r = runAt d "30" (put d "m.weir" src)
    failing [ ("an imported case types the param", prints "6" r) ]

// ---- H24: the REPL editor splits surrogate pairs ------------------------------

let h24 d =
    let left = [ "SLEEP 1500"; $"HEX {hx "print (Str.toUpper \"x😀\")"}"; "HEX 1b5b44"; "HEX 1b5b44"; "HEX 1b5b44"; $"HEX {hx "y"}0d"; "SLEEP 1000"; "HEX 04"; "SLEEP 500" ]
    let back = [ "SLEEP 1500"; $"HEX {hx "print (Str.toUpper \"a😀b\")"}"; "HEX 1b5b44"; "HEX 1b5b44"; "HEX 1b5b44"; "HEX 7f0d"; "SLEEP 1000"; "HEX 04"; "SLEEP 500" ]
    failing [
        ("Left over an emoji", ptyLines d left |> Seq.contains "XY😀")
        ("Backspace over an emoji", ptyLines d back |> Seq.contains "AB")
    ]

// ---- H25: path completion inserts unquoted paths ------------------------------

let h25 d =
    let _s = put d "my file.txt" ["SPACE-OK"]
    let _q = put d "qu\"ote.txt" ["QUOTE-OK"]
    let tab prefix = [ "SLEEP 1500"; $"HEX {hx prefix}09"; "SLEEP 800"; "HEX 0d"; "SLEEP 1000"; "HEX 04"; "SLEEP 500" ]
    failing [
        ("a path with a space", ptyLines d (tab "cat my") |> Seq.contains "SPACE-OK")
        ("a path with a quote", ptyLines d (tab "cat qu") |> Seq.contains "QUOTE-OK")
    ]

// ---- H26: piped REPL: an incomplete line swallows the rest -------------------

let h26 d =
    let r = piped d ["let x = [1;"; ""; "print (Str.toUpper \"after\")"; "print (Str.toUpper \"later\")"]
    let o = outOf r
    failing [ ("a blank line ends the pending entry", (o |> Str.contains "AFTER") && (o |> Str.contains "LATER")) ]

// ---- H27: Enter typed before the REPL is ready -------------------------------

let h27 d =
    let scen = [ $"HEX {hx "print (Str.toUpper \"early\")"}0d"; "SLEEP 2500"; $"HEX {hx "print (Str.toUpper \"late\")"}0d"; "SLEEP 1000"; "HEX 04"; "SLEEP 500" ]
    let o = ptyRun d scen
    let after =
        match Str.trySplitOnce "EARLY" o with
        | Some (_, rest) -> rest
        | None -> ""
    failing [ ("an early Enter submits the early line", after |> Str.contains "toUpper") ]

// ---- H28: fmt vs LSP formatting and the shebang ------------------------------

let formatSession text =
    [ lspInit
      $"MSG {{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{{\"textDocument\":{{\"uri\":\"file:///w/x.weir\",\"languageId\":\"weir\",\"version\":1,\"text\":{text}}}}}}}"
      """MSG {"jsonrpc":"2.0","id":5,"method":"textDocument/formatting","params":{"textDocument":{"uri":"file:///w/x.weir"},"options":{"tabSize":4,"insertSpaces":true}}}"""
      "SLEEP 800"
      "CLOSE" ]

let h28 d =
    let p = put d "h28.weir" ["#!/usr/bin/env weir"; "print \"a\""; "let x = <<<"]
    let rFmt = fmtW p
    let fe = errOf rFmt
    let shebang = reply 5 (lspRun d (formatSession "\"#!/usr/bin/env weir  \\nlet x=1\\nprint (show x)\\n\""))
    let finalNl = reply 5 (lspRun d (formatSession "\"let x=1\\nprint (show x)\""))
    let refused = reply 5 (lspRun d (formatSession "\"#!/usr/bin/env weir\\n  print \\\"a\\\"\\n\""))

    failing [
        ($"fmt's error line under a shebang ({fe})", (fe |> Str.contains "line 3") && not (fe |> Str.contains "line 2"))
        ("LSP trims the shebang", shebang |> Str.contains "\"newText\": \"#!/usr/bin/env weir  \\n")
        ("LSP omits the final newline", finalNl |> Str.contains "print (show x)\\n\"")
        ("LSP indents where the CLI refuses", (refused |> Str.contains "\"id\": 5") && not (refused |> Str.contains "newText"))
    ]

// ---- H29: LSP protocol --------------------------------------------------------

let hover id = $"MSG {{\"jsonrpc\":\"2.0\",\"id\":{id},\"method\":\"textDocument/hover\",\"params\":{{\"textDocument\":{{\"uri\":\"file:///w/x.weir\"}},\"position\":{{\"line\":0,\"character\":0}}}}}}"

let didOpen = """MSG {"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///w/x.weir","languageId":"weir","version":1,"text":"print \"a\"\n"}}}"""

let lspExit = """MSG {"jsonrpc":"2.0","method":"exit"}"""

let h29 d =
    let throwing = lspRun d [ lspInit; didOpen; """MSG {"jsonrpc":"2.0","id":5,"method":"textDocument/hover","params":{"textDocument":{"uri":"file:///w/x.weir"},"position":{"line":1e30,"character":1}}}"""; "SLEEP 800"; "CLOSE" ]
    let unknown = lspRun d [ lspInit; """MSG {"jsonrpc":"2.0","id":6,"method":"weir/noSuchMethod","params":{}}"""; "SLEEP 800"; "CLOSE" ]
    let badJson = lspRun d [ lspInit; "BAD {\"jsonrpc\":\"2.0\",\"id\":"; hover 9; "SLEEP 800"; "CLOSE" ]
    let noShutdown = lspRun d [ lspInit; lspExit; "SLEEP 800" ]
    let afterShutdown = lspRun d [ lspInit; """MSG {"jsonrpc":"2.0","id":10,"method":"shutdown"}"""; hover 11; "SLEEP 800"; lspExit; "SLEEP 500" ]
    let lower = lspRun d [ lspInit; hover 12 |> Str.replace "MSG " "LOWER "; "SLEEP 800"; "CLOSE" ]
    let has needle lines = lines |> Seq.exists (Str.contains needle)

    failing [
        ("a throwing handler answers", reply 5 throwing <> "")
        ("unknown method -> -32601", reply 6 unknown |> Str.contains "-32601")
        ("invalid JSON -> -32700", has "-32700" badJson)
        ("exit without shutdown exits 1", noShutdown |> Seq.contains "EXIT 1")
        ("a request after shutdown -> InvalidRequest", reply 11 afterShutdown |> Str.contains "-32600")
        ("a lowercase content-length header", reply 12 lower <> "")
    ]

// ---- H30: fmt flip-flops forever ------------------------------------------------

let h30 d =
    let p = put d "h30.weir" ["match {((}"; "| _ -> 1"]
    let pass () =
        let _r = fmtW p
        File.read p |> Str.join "\n"
    let a = pass ()
    let b = pass ()
    let c = pass ()
    failing [ ("fmt is not idempotent on `match {((}`", a == b && b == c) ]

// ---- H31: fmt changes whether a file checks ----------------------------------

let h31Case d (name, hex) =
    let p = $"{d}/h31-{name}.weir"
    File.writeBytes p (Bytes.fromHex hex)
    let before = codeOf (checkW p)
    let _f = fmtW p
    let after = codeOf (checkW p)
    ($"{name} (check {before} -> {after})", before == after)

let h31 d =
    [ ("trailing U+3000", $"{hx "print \"a\""}e38080" + "0a"); ("trailing U+2028", $"{hx "print \"a\""}e280a8" + "0a") ]
    |> Seq.map (h31Case d)
    |> failing

// ---- H32: run time quadratic in a statement's physical lines ------------------

let h32 d =
    let body = [0..47999] |> Seq.map (fun i -> $"    line {i}")
    let p = put d "h32.weir" (Seq.concat [["let t = <<<"]; body; ["print $\"{t |> Seq.length}\""]])
    let r = runAt d "8" p
    failing [ ($"a 48000-line heredoc within 8s (exit {codeOf r})", prints "48000" r) ]

// ---- H33: Path.glob bracket bodies go raw into .NET regex --------------------

let h33 d =
    ["a"; "w"; "_"; "b"] |> Seq.iter (fun n -> [""] |> File.write $"{d}/{n}")
    let glob i pat = runAt d "30" (put d $"g{i}.weir" [$"Path.glob @\"{pat}\" |> Seq.iter print"])
    let rRange = glob 1 "[z-a]"
    let rEmpty = glob 2 "[]"
    let rBang = glob 3 "[!]"
    let rClass = glob 4 @"[\w]"
    let quiet r = codeOf r < 128 && not (leaks (diagOf r))
    failing [
        ("[z-a]", quiet rRange)
        ("[]", quiet rEmpty)
        ("[!]", quiet rBang)
        ("[\\w] matches like regex \\w", codeOf rClass < 128 && not (rClass.stdout |> Seq.contains "a"))
    ]

// ---- H34: no field completion on anonymous records ----------------------------

let completeField decls =
    let typedDecls = decls |> Seq.collect (fun l -> [$"HEX {hx l}0d"; "SLEEP 800"])
    Seq.concat [["SLEEP 1500"]; typedDecls; [$"HEX {hx "r.zn"}09"; "SLEEP 600"; $"HEX {hx " |> Str.toUpper |> print"}0d"; "SLEEP 1000"; "HEX 04"; "SLEEP 500"]]

let h34 d =
    let lines = ptyLines d (completeField ["let r = {| zname = \"xq\"; zport = 1 |}"])
    failing [ ("r.zn<Tab> on an anonymous record", lines |> Seq.contains "XQ") ]

// ---- H35: `-e ''` / `-e '// c'` print a bare ^ ---------------------------------

let h35 d =
    [ ("-e ''", ""); ("-e '// c'", "// c") ]
    |> Seq.map (fun (name, prog) ->
        let r =
            within cd d
                let x = timeout 30 $cli.bin -e $prog | complete
                x
        (name, codeOf r < 128 && (diagOf r |> Str.isMatch @"[A-Za-z]{4,}")))
    |> failing

// ---- H36/H37: REPL directive and echo messages --------------------------------

let h36 d =
    let r = piped d ["#quit now"; "print (Str.toUpper \"still\")"]
    failing [ ("#quit now says did-you-mean #quit", not (outOf r + errOf r |> Str.contains "Did you mean '#quit'")) ]

let h37 d =
    let r = piped d ["let (a, b) = (1, \"s\")"]
    let lines = Seq.append (r.stdout) (r.stderr) |> Seq.freeze
    failing [ ("a destructuring let echoes its values", lines |> Seq.exists (Str.isMatch @"(^|\s)a\b.*=\s*1\b")) ]

// ---- H38: error column past the end of a joined continuation line --------------

let h38 d =
    let src = ["d"; "    within lock\"\"t"; "    w"]
    let r = checkW (put d "h38.weir" src)
    let ok =
        match Str.rmatch @"h38\.weir:(\d+):(\d+)" (diagOf r) with
        | Some [l; c] ->
            let line = src |> Seq.tryItem (Str.toInt l - 1) |> Option.defaultValue ""
            Str.toInt c <= Str.length line + 1
        | _ -> false
    failing [ ("the reported column lies on its line", codeOf r == 1 && ok) ]

// ---- H39: a timed-out retry reports configured attempts ------------------------

let h39 d =
    let r = runAt d "30" (put d "h39.weir" ["retry attempts=50 delay=200ms timeout=(Some 1s)"; "    false"; "print \"x\""])
    failing [ ("timed out after ~5 tries, says 50", codeOf r == 1 && not (errOf r |> Str.contains "50 attempt")) ]

// ---- H40/H41: JSON messages ------------------------------------------------------

let h40 d =
    let file = "h40.weir"
    let r = runAt d "30" (put d file ["type T = { a: string }"; """let v = ["{\"a\": \"\\ud800\"}"] |> from json T"""; "print v.a"])
    failing [ ("a lone surrogate escape", cleanRaise file r) ]

let h41 d =
    let rBool = runAt d "30" (put d "h41-bool.weir" ["type T = { a: int }"; """let v = ["{\"a\": true}"] |> from json T"""; "print $\"{v.a}\""])
    let rStr = runAt d "30" (put d "h41-str.weir" ["type T = { a: int }"; """let v = ["{\"a\": \"s\"}"] |> from json T"""; "print $\"{v.a}\""])
    failing [
        ("got True", codeOf rBool == 1 && not (errOf rBool |> Str.contains "got True"))
        ("got String", codeOf rStr == 1 && not (errOf rStr |> Str.contains "got String"))
    ]

// ---- H42: a comma between record-literal fields --------------------------------

let h42 d =
    let r = checkW (put d "h42.weir" ["type T = { a: int; b: int }"; "let v = { a = 1, b = 2 }"; "print $\"{v.a}\""])
    let t = diagOf r |> Str.toLower
    failing [ ("the comma is taught", codeOf r == 1 && (t |> Str.contains "comma") && not (t |> Str.contains "no declared record")) ]

// ---- H43: show doubles the parens around tuple payloads -------------------------

let h43 d =
    let rSome = runAt d "30" (put d "h43-some.weir" ["print (show (Some (1, 2)))"])
    let rPlan = runAt d "30" (put d "h43-plan.weir" ["let p ="; "    plan"; "        File.copy \"a\" \"b\""; "print (show p)"])
    failing [
        ("Some (1, 2)", prints "Some (1, 2)" rSome)
        ("a Plan op", codeOf rPlan == 0 && not (outOf rPlan |> Str.contains "(("))
    ]

// ---- H44: Path.tempRoot called "the pure query" ----------------------------------

let h44 d =
    let r = checkW (put d "h44.weir" ["let pure t () = Path.tempRoot ()"; "print (t ())"])
    let refuses = codeOf r == 1
    failing [ ("SKILL calls Path.tempRoot the pure query while pure refuses it", not (refuses && (skillText () |> Str.contains "`Path.tempRoot ()` is the pure query"))) ]

// ---- H45: `sh -c "exit 3" |> try` --------------------------------------------------

let h45 d =
    let r = checkW (put d "h45.weir" ["let r = sh -c \"exit 3\" |> try"; "print $\"{r}\""])
    failing [ ("a raw Expecting", codeOf r == 1 && not (diagOf r |> Str.contains "Expecting")) ]

// ---- H46: `| _ | None` unreachable message misplaced ------------------------------

let h46 d =
    let r = checkW (put d "h46.weir" ["let f o ="; "    match o with"; "    | Some 1 -> \"one\""; "    | _ | None -> \"other\""; "print (f (Some 1))"])
    failing [ ("'the arm below' with no arm below", codeOf r == 1 && not (diagOf r |> Str.contains "arm below")) ]

// ---- H47: invalid UTF-8 source (R5) -------------------------------------------------

let h47 d =
    let p = $"{d}/h47.weir"
    File.writeBytes p (Bytes.fromHex $"{hx "print \"a"}ff220a")
    let r = runAt d "30" p
    // an unreadable source is the entry-read family (exit 2), located
    failing [ ("a 0xFF byte runs as U+FFFD", (codeOf r == 1 || codeOf r == 2) && (diagOf r |> Str.contains "h47.weir:1:")) ]

// ---- H48: a block of 500+ statements (R7) --------------------------------------------

let h48 d =
    let p = put d "h48.weir" (Seq.concat [["if 1 > 0 then"]; Seq.replicate 600 "    print \"x\""])
    let r = runAt d "60" p
    failing [ ($"600 statements in one block (exit {codeOf r})", codeOf r == 0 && (r.stdout |> Seq.length) == 600) ]

// ---- H49: poll interval=0s busy-loops ---------------------------------------------

let h49 d =
    let r = runAt d "10" (put d "h49.weir" ["poll timeout=1s interval=0s"; "    false"])
    failing [ ("interval=0s", codeOf r == 1 && (diagOf r |> Str.contains "interval") && not (diagOf r |> Str.contains "attempt(s)")) ]

// ---- H50: Uuid.parse accepts surrounding whitespace (R6) ---------------------------

let h50 d =
    let rParse = runAt d "30" (put d "h50-p.weir" ["let s = \" 6ba7b810-9dad-11d1-80b4-00c04fd430c8\""; "print $\"{Uuid.parse s}\""])
    let rTry = runAt d "30" (put d "h50-t.weir" ["let s = \"6ba7b810-9dad-11d1-80b4-00c04fd430c8 \""; "print $\"{Uuid.tryParse s}\""])
    failing [ ("Uuid.parse \" …\"", cleanRaise "h50-p.weir" rParse); ("Uuid.tryParse \"… \"", prints "None" rTry) ]

// ---- H51: float-field record == message -------------------------------------------

let h51 d =
    let r = checkW (put d "h51.weir" ["type P = { x: float }"; "let a = { x = 1.0 }"; "print $\"{a == a}\""])
    failing [ ("names Float.near", codeOf r == 1 && (diagOf r |> Str.contains "Float.near")) ]

// ---- H52: union-only Args.load: `build --help` -------------------------------------

let h52 d =
    let src = ["type BuildArgs = { target: string }"; "type Cmd ="; "    | Build of BuildArgs"; "    | Clean"; "let c = Args.load Cmd"; "print $\"{c}\""]
    let r = runArgs d (put d "h52.weir" src) ["build"; "--help"]
    failing [ ("build --help is scoped", codeOf r == 0 && (outOf r |> Str.contains "--target") && not (outOf r |> Str.contains "clean")) ]

// ---- H53: single-case union destructuring --------------------------------------------

let h53 d =
    let r = runAt d "30" (put d "h53.weir" ["type W = W of int"; "let un (W x) = x"; "print $\"{un (W 3)}\""])
    failing [ ("let un (W x) = x", prints "3" r) ]

// ---- H54: contracts/imports raw .NET text --------------------------------------------

let h54 d =
    Dir.create $"{d}/adir"
    let case i src = runAt d "10" (put d $"h54-{i}.weir" src)
    let rDir = case 1 ["import \"./adir\" as A"; "print \"x\""]
    let rZero = case 2 ["import \"/dev/zero\" as A"; "print \"x\""]
    let rLockDir = case 3 ["within lock \"adir\""; "    print \"in\""]
    let rLockEmpty = case 4 ["within lock \"\""; "    print \"in\""]
    let rNeg = case 5 ["within lock \"l.lock\" timeout=-1s"; "    print \"in\""]
    failing [
        ("importing a directory", cleanRaise "h54-1.weir" rDir)
        ("importing /dev/zero", cleanRaise "h54-2.weir" rZero)
        ("within lock on a directory", cleanRaise "h54-3.weir" rLockDir)
        ("within lock \"\"", cleanRaise "h54-4.weir" rLockEmpty)
        ("timeout=-1s accepted", codeOf rNeg == 1 && not (outOf rNeg |> Str.contains "in"))
    ]

// ---- H55: HTTP auth/cookie/redirect -----------------------------------------------

let h55Auth u = $$<<<
    let r = Http.send { Http.get "$u/echo" with auth = Basic ("u", Secret.of "p"); headers = [("Authorization", "Bearer zz")] }
    r.body |> Seq.iter print

let h55Cookie u = $$<<<
    let r = Http.send { Http.get "$u/cross" with headers = [("Cookie", "sid=1")] }
    print $"{r.status}"
    r.body |> Seq.iter print

let h55Loop u = $$<<<
    let r = Http.send (Http.get "$u/loop")
    print $"{r.status}"

let h55Body d port =
    let u = $"http://127.0.0.1:{port}"
    let rAuth = runAt d "30" (put d "h55-auth.weir" (h55Auth u))
    let rCookie = runAt d "30" (put d "h55-cookie.weir" (h55Cookie u))
    let rLoop = runAt d "60" (put d "h55-loop.weir" (h55Loop u))
    let merged = rAuth.stdout |> Seq.exists (fun l -> (l |> Str.contains "Basic") && (l |> Str.contains "Bearer"))
    failing [
        ("Basic auth + Authorization merged", codeOf rAuth < 128 && not merged && not (leaks (diagOf rAuth)))
        ("Cookie follows a cross-origin redirect", codeOf rCookie < 128 && not (outOf rCookie |> Str.contains "sid=1"))
        ("a redirect loop returns 302 as data", codeOf rLoop == 1 && not (leaks (diagOf rLoop)))
    ]

let h55 d = withRawServer d 9 (h55Body d)

// ---- H56: contracts small inconsistencies -------------------------------------------

let h56 d =
    let _m = put d "m.weir" ["module M"; "let v : int"; "let v = 1"]
    let rSome = checkW (put d "a.weir" ["import \"./m.weir\" as Some"; "print $\"{Some.v}\""])
    Dir.create $"{d}/.weir/modules"
    Dir.create $"{d}/.weir/types"
    let _x1 = put $"{d}/.weir/modules" "x.weir" ["module X"; "let v : int"; "let v = 1"]
    let _x2 = put $"{d}/.weir/types" "x.weir" ["module X"; "let w : int"; "let w = 2"]
    let rShadow = checkW (put d "b.weir" ["import \"weir:x\" as X"; "print $\"{X.v}\""])

    let port = freePort 10
    let w = $"{d}/p"
    Dir.create $"{w}/.weir"
    let lock = $$<<<
        {"schemaVersion":1,"artifacts":[{"kind":"module","name":"m","url":"http://127.0.0.1:$port/m.weir","sha256":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","path":"modules/m.weir"}]}
    let _l = put $"{w}/.weir" "lock.json" lock
    let handler = fun req -> HttpServerResponse { status = 200; headers = []; body = Text "changed" }
    let rMis =
        within serve srv = { port = port; maxConcurrent = 4 } handler
            within cd w
                let x = timeout 30 $cli.bin restore | complete
                x

    failing [
        ("`as Some` accepted as an alias", codeOf rSome == 1 && (diagOf rSome |> Str.contains "a.weir:1:"))
        (".weir/modules silently shadows .weir/types", diagOf rShadow |> Str.contains "types")
        ("restore mismatch says `weir add schema` for a module", codeOf rMis == 1 && (diagOf rMis |> Str.contains "weir add module") && not (diagOf rMis |> Str.contains "weir add schema"))
    ]

// ---- H57: REPL small inconsistencies -----------------------------------------------

let h57 d =
    let r = piped d [ "let zz = 41"; "#history"; "#alias let = echo"; "#help map"; """#infer ["{\"dE\": null}"] from json as Root""" ]
    let o = (outOf r + "\n" + errOf r)
    let lo = o |> Str.toLower
    // DECISIONS is append-only: the stale row stays, a superseding row fixes it
    let staleIt =
        File.read $"{repo}/docs/DECISIONS.md"
        |> Seq.exists (fun l -> l |> Str.startsWith "| repl-it-let |")
        |> not
    failing [
        ("#alias let = … accepted", (lo |> Str.contains "keyword") || (lo |> Str.contains "reserved"))
        ("piped #history says (empty)", not (o |> Str.contains "(empty)"))
        ("the repl-it DECISIONS row says a let binds it", not staleIt)
        ("#help map lacks the doc #help Seq.map shows", o |> Str.contains "Apply a function")
        ("#infer note spells 'DE' for dE", o |> Str.contains "'dE'")
    ]

// ---- controls ----------------------------------------------------------------

let ctlRuns d = prints "hello" (runAt d "30" (put d "c-runs.weir" ["print \"hello\""]))

let ctlCheckClean d = codeOf (checkW (put d "c-clean.weir" ["print \"hello\""])) == 0

let ctlCheckRefuses d = codeOf (checkW (put d "c-refuses.weir" ["let x = 1 + \"a\""; "print x"])) == 1

let ctlPipedRepl d = outOf (piped d ["print (Str.toUpper \"piped\")"]) |> Str.contains "PIPED"

let ctlPty d = ptyLines d (typed "print (Str.toUpper \"pty\")") |> Seq.contains "PTY"

let ctlPtyRecordField d =
    ptyLines d (completeField ["type R = { zname: string; zport: int }"; "let r = { zname = \"xq\"; zport = 1 }"]) |> Seq.contains "XQ"

let ctlLsp d =
    let lines = lspRun d [ lspInit; didOpen; hover 2; "SLEEP 800"; """MSG {"jsonrpc":"2.0","id":3,"method":"shutdown"}"""; lspExit; "SLEEP 500" ]
    (reply 1 lines |> Str.contains "capabilities") && (reply 2 lines |> Str.contains "print") && (lines |> Seq.contains "EXIT 0")

let ctlLspFormat d = reply 5 (lspRun d (formatSession "\"let x=1\\nprint (show x)\\n\"")) |> Str.contains "let x = 1"

let ctlModuleMember d =
    let _doc = put d "doc.weir" h6Doc
    prints "Para \"x\"" (runAt d "30" (put d "c.weir" ["import \"./doc.weir\" as Doc"; "let n = Doc.Para \"x\""; "print $\"{n}\""]))

let ctlModuleSigned d =
    let _m = put d "m.weir" ["module M"; "let helper : unit -> int"; "let helper () = touch mark | exitCode"]
    let r = runAt d "30" (put d "main.weir" ["import \"./m.weir\" as M"; "print $\"{M.helper ()}\""])
    prints "0" r && File.exists $"{d}/mark"

let ctlModuleDirectCmd d =
    let _m = put d "m.weir" ["module M"; "let _v = touch mark | complete"]
    let r = runAt d "30" (put d "main.weir" ["import \"./m.weir\" as M"; "print \"main\""])
    codeOf r == 1 && not (File.exists $"{d}/mark")

let ctlSecretStatement d = prints "tok" (runAt d "30" (put d "c.weir" ["let s = Secret.of \"tok\""; "echo $s"]))

let ctlSecretCapture d = prints "tok" (runAt d "30" (put d "c.weir" ["let s = Secret.of \"tok\""; "let l = $(echo $s) |> Seq.head"; "print l"]))

let ctlServeGet d =
    let port = freePort 11
    let src = $$<<<
        let handler = fun req -> HttpServerResponse { status = 200; headers = []; body = Text $"got {Str.length req.body}" }
        within serve srv = { port = $port; maxConcurrent = 2 } handler
            let b = curl -s --data-binary "0123456789" http://127.0.0.1:$port/ | line
            print b
    prints "got 10" (runAt d "30" (put d "c.weir" src))

let rawEcho port =
    let r = curl -s $"http://127.0.0.1:{port}/echo" | complete
    codeOf r == 0 && (outOf r |> Str.contains "Host: 127.0.0.1")

let ctlRawServer d = withRawServer d 12 rawEcho

let ctlRawClient d =
    let raw = serveRun d 13 "nc"
    raw |> Str.contains "HTTP/1.1 204"

let ctlRestorePlain d =
    let port = freePort 14
    let w = $"{d}/p"
    Dir.create $"{w}/.weir"
    let sha = Str.sha256 "{}"
    let lock = $$<<<
        {"schemaVersion":1,"artifacts":[{"kind":"schema","name":"a","url":"http://127.0.0.1:$port/a.json","sha256":"$sha","path":"schemas/a.json"}]}
    let _l = put $"{w}/.weir" "lock.json" lock
    let handler = fun req -> HttpServerResponse { status = 200; headers = []; body = Text "{}" }
    let r =
        within serve srv = { port = port; maxConcurrent = 4 } handler
            within cd w
                let x = timeout 30 $cli.bin restore | complete
                x
    codeOf r == 0 && File.exists $"{w}/.weir/schemas/a.json"

let ctlLocalUnionParam d =
    let src = ["type Shape ="; "    | Circle of int"; "    | Square of int"; "let area s ="; "    match s with"; "    | Circle r -> r * 3"; "    | Square w -> w * w"; "print $\"{area (Circle 2)}\""]
    prints "6" (runAt d "30" (put d "c.weir" src))

let ctlCopyUpdateOneLine d =
    prints "x:2" (runAt d "30" (put d "c.weir" ["type Cfg = { host: string; port: int }"; "let d = { host = \"h\"; port = 1 }"; "let c = { d with host = \"x\"; port = 2 }"; "print $\"{c.host}:{c.port}\""]))

let ctlFmtStable d =
    let p = put d "c.weir" ["let x=1"; "print (show x)"]
    let _a = fmtW p
    let first = File.read p |> Str.join "\n"
    let r = fmtW p
    codeOf r == 0 && first == (File.read p |> Str.join "\n") && (first |> Str.contains "let x = 1")

let ctlGlobPlain d =
    ["a"; "b"; "c"] |> Seq.iter (fun n -> [""] |> File.write $"{d}/{n}")
    prints "a\nb" (runAt d "30" (put d "c.weir" ["Path.glob \"[ab]\" |> Seq.iter print"]))

let ctlUuidParse d = prints "6ba7b810-9dad-11d1-80b4-00c04fd430c8" (runAt d "30" (put d "c.weir" ["print $\"{Uuid.parse \"6ba7b810-9dad-11d1-80b4-00c04fd430c8\"}\""]))

let ctlArgsTopHelp d =
    let src = ["type BuildArgs = { target: string }"; "type Cmd ="; "    | Build of BuildArgs"; "    | Clean"; "let c = Args.load Cmd"; "print $\"{c}\""]
    let r = runArgs d (put d "c.weir" src) ["--help"]
    codeOf r == 0 && (outOf r |> Str.contains "clean")

let ctlPollTimeoutZero d = codeOf (runAt d "10" (put d "c.weir" ["poll timeout=0s interval=1s"; "    false"])) == 1

let ctlPmapFinishes d =
    let src = ["let xs = [1; 2] |> Seq.pmap (fun i -> $(sh -c \"echo x\") |> Seq.freeze)"; "print $\"{xs |> Seq.length}\""]
    prints "2" (runAt d "30" (put d "c.weir" src))

let ctlShortBlock d = prints "x\nx" (runAt d "30" (put d "c.weir" ["if 1 > 0 then"; "    print \"x\""; "    print \"x\""]))

let ctlSaveSimple d =
    let saved = $"{d}/saved.weir"
    let _r = piped d ["let q = 5"; $"#save {saved}"]
    File.exists saved && codeOf (checkW saved) == 0

let controls =
    [ ("control-runs", ctlRuns)
      ("control-check-clean", ctlCheckClean)
      ("control-check-refuses", ctlCheckRefuses)
      ("control-piped-repl (H9 H26 H36 H37 H57)", ctlPipedRepl)
      ("control-pty-repl (H24 H25 H27)", ctlPty)
      ("control-pty-record-field (H34)", ctlPtyRecordField)
      ("control-lsp-session (H29)", ctlLsp)
      ("control-lsp-format (H28)", ctlLspFormat)
      ("control-module-member (H6)", ctlModuleMember)
      ("control-module-signed-helper (H4)", ctlModuleSigned)
      ("control-module-direct-cmd-refused (H4)", ctlModuleDirectCmd)
      ("control-secret-statement (H7)", ctlSecretStatement)
      ("control-secret-capture (H7)", ctlSecretCapture)
      ("control-serve-post (H16 H20)", ctlServeGet)
      ("control-raw-server (H14 H15 H55)", ctlRawServer)
      ("control-raw-client (H16 H17 H18)", ctlRawClient)
      ("control-restore-plain (H5 H13)", ctlRestorePlain)
      ("control-local-union-param (H23)", ctlLocalUnionParam)
      ("control-copy-update-one-line (H22)", ctlCopyUpdateOneLine)
      ("control-fmt-stable (H30)", ctlFmtStable)
      ("control-glob-plain (H33)", ctlGlobPlain)
      ("control-uuid-parse (H50)", ctlUuidParse)
      ("control-args-top-help (H52)", ctlArgsTopHelp)
      ("control-poll-timeout-zero (H49)", ctlPollTimeoutZero)
      ("control-pmap-finishes (H8)", ctlPmapFinishes)
      ("control-short-block (H48)", ctlShortBlock)
      ("control-save-simple (H10)", ctlSaveSimple) ]

// ---- H58: a lazy command let in a module or init file -------------------------

let h58 d =
    let _m = put d "m.weir" [ "module M"; "let gl : seq<string>"; "let gl = sh -c \"touch mark; echo hi\"" ]
    let main =
        put d "main.weir" [
            "import \"./m.weir\" as M"
            "print (show (File.exists \"mark\"))"
            "print (show (M.gl |> Seq.freeze))"
            "print (show (File.exists \"mark\"))"
        ]
    let r = runAt d "30" main
    let _e = put d "e.weir" [ "module E"; "let v : string"; "let v = sh -c \"echo x\" | line" ]
    let rE = checkW (put d "emain.weir" [ "import \"./e.weir\" as E"; "print E.v" ])
    failing [
        ("a lazy module let loads without spawning, runs on use", prints "false\n[\"hi\"]\ntrue" r)
        ("an eager module let is refused naming why", codeOf rE == 1 && (outOf rE + errOf rE |> Str.contains "runs the command now"))
    ]

// ---- H59: the REPL echo runs a command-backed let -------------------------------

let h59 d =
    let r = piped d [ "let g = sh -c \"touch mark; echo hi\"" ]
    let o = outOf r + "\n" + errOf r
    failing [
        ("the echo shows the type and a hint", o |> Str.contains "command-backed")
        ("the echo never runs the command", not (File.exists $"{d}/mark"))
    ]

// ---- H60: a lazy value outside any within replays its written-site cwd ----------

let h60 d =
    Dir.create $"{d}/src"
    ["a"] |> File.write $"{d}/a.txt"
    ["b"] |> File.write $"{d}/src/b.txt"
    let main =
        put d "amb.weir" [
            "let top = ls |> Seq.map _.name"
            "let inside = within cd \"src\" (ls |> Seq.map _.name)"
            "let greet = within env [Env.pair \"GREETING\" \"hi\"] $(sh -c \"echo ${GREETING:-unset}\")"
            "let _here = cd \"src\""
            "print (show (top |> Seq.freeze))"
            "print (show (inside |> Seq.freeze))"
            "print (show (greet |> Seq.freeze))"
        ]
    let r = runAt d "30" main
    let lines = r.stdout |> Seq.freeze
    let at i = lines |> Seq.tryItem i |> Option.defaultValue "<none>"
    failing [
        ("a top-level lazy value reads the cwd at use", codeOf r == 0 && at 0 == "[\"b.txt\"]")
        ("a value written inside within cd keeps it", codeOf r == 0 && at 1 == "[\"b.txt\"]")
        ("a value written inside within env keeps it", codeOf r == 0 && at 2 == "[\"hi\"]")
    ]

