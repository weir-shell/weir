#!/usr/bin/env weir
// Deep fuzz run [D:fuzz-harness]: fresh seeds, 10k+ cases per
// invariant. CI never runs fresh seeds (flaky-CI is a masked-failure
// factory) — the smoke uses the pinned seed.
//
//   tools/fuzz.weir [--seed N] [--count N]
//
// WEIR_FUZZ_STRICT_SPANS=0 is the archaeology off-switch.

// the literal-vs-computed boundary [D:default-attr], both shapes:
// count's default is a LITERAL (the attribute); seed's is COMPUTED
// (fresh nanoseconds — Option + code)
type Cli = {
    /// FsCheck replay seed (fresh nanoseconds when omitted)
    seed: Option<int>
    [<Default 10000>]
    /// cases per invariant
    count: int
}

let cli = Args.load Cli

let root = git rev-parse --show-toplevel |> Seq.head
cd $root

// hold the deep-run lock [D:masking-mechanized] so publish.sh refuses
// to swap the binary underfoot mid-run — the one window the start-of-run
// freshness gate can't close. The holder is THIS weir process (a child
// sh reports its parent's pid), alive for the whole run; a crash leaves
// a stale lock that publish clears by liveness.
ci/deep-lock.sh acquire $"{Self.pid}" | orFail "a deep fuzz run is already live — wait for it or kill it"

let seed =
    match cli.seed with
    | Some n -> $"{n}"
    | None -> $(date +%N) |> Seq.head

let count = $"{cli.count}"

let strict = Env.get "WEIR_FUZZ_STRICT_SPANS" |> Option.defaultValue "1"

print $"deep fuzz requested: seed={seed} count={count} (WEIR_FUZZ_STRICT_SPANS={strict})"

within tmp d
    let report = $"{d}/observed.txt"

    let fenv =
        Env.ofPairs
            [ ("WEIR_FUZZ_SEED", seed)
              ("WEIR_FUZZ_COUNT", count)
              ("WEIR_FUZZ_REPORT", report) ]

    // orFail streams the test output live AND carries the reproduce
    // line on failure [D:exit-reifiers]
    within env fenv
        dotnet test tests/Weir.Fuzz/Weir.Fuzz.fsproj | orFail $"deep fuzz FAILED — reproduce with: tools/fuzz.weir --seed {seed} --count {count}"

    // the instrument reports what it MEASURED [D:observed-report]: the
    // harness writes back the config it actually read; missing or
    // mismatched means the run did NOT execute the requested fuzz —
    // fail LOUD (the silent-defaults window is the receipt)
    let observed = File.read report |> Seq.head

    if observed <> $"seed={seed} count={count}" then
        fail $"deep fuzz config MISMATCH — requested seed={seed} count={count}, harness observed: {observed}"

    // on failure orFail/fail raised above and this never runs — the lock
    // goes stale (this process exits) and publish clears it by liveness
    ci/deep-lock.sh release

    print $"deep fuzz clean: {observed} (observed)"
