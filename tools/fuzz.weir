#!/usr/bin/env weir
// Deep fuzz run [D:fuzz-harness]: fresh seeds, 10k+ cases per
// invariant. CI never runs fresh seeds (flaky-CI is a masked-failure
// factory) — the smoke uses the pinned seed.
//
//   tools/fuzz.weir [seed] [count]
//
// WEIR_FUZZ_STRICT_SPANS=0 is the archaeology off-switch.

let root = git rev-parse --show-toplevel | Seq.head
cd $root

let seed =
    args
    |> Seq.tryItem 0
    |> Option.defaultWith (fun () -> $(date +%N) |> Seq.head)

let count = args |> Seq.tryItem 1 |> Option.defaultValue "10000"
let strict = Env.get "WEIR_FUZZ_STRICT_SPANS" |> Option.defaultValue "1"

print $"deep fuzz: seed={seed} count={count} (WEIR_FUZZ_STRICT_SPANS={strict})"

let fenv = Env.ofPairs [("WEIR_FUZZ_SEED", seed); ("WEIR_FUZZ_COUNT", count)]

// orFail streams the test output live AND carries the reproduce
// line on failure [D:exit-reifiers]
!fenv
    dotnet test tests/Weir.Fuzz/Weir.Fuzz.fsproj | orFail $"deep fuzz FAILED — reproduce with: tools/fuzz.weir {seed} {count}"

print $"deep fuzz clean: seed={seed} count={count}"
