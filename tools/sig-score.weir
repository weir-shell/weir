#!/usr/bin/env weir
// The command-signature gate (dev/plans/PLAN-sigs.md): `weir add sig` and the
// #sig flag check, scored offline over sample tools.
//
//     weir tools/sig-score.weir --bin ./path/to/weir [--only gitfx] [--verbose]
//     weir tools/sig-score.weir --bin ./path/to/weir --live
//
// The gate. Each tests/sigs/<sample>/ is one help FORMAT, not one real tool
// (cobra's `__complete`, git's helper, fish files, GNU rows, Go, find, clap,
// a full-help switch, the phantom headings, ...): exe/<sample> links the
// replayer (tests/sigs/replay.sh), which answers each argv from the
// sample's answers.txt — trimmed real output, cut to what the parsers read
// — so CI needs no tool installed and a run is deterministic. A fish file
// the sample ships sits under share/fish/ beside exe/ (exe/, not bin/: the
// repo ignores every bin/ directory). Per sample, in a fresh project:
// generate the signature with exe/ first on PATH, then `weir check --json
// lines.weir` and score every marked line:
//   // typo: <flag>   the check must warn naming <flag>   (miss = FN)
//   // clean          the check must stay silent          (any sig diag = FP)
//   // miss: <flag> — <why>   a known, documented miss: caught or not, it
//                     never fails the gate (a warning naming anything else
//                     is still an FP)
//   // expect-version: <line>   the generated `let version` must be <line>
// A typo line's warnings that do not name the typo count as FPs; `// clean`
// is the line's last word (`// cleanup` is no marker). Loud, in every
// direction: an FP, an unexpected FN, a probe the sample has no answer for
// (a phantom word, or a new probe — add its answer), a failed generation, a
// wrong version, a non-sig diagnostic, a sig diagnostic on an unmarked line
// (a signature that fails to load reports at its #sig line) or a check that
// crashed (an exit other than 0 or 1, or no JSON) keeps the gate shut; the
// exit code is the number of samples that failed.
//
// --live is a REPORT, never a gate: it generates against the INSTALLED tools
// named by tests/sigs/live/<tool>.weir (skipping absent ones) and scores
// those lines the same way, printing each tool's version. Versions drift,
// so it always exits 0.

type Cli = {
    /// the weir binary under test
    [<Default "weir">]
    bin: string
    /// score only this sample (or, with --live, this tool)
    only: Option<string>
    /// print every scored line, not only the failing ones
    verbose: bool
    /// report on the installed tools instead of gating on the samples
    live: bool
}

let cli = Args.load Cli

type Diag = {
    line: int
    message: string
    code: string
    severity: string
    file: string
    col: int
    endLine: Option<int>
    endCol: Option<int>
}

let here = pwd
let bin = if Str.startsWith "/" cli.bin then cli.bin else Path.combine here cli.bin
let fxRoot = Self.scriptPath |> Path.dir |> Path.dir |> (fun r -> Path.combine r "tests/sigs")
let liveRoot = Path.combine fxRoot "live"

// (lineNo, verdict, flag, text) for every marked line
let marked lines =
    lines
    |> Seq.indexed
    |> Seq.choose (fun (i, l) ->
        match l with
        | Regex @"// typo: (\S+)" f -> Some (i + 1, "typo", f, Str.trim l)
        | Regex @"// miss: (\S+)" f -> Some (i + 1, "miss", f, Str.trim l)
        | Regex @"// clean(\s|$)" _ -> Some (i + 1, "clean", "", Str.trim l)
        | _ -> None)
    |> Seq.freeze

// generate + check + score one tool in the cwd (a fresh project holding
// lines.weir); returns the verdict line and whether it failed
let score t =
    let g = ^$bin add sig $t | complete
    let c = ^$bin check --json lines.weir | complete
    let gen = Seq.append g.stdout g.stderr |> Str.join " "
    let flags =
        match gen with
        | Regex @"\((\d+) flag\(s\)" n -> n
        | _ -> "?"
    let version =
        match gen with
        | Regex @"version: (.*)\) — partial" v -> v
        | _ -> "?"
    let sigFile = $".weir/sigs/{t}.weir"
    let recorded =
        if File.exists sigFile then
            File.read sigFile |> Seq.choose (function | Regex @"^let version = ""(.*)""$" v -> Some v | _ -> None) |> Seq.tryHead
        else None
    let wantVersion =
        File.read "lines.weir" |> Seq.choose (function | Regex @"^// expect-version: (.*)$" v -> Some v | _ -> None) |> Seq.tryHead
    let versionBad =
        match wantVersion with
        | Some v -> recorded <> Some v
        | None -> false
    // a crashed check scores nothing: its exit says so, or its stdout is
    // no JSON array
    let checkOut = c.stdout |> Str.join "\n" |> Str.trim
    let crashed = (c.exitCode <> 0 && c.exitCode <> 1) || not (checkOut == "" || Str.startsWith "[" checkOut)
    let diags = if crashed || checkOut == "" then [] |> Seq.freeze else c.stdout |> from json seq<Diag> |> Seq.freeze
    let sigDiags = diags |> Seq.where (fun x -> x.code == "sig") |> Seq.freeze
    let others = diags |> Seq.where (fun x -> x.code <> "sig" && x.code <> "cmd-not-found") |> Seq.freeze
    let markedLines = File.read "lines.weir" |> marked
    let markedNos = markedLines |> Seq.map (fun (ln, _, _, _) -> ln) |> Seq.freeze
    let unmarked = sigDiags |> Seq.where (fun x -> not (Seq.contains x.line markedNos)) |> Seq.freeze
    let rows =
        markedLines
        |> Seq.map (fun (ln, kind, flag, text) ->
            let onLine = sigDiags |> Seq.where (fun x -> x.line == ln) |> Seq.freeze
            let names = onLine |> Seq.where (fun x -> flag <> "" && (x.message |> Str.contains $"'{flag}'")) |> Seq.length
            let tp = if kind <> "clean" && names > 0 then 1 else 0
            let fp = (onLine |> Seq.length) - (if kind == "clean" then 0 else names)
            let fn = if kind == "typo" && names == 0 then 1 else 0
            let known = if kind == "miss" && names == 0 then 1 else 0
            let msgs = onLine |> Seq.map (fun x -> x.message) |> Str.join " || "
            (ln, tp, fp, fn, known, text, msgs))
        |> Seq.freeze
    let sum f = rows |> Seq.map f |> Seq.sum
    let tp = sum (fun (_, a, _, _, _, _, _) -> a)
    let fp = sum (fun (_, _, a, _, _, _, _) -> a)
    let fn = sum (fun (_, _, _, a, _, _, _) -> a)
    let known = sum (fun (_, _, _, _, a, _, _) -> a)
    let genOk = g.exitCode == 0
    let bad = fp > 0 || fn > 0 || not genOk || not (Seq.isEmpty others) || versionBad || crashed || not (Seq.isEmpty unmarked)
    let verdict = if bad then "FAIL" else "ok"
    let line = $"{Str.padRight 11 t} TP={tp} FP={fp} FN={fn} known={known} flags={flags}  {verdict}"
    print (if cli.live then $"{line}  [{version}]" else line)
    if not genOk then print $"    generation failed: {gen}"
    if cli.verbose then print $"    {gen}"
    if versionBad then print $"    version: recorded {recorded}, expected {wantVersion}"
    for (ln, tp1, fp1, fn1, _, text, msgs) in rows do
        if cli.verbose || fp1 > 0 || fn1 > 0 then
            print $"    L{ln} TP={tp1} FP={fp1} FN={fn1} | {text}"
            if msgs <> "" then print $"        -> {msgs}"
    for o in others do
        print $"    non-sig diagnostic L{o.line}: [{o.code}] {o.message}"
    for u in unmarked do
        print $"    sig diagnostic on an unmarked line L{u.line}: {u.message}"
    if crashed then
        let err = c.stderr |> Str.join " "
        print $"    check crashed (exit {c.exitCode}): {err}"
    line

let gateSample vpath t =
    within tmp d
        let proj = Path.combine d "p"
        Dir.create (Path.combine proj ".weir")
        let misses = Path.combine d "misses"
        [] |> File.write misses
        let fx = Path.combine fxRoot t
        // the replayer must be the tool found, never an installed one
        if not (File.exists $"{fx}/exe/{t}") then fail $"tests/sigs/{t}: no exe/{t} replayer — the gate would score an installed tool"
        File.copy (Path.combine fx "lines.weir") (Path.combine proj "lines.weir")
        within cd proj
            within env PATH=$"{fx}/exe:/usr/bin:/bin" SIGFX_MISSES=$misses NO_COLOR=1
                let gen = score t |> Str.trim
                let missed = File.read misses |> Seq.freeze
                for m in missed do
                    print $"    unrecorded probe: {t} {m}"
                let failed = (gen |> Str.endsWith "FAIL") || not (Seq.isEmpty missed)
                File.append vpath [if failed then $"{t} FAIL" else $"{t} ok"]

let liveTool t =
    let installed = sh -c $"command -v {t} >/dev/null" | succeeds
    if not installed then
        print $"{Str.padRight 11 t} not installed — skipped"
    else
        within tmp d
            let proj = Path.combine d "p"
            Dir.create (Path.combine proj ".weir")
            File.copy (Path.combine liveRoot $"{t}.weir") (Path.combine proj "lines.weir")
            within cd proj
                within env NO_COLOR=1
                    let _line = score t |> try
                    print ""

if cli.live then
    print "command-signature live report — installed tools, not a gate (dev/plans/PLAN-sigs.md)"
    print $"  binary: {bin}"
    Dir.list liveRoot
    |> Seq.where (Str.endsWith ".weir")
    |> Seq.map Path.stem
    |> Seq.where (fun t -> cli.only == None || cli.only == Some t)
    |> Seq.iter liveTool
else
    print "command-signature gate (dev/plans/PLAN-sigs.md)"
    print $"  binary: {bin}"
    let samples =
        Dir.list fxRoot
        |> Seq.where (fun p -> File.exists (Path.combine p "lines.weir"))
        |> Seq.map Path.fileName
        |> Seq.where (fun t -> cli.only == None || cli.only == Some t)
        |> Seq.freeze
    within tmp v
        let vpath = Path.combine v "verdicts"
        [] |> File.write vpath
        for t in samples do
            gateSample vpath t
        let failing = File.read vpath |> Seq.where (Str.endsWith "FAIL") |> Seq.freeze
        let n = failing |> Seq.length
        print $"summary: {samples |> Seq.length} sample(s), {n} failing"
        if n > 0 then
            failing |> Seq.iter (fun l -> print $"  {l}")
            exit (if n > 255 then 255 else n)
