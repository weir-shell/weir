/// The interactive release driver: preflight, then each mutation of the
/// ritual behind its own confirm — cut+push the tag, wait for the
/// publish, bump the grammar's TARGET, prepare the zed rev bump. The
/// ordering that burned v0.0.25/26/30 lives in this script, not in
/// memory. Run from the weir repo root, at a terminal:
///
///     weir tools/release.weir --tag v0.0.31
///
/// Every step shows what it is about to do and waits for y/N; anything
/// else aborts with nothing half-done beyond the steps already confirmed.

type Cli = {
    /// the tag to cut, e.g. v0.0.31
    tag: string
    /// path to the tree-sitter-weir checkout (default ../tree-sitter-weir)
    grammar: Option<string>
}

let cli = Args.load Cli
let gdir = cli.grammar |> Option.defaultValue "../tree-sitter-weir"

let confirm msg =
    let a = prompt $"{msg} [y/N]"
    a == "y" || a == "Y" || a == "yes"

// ---- 1. preflight: refuse before anything mutates -------------------------
print $"== preflight for {cli.tag} =="
let pf = weir tools/release-preflight.weir --tag (cli.tag) | complete
pf.stdout |> Seq.iter print

if pf.exitCode <> 0 then
    pf.stderr |> Seq.iter printerr
    fail "preflight refused — do not tag"


// ---- 2. the tag ------------------------------------------------------------
if not (confirm $"cut AND push tag {cli.tag}?") then
    fail "aborted — nothing was tagged"

git tag (cli.tag)
git push origin (cli.tag)
print $"tagged and pushed {cli.tag} — the gated release flow is running"

// ---- 3. wait for the publish (drafts do not count) -------------------------
// the release workflow builds the binaries then a human clicks publish.
// The human SAYS when: the timed poll of the live gate proved
// unreliable, so each confirm runs the gate ONCE — a not-yet verdict
// shows itself and asks again; anything but yes aborts. The prompt is
// what blocks; the poll interval never paces the wait.
print "the release flow builds a DRAFT — review its asset list, then publish it."

let publishedNow () =
    let r = weir ci/release-published.weir | complete

    if r.exitCode == 0 then
        true
    else
        r.stdout |> Seq.iter print
        r.stderr |> Seq.iter printerr
        print "the gate says not published yet (verdicts above) — publish (or give the API a moment) and confirm again"
        false

poll timeout=8h interval=1s
    if confirm $"have you PUBLISHED {cli.tag}?" then
        publishedNow ()
    else
        fail "aborted — remember: the publish (and the grammar bump after it) is still owed"

print $"{cli.tag} is published"

// ---- 4. the grammar TARGET bump (AFTER publish, never before) --------------
if not (confirm $"bump {gdir}/TARGET_WEIR_RELEASE to {cli.tag}, commit and push?") then
    fail "aborted — remember: the grammar bump is still owed"

File.write $"{gdir}/TARGET_WEIR_RELEASE" [cli.tag]
git -C (gdir) add TARGET_WEIR_RELEASE
git -C (gdir) commit -m $"target {cli.tag}"
git -C (gdir) push
print "grammar target pushed"

// ---- 5. the zed rev ritual (the grammar main just moved) -------------------
let newRev = git -C (gdir) rev-parse HEAD |> Seq.exactlyOne

let bumped =
    File.read "editors/zed/extension.toml"
    |> Seq.map (fun l -> if Str.startsWith "rev = " l then $"rev = \"{newRev}\"" else l)
    |> Seq.force

let highlightsSame =
    diff $"{gdir}/queries/highlights.scm" editors/zed/languages/weir/highlights.scm | succeeds

if not (confirm $"pin zed to {newRev} and push STRAIGHT ON MAIN (highlights same: {highlightsSame})?") then
    fail "aborted — the zed pin is one commit stale until the ritual runs"

// straight on main by the owner's ruling: the pin bump is the ritual's
// own tail, sequenced here so the stale window closes in the same run
bumped |> File.write "editors/zed/extension.toml"

if not highlightsSame then
    File.read $"{gdir}/queries/highlights.scm" |> File.write "editors/zed/languages/weir/highlights.scm"
    git add editors/zed/languages/weir/highlights.scm

git add editors/zed/extension.toml
git commit -m $"docs: the zed grammar pin follows tree-sitter-weir main ({cli.tag} target)"
git push origin main
print ""
print $"release {cli.tag} complete — zed pin landed on main, nothing remains"
