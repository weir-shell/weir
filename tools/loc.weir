#!/usr/bin/env weir
// LOC of the F# code: every tracked .fs file, grouped by top-level
// directory (group totals descending, files descending within each
// group), with a total. The vendored tests/toml-test suite is data, not
// ours, and is left out.

let counts =
    git ls-files "*.fs"
    |> Seq.where (fun f -> not (Str.startsWith "tests/toml-test/" f))
    |> Seq.map (fun f -> (f, File.read f |> Seq.length))
    |> Seq.freeze

let group f =
    match Str.trySplitOnce "/" f with
    | Some(dir, _) -> dir
    | None -> "."

let locOf items =
    items |> Seq.map snd |> Seq.sum

counts
    |> Seq.groupBy (fst >> group)
    |> Seq.sortByDescending (snd >> locOf)
    |> Seq.iter (fun (k, items) ->
        print $"== {k} ({locOf items})"
        items
            |> Seq.sortByDescending snd
            |> Seq.iter (fun (f, n) -> print $"{n}\t{f}"))

print $"total:\t{locOf counts}"
