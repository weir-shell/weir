#!/usr/bin/env weir
// LOC per tracked file, grouped by extension (group totals descending,
// files descending within each group), with a repo total.

let counts =
    git ls-files
    | Seq.map (fun f -> (f, File.read f |> Seq.length))
    | Seq.toList

let ext f =
    let parts = Str.split "." f
    let n = parts |> Seq.length
    if n > 1 then
        let last = parts |> Seq.skip (n - 1) |> Seq.head
        $".{last}"
    else
        "(no extension)"

let group f =
    match ext f with
    | ".fs" when Str.startsWith "src/" f -> ".fs (src)"
    | ".fs" when Str.startsWith "tests/" f -> ".fs (tests)"
    | e -> e

let locOf items =
    items |> Seq.map (fun (_, n) -> n) |> Seq.sum

counts
    |> Seq.groupBy (fun (f, _) -> group f)
    |> Seq.sortByDescending (fun g -> locOf g.Items)
    |> Seq.iter (fun g ->
        print $"== {g.Key} ({locOf g.Items})"
        g.Items
            |> Seq.sortByDescending (fun (_, n) -> n)
            |> Seq.iter (fun (f, n) -> print $"{n}\t{f}"))

print $"total:\t{locOf counts}"
