#!/usr/bin/env weir
// The keyword table in docs/reference/lexical.md is a RENDERING of
// editors/grammar-manifest.json [D:grammar-currency] — the same gated
// artifact the editor grammars answer to — never a hand-list. The four
// KINDS are hand-classified here, completeness-checked both ways: a
// keyword the manifest gains that this file has not classified fails
// loudly, so the classification cannot silently lag the language.
//
//   tools/gen-lexical.weir           rewrite the marked region
//   tools/gen-lexical.weir --check   verify it is current (CI)

type Cli = {
    /// verify the generated region matches instead of writing
    check: bool
}

type Adapters = {
    [<Wire "from">]
    fromAdapters: seq<string>
    [<Wire "to">]
    toAdapters: seq<string>
}

type Manifest = {
    keywords: seq<string>
    withinKinds: seq<string>
    adapters: Adapters
}

let cli = Args.load Cli
let m = File.read "editors/grammar-manifest.json" |> from json Manifest

let core = ["do"; "elif"; "else"; "false"; "for"; "fun"; "function"; "if"; "import"; "in"; "let"; "match"; "module"; "of"; "then"; "true"; "type"; "when"; "with"]
let specific = ["always"; "from"; "poll"; "retry"; "to"; "until"; "within"]
let inert = ["mutable"; "rec"]
let teaching = ["def"; "return"; "try"; "while"]

let classified = [core; specific; inert; teaching] |> Seq.collect (fun xs -> xs) |> Seq.force
let ks = m.keywords |> Seq.force

for k in ks do
    if not (classified |> Seq.contains k) then
        fail $"keyword '{k}' is in the manifest but unclassified — add it to a kind in tools/gen-lexical.weir"

for c in classified do
    if not (ks |> Seq.contains c) then
        fail $"'{c}' is classified in tools/gen-lexical.weir but not in the manifest — remove it"

if Seq.length classified <> Seq.length ks then fail "a keyword is classified in two kinds"

let fmt xs = xs |> Seq.map (fun k -> $"`{k}`") |> Str.join ", "

let block = [
    $"{Seq.length ks} keywords, in four kinds:"
    ""
    "| kind | keywords |"
    "|---|---|"
    $"| core, F#-shaped | {fmt core} |"
    $"| weir-specific | {fmt specific} |"
    $"| reserved, no meaning | {fmt inert} |"
    $"| reserved to teach | {fmt teaching} |"
    ""
    $"`within` takes a kind word after it — {fmt m.withinKinds} — and the"
    $"adapters read `from` {fmt m.adapters.fromAdapters} and write `to` {fmt m.adapters.toAdapters};"
    "kind and adapter words are ordinary identifiers everywhere else."
]

let path = "docs/reference/lexical.md"
let beginMark = "<!-- keywords:begin — generated by tools/gen-lexical.weir; ci/e2e.sh gates the diff -->"
let endMark = "<!-- keywords:end -->"
let lines = File.read path |> Seq.force

if not (lines |> Seq.contains beginMark) then fail $"{path} has no keywords:begin marker"
if not (lines |> Seq.contains endMark) then fail $"{path} has no keywords:end marker"

let before = lines |> Seq.takeWhile (fun l -> l <> beginMark) |> Seq.force
let rest = lines |> Seq.skipWhile (fun l -> l <> endMark) |> Seq.skip 1 |> Seq.force
let out = [before; [beginMark]; block; [endMark]; rest] |> Seq.collect (fun xs -> xs) |> Seq.force

if cli.check then
    if (out |> Str.join "\n") <> (lines |> Str.join "\n") then
        fail "docs/reference/lexical.md keyword table is stale — regenerate: weir tools/gen-lexical.weir"
    print "lexical keyword table current (matches the grammar manifest)"
    exit 0

out |> File.write path
print $"{path}: keyword region rewritten ({Seq.length ks} keywords)"
