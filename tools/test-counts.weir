#!/usr/bin/env weir
// Agent live task: test-count deltas across the last 5 commits.
// (Rewritten same day: Seq.pairwise and let-RHS commands landed from
// this script's own friction log.)

type Tally = { Label: string; Count: int }

let log = git log -5 "--format=%h %s"

let counts =
    log
    |> Seq.map (fun line ->
        let hash = line |> Str.split " " |> Seq.head
        let count =
            cmd "git" ["show"; $"{hash}:tests/Weir.Tests/Tests.fs"]
            |> Seq.where (Str.contains "test \"")
            |> Seq.length
        { Label = line; Count = count })
    |> Seq.force

print "test counts, newest first:"
counts |> Seq.iter (fun c -> print $"  {c.Label}: {c.Count}")

print "deltas (newer minus older):"

counts
    |> Seq.pairwise
    |> Seq.iter (fun (newer, older) -> print $"  {newer.Label}: {newer.Count - older.Count}")
