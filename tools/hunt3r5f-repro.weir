// ---- H3R5-S2: wrappers and interpreters stop at their operand ----------------

let h3r5s2 d =
    Seq.concat [
        sFakeClean d "timeout" "timeout" "timeout (uutils coreutils) 0.2.2" s2TimeoutHelp ["timeout 30 curl --fail https://x"]
        sFakeClean d "watch" "watch" "watch from procps-ng 4.0.4" s2WatchHelp ["watch -n 1 docker ps --all"]
        sFakeClean d "bash" "bash" "GNU bash, version 5.3.9(1)-release" s2BashHelp ["bash deploy.sh --dry-run"]
        sFakeClean d "fd" "fd" "fd 10.2.0" s2FdHelp ["fd -e tmp -x rm -f"; "fd -t f -X sed -i s/a/b/"]
    ]
    |> failing

// ---- H3R5-S3 … S9: help shapes the generator misreads ------------------------

let h3r5s3 d = sFakeClean d "kill" "kill" "kill from procps-ng 4.0.4" s3KillHelp ["kill -TERM 1234"; "kill -s HUP 1234"; "kill --signal KILL 1234"] |> failing

let h3r5s4 d = sFakeClean d "perl" "perl" "This is perl 5, version 40" s4PerlHelp ["perl -MJSON::PP -e 1"; "perl -I lib t.pl"; "perl -F: -lane print f"] |> failing

let h3r5s5 d = sFakeClean d "unzip" "unzip" "" s5UnzipHelp ["unzip -q a.zip -d out"; "unzip -l a.zip"] |> failing

let h3r5s6 d = sFakeClean d "shfmt" "shfmt" "v3.14.1" s6ShfmtHelp ["shfmt --write --indent 2 x.sh"; "shfmt --diff --simplify x.sh"] |> failing

let h3r5s7 d = sFakeClean d "mkcert" "mkcert" "v1.4.4" s7MkcertHelp ["mkcert -install"] |> failing

let h3r5s8 d = sFakeClean d "npx" "npx" "11.6.2" s8NpxHelp ["npx --yes create-vite app"; "npx -y prettier --write ."; "npx --registry=https://r.example prettier x"] |> failing

let h3r5s9 d = sFakeClean d "node" "node" "v24.11.1" s9NodeHelp ["node --experimental-strip-types x.ts"; "node --deprecation x.js"; "node --warnings x.js"] |> failing

// the neighbours: each fake's listed flags check clean and a made-up flag
// still warns
let sKnown = [
    ("timeout", "timeout (uutils coreutils) 0.2.2", s2TimeoutHelp, "timeout -k 5 30 make")
    ("watch", "watch from procps-ng 4.0.4", s2WatchHelp, "watch -d ls")
    ("bash", "GNU bash, version 5.3.9(1)-release", s2BashHelp, "bash --norc -c true")
    ("fd", "fd 10.2.0", s2FdHelp, "fd -H -e md")
    ("kill", "kill from procps-ng 4.0.4", s3KillHelp, "kill -l")
    ("perl", "This is perl 5, version 40", s4PerlHelp, "perl -n -e 1")
    ("unzip", "", s5UnzipHelp, "unzip -p a.zip")
    ("shfmt", "v3.14.1", s6ShfmtHelp, "shfmt -l x.sh")
    ("mkcert", "v1.4.4", s7MkcertHelp, "mkcert -client x")
    ("node", "v24.11.1", s9NodeHelp, "node --no-warnings --no-deprecation x.js")
]

let ctlSKnownFlags d =
    sKnown
    |> Seq.forall (fun (tool, ver, help, line) ->
        let proj = sProj d tool
        sTool proj tool ver help
        let clean = sLinesClean proj tool [line] |> Seq.forall snd
        let bogus = sCheck proj tool 9 $"{tool} --h3r5-bogus x"
        clean && sFlagged bogus)

// ---- H3R5-S10: git builtins with their own subcommands ------------------------

let s10Git d =
    let hasGit = sh -c "command -v git" | succeeds
    if not hasGit then fail "SKIP: git not on PATH"
    let proj = sProj d "git"
    proj

let h3r5s10 d =
    let proj = s10Git d
    sLinesClean proj "git" ["git remote set-head origin --auto"; "git notes add --no-separator -m x"; "git remote rename --no-progress a b"] |> failing

let ctlSGit d =
    let proj = s10Git d
    let clean = sLinesClean proj "git" ["git commit --amend -m x"] |> Seq.forall snd
    clean && sFlagged (sCheck proj "git" 9 "git commit --h3r5-bogus")

// ---- H3R5-S1: an old all-bool signature checks bundles letter by letter ------

// the shape a pre-arity generator wrote: every flag bool, no arity markers
let s1OldSig exhaustive = Seq.concat [
    ["module Curl"; "let version = \"curl 8.18.0\""; "type Cmd = {"]
    ["    [<Short \"f\">]"; "    fail: bool"; "    [<Short \"o\">]"; "    output: bool"; "    [<Short \"s\">]"; "    silent: bool"; "}"]
    (if exhaustive then ["let exhaustive = true"] else [])
] |> Seq.freeze

let s1Proj d key exhaustive =
    let proj = sProj d key
    Dir.create $"{proj}/.weir/sigs"
    s1OldSig exhaustive |> File.write $"{proj}/.weir/sigs/curl.weir"
    sChmod (put proj "bin/curl" ["#!/bin/sh"; "exit 0"])
    proj

let h3r5s1 d =
    let ex = s1Proj d "ex" true
    let pa = s1Proj d "pa" false
    let a = sCheck ex "curl" 1 "curl -fsSL https://x -o out"
    let b = sCheck pa "curl" 2 "curl -Lv https://x"
    failing [
        ($"""an old exhaustive all-bool sig: 'curl -fsSL' is checked letter by letter (exit {codeOf a}: {sDiag a})""", codeOf a == 0 && not (sFlagged a))
        ($"""an old partial all-bool sig: 'curl -Lv' is checked letter by letter (exit {codeOf b}: {sDiag b})""", codeOf b == 0 && not (sFlagged b))
    ]

// the old sig's long flags and separate shorts check as before
let ctlSOldSig d =
    let ex = s1Proj d "ex" true
    let ok = sCheck ex "curl" 1 "curl -f -s https://x -o out"
    let bad = sCheck ex "curl" 2 "curl --bogus https://x"
    codeOf ok == 0 && not (sFlagged ok) && codeOf bad == 1 && sFlagged bad

// ---- H3R5-E2: a daemon holding the help's stdout hangs `weir add sig` ---------

// --help leaves `sleep <mark>` holding stdout: in weir's group, or setsid'd
let e2Tool mark detach = [
    "#!/bin/sh"
    "case \"$1\" in"
    "  --version) echo \"hng 1.0\";;"
    $"""  --help) printf 'Usage: hng [opts]\n\nOptions:\n  --aa   aa\n'; {if detach then "setsid " else ""}sleep {mark} & exit 0;;"""
    "  *) exit 1;;"
    "esac"
]

let e2Run d k detach =
    let proj = sProj d $"hng{k}"
    let mark = markOf 60 (70 + k)
    sChmod (put proj "bin/hng" (e2Tool mark detach))
    let (ms, r) = msOf (fun () -> runEnv proj "40" [sPathOf proj] ["add"; "sig"; "hng"])
    let left = sleepersOf mark |> Seq.length
    reap mark
    (ms, r, left)

let h3r5e2 d =
    let runs = [(0, false); (1, true)] |> Seq.pmapWith 2 (fun (k, detach) -> (detach, e2Run d k detach)) |> Seq.freeze
    runs
    |> Seq.collect (fun (detach, (ms, r, left)) ->
        let how = if detach then "a setsid daemon" else "a background child in the tool's group"
        let shown = $"exit {codeOf r} after {ms}ms, {left} left: {diagOf r |> oneLine}"
        let bounded = ($"--help leaves {how} holding stdout: weir add sig must finish within 30s ({shown})", codeOf r <> 124 && ms <= 30000)
        let killed = ($"--help leaves {how}: the probe's process group must be killed ({shown})", left == 0)
        let cases = if detach then [bounded] else [bounded; killed]
        cases)
    |> failing

// a tool whose help exits cleanly generates at once
let ctlSAddQuick d =
    let proj = sProj d "quick"
    sTool proj "quick" "quick 1.0" ["Usage: quick [opts]"; ""; "Options:"; "  --aa   aa"]
    let (ms, r) = msOf (fun () -> sAdd proj "quick")
    codeOf r == 0 && ms <= 10000 && File.exists $"{proj}/.weir/sigs/quick.weir"

// ---- H3R5-E9: sig probes run with cwd = $TMPDIR itself -----------------------

// every invocation logs its cwd, $TMPDIR and how many entries the cwd held
let e9Tool log = [
    "#!/bin/sh"
    $"echo \"cwd=$(pwd -P) tmp=$(cd \"$TMPDIR\" && pwd -P) n=$(ls -A | wc -l)\" >> '{log}'"
    "case \"$1\" in"
    "  --version) echo \"cwdp 1.0\";;"
    "  --help) printf 'Usage: cwdp [opts]\\n\\nOptions:\\n  --aa   aa\\n';;"
    "  *) exit 1;;"
    "esac"
]

let h3r5e9 d =
    let proj = sProj d "cwdp"
    let log = $"{d}/cwd.log"
    sChmod (put proj "bin/cwdp" (e9Tool log))
    let r = sAdd proj "cwdp"
    let ls = linesOf log
    let seen =
        ls
        |> Seq.map (fun l ->
            match l with
            | Regex @"^cwd=(.*) tmp=(.*) n=\s*(\d+)$" (c, t, n) -> (c <> t && n == "0", $"cwd is $TMPDIR: {c == t}, {n} entries")
            | _ -> (false, "unparsed"))
        |> Seq.freeze
    let shown = seen |> Seq.map snd |> joined
    failing [
        ($"""weir add sig: every probe runs in a fresh temp dir, never $TMPDIR itself (exit {codeOf r}, per probe '{shown}')""", codeOf r == 0 && not (Seq.isEmpty seen) && (seen |> Seq.forall fst))
    ]

// ---- H3R5-E10: sig file names collide ----------------------------------------

type SLockArt = { kind: string; name: string; path: string }

type SLock = { artifacts: seq<SLockArt> }

let e10Pairs = [("a b", "a_b"); ("..evil", "evil")]

let e10Help k = ["Usage: x [opts]"; ""; "Options:"; $"  --only{k}   flag {k}"]

let h3r5e10 d =
    let proj = sProj d "names"
    let names = e10Pairs |> Seq.collect (fun (a, b) -> [a; b]) |> Seq.freeze
    names |> Seq.indexed |> Seq.iter (fun (k, n) -> sTool proj n "" (e10Help k))
    let adds = names |> Seq.map (fun n -> (n, sAdd proj n)) |> Seq.freeze
    let lock = linesOf $"{proj}/.weir/lock.json"
    let arts = if Seq.isEmpty lock then [] else (lock |> from json SLock).artifacts |> Seq.where (fun a -> a.kind == "sig") |> Seq.freeze
    let pathOf n = arts |> Seq.tryFind (fun a -> a.name == n) |> Option.map (fun a -> a.path)
    let holds n k =
        match pathOf n with
        | Some p -> linesOf $"{proj}/.weir/{p}" |> Seq.exists (Str.contains $"only{k}")
        | None -> false
    let addCases = adds |> Seq.map (fun (n, r) -> ($"weir add sig '{n}' (exit {codeOf r}: {diagOf r |> oneLine})", codeOf r == 0)) |> Seq.freeze
    let pairCases =
        e10Pairs
        |> Seq.indexed
        |> Seq.map (fun (i, (a, b)) ->
            let shown = $"{pathOf a} vs {pathOf b}"
            ($"'{a}' and '{b}' must keep two sig files, each its own tool's ({shown})", pathOf a <> None && pathOf a <> pathOf b && holds a (2 * i) && holds b (2 * i + 1)))
        |> Seq.freeze
    Seq.append addCases pairCases |> failing

// ---- H3R5-E11: a flood of help output is held whole --------------------------

let e11Lines = 200000

let e11Tool = [
    "#!/bin/sh"
    "case \"$1\" in"
    "  --version) echo \"fl 1.0\";;"
    $"  --help) printf 'Usage: fl [opts]\\n\\nOptions:\\n'; seq 1 {e11Lines} | sed 's/.*/  --f&   {Str.replicate 190 "x"}/';;"
    "  *) exit 1;;"
    "esac"
]

let e11RssLimit = 300

let h3r5e11 d =
    let proj = sProj d "fl"
    sChmod (put proj "bin/fl" e11Tool)
    let py = put d "rss-s.py" rssPy
    let line =
        within cd proj
            env $@noProxy $"TMPDIR={proj}" (sPathOf proj) python3 -I $py 120 -- $cli.bin add sig fl | line
    match line with
    | Regex @"ms=(\d+) rss=(\d+) rc=(\S+)" (ms, rss, rc) ->
        failing [
            ($"weir add sig of a tool printing ~{e11Lines * 200 / 1000000} MB of help: peak RSS {rss} MiB (limit {e11RssLimit}; rc {rc}, {ms}ms)", rc <> "HANG" && Str.toInt rss <= e11RssLimit)
        ]
    | _ -> fail $"the RSS meter said '{line}'"

// ---- this part's lists -----------------------------------------------------------

let controlsS = [
    ("control-sig-known-flags (H3R5-S2 H3R5-S3 H3R5-S4 H3R5-S5 H3R5-S6 H3R5-S7 H3R5-S9)", ctlSKnownFlags)
    ("control-sig-git (H3R5-S10)", ctlSGit)
    ("control-sig-old (H3R5-S1)", ctlSOldSig)
    ("control-sig-add-quick (H3R5-E2 H3R5-E9 H3R5-E10 H3R5-E11)", ctlSAddQuick)
]

let probesS = [
    ("H3R5-E2", h3r5e2); ("H3R5-E9", h3r5e9); ("H3R5-E10", h3r5e10); ("H3R5-E11", h3r5e11)
    ("H3R5-S1", h3r5s1); ("H3R5-S2", h3r5s2); ("H3R5-S3", h3r5s3); ("H3R5-S4", h3r5s4); ("H3R5-S5", h3r5s5)
    ("H3R5-S6", h3r5s6); ("H3R5-S7", h3r5s7); ("H3R5-S8", h3r5s8); ("H3R5-S9", h3r5s9); ("H3R5-S10", h3r5s10)
]

// ---- H3R5-B1: a YAML leading-zero int reads as decimal (R3) --------------------

// a Pod's defaultMode 0644: a patch that never touches it, and a typed read
let b1Doc = ["apiVersion: v1"; "kind: Pod"; "spec:"; "  volumes:"; "    - name: cfg"; "      configMap:"; "        name: cfg"; "        defaultMode: 0644"]

let b1Patch = [
    "let p = yaml patch"
    "    kind: Pod"
    "File.read \"pod.yaml\" |> Yaml.parse |> Yaml.merge p |> to yaml |> Seq.iter print"
]

let b1Typed = ["let v = File.read \"pod.yaml\" |> from yaml {| spec: {| volumes: seq<{| configMap: {| defaultMode: int |} |}> |} |} |> try result"; "print $\"{v}\""]

// the neighbours: a decimal int, a zero, and a quoted "0644" keep their reads
let ctlFYamlInts d =
    ["a: 644"; "z: 0"; "q: \"0644\""] |> File.write $"{d}/n.yaml"
    let (r, ls) = fRun d "c.weir" ["let v = File.read \"n.yaml\" |> from yaml {| a: int; z: int; q: string |}"; "print $\"{v.a} {v.z} {v.q}\""; "File.read \"n.yaml\" |> Yaml.parse |> to yaml |> Seq.iter print"]
    codeOf r == 0 && Seq.equal ls ["644 0 0644"; "a: 644"; "z: 0"; "q: \"0644\""]

let h3r5b1 d =
    b1Doc |> File.write $"{d}/pod.yaml"
    let (r, ls) = fRun d "b1.weir" b1Patch
    let (rt, lt) = fRun d "b1t.weir" b1Typed
    failing [
        ($"""a patch round trip that never touches defaultMode rewrites 0644 (exit {codeOf r}, '{ls |> Seq.where (Str.contains "defaultMode") |> joined}')""", codeOf r == 0 && (ls |> Seq.exists (fun l -> Str.trim l == "defaultMode: 0644")))
        ($"""a typed int read of the leading-zero literal 0644 is accepted ('{joined lt}', exit {codeOf rt})""", codeOf rt == 0 && (lt |> Seq.exists (Str.startsWith "Error")))
    ]

// ---- H3R5-B2: to yaml writes exponent floats without a dot ----------------------

// a YAML 1.1 float needs a dot (and a signed exponent)
let b2Float1_1 v = Str.isMatch @"^[-+]?([0-9][0-9_]*)?\.[0-9.]*([eE][-+][0-9]+)?$" v

let b2Script = [
    "type R = { a: float; b: float; c: float }"
    "{ a = 0.00001; b = 1e21; c = 1.5e300 } |> to yaml |> Seq.iter print"
    "{| v = YFloat 1e-7 |} |> to yaml |> Seq.iter print"
    "let back = { a = 0.00001; b = 1e21; c = 1.5e300 } |> to yaml |> from yaml R"
    "print $\"BACK {Float.near back.a 0.00001 1e-12} {Float.near back.b 1e21 1e9} {Float.near back.c 1.5e300 1e288}\""
]

let b2Value ls k = ls |> Seq.tryPick (fun l -> if l |> Str.startsWith $"{k}: " then Some (Str.sub (Str.length k + 2) (Str.length l - Str.length k - 2) l) else None) |> Option.defaultValue ""

// plain floats keep their spelling
let ctlFYamlFloatPlain d =
    let (r, ls) = fRun d "c.weir" ["{| p = 123.0; q = 1.5 |} |> to yaml |> Seq.iter print"]
    codeOf r == 0 && Seq.equal ls ["p: 123.0"; "q: 1.5"]

let h3r5b2 d =
    let (r, ls) = fRun d "b2.weir" b2Script
    let cases =
        ["a"; "b"; "c"; "v"]
        |> Seq.map (fun k ->
            let v = b2Value ls k
            ($"to yaml writes the float {k} as '{v}', a string to YAML 1.1 readers (no dot)", codeOf r == 0 && b2Float1_1 v))
        |> Seq.freeze
    Seq.append cases [($"""the exponent floats read back ('{joined ls}')""", ls |> Seq.contains "BACK true true true")] |> failing

// ---- H3R5-B3: non-decimal YAML numbers become quoted strings ---------------------

let b3Core = [("mask", "0x1F"); ("num", "0o17"); ("max", ".inf")]

let b3Script = ["File.read \"n.yaml\" |> Yaml.parse |> to yaml |> Seq.iter print"]

// YAML-1.1-only forms stay strings (YAML 1.2 core reads them as text)
let ctlFYaml11Strings d =
    ["big: 1_000"; "bits: 0b101"; "time: 1:20"] |> File.write $"{d}/n.yaml"
    let (r, ls) = fRun d "c.weir" ["let v = File.read \"n.yaml\" |> from yaml {| big: string; bits: string; time: string |}"; "print $\"{v.big} {v.bits} {v.time}\""]
    codeOf r == 0 && Seq.equal ls ["1_000 0b101 1:20"]

let h3r5b3 d =
    b3Core |> Seq.map (fun (k, v) -> $"{k}: {v}") |> File.write $"{d}/n.yaml"
    let (r, ls) = fRun d "b3.weir" b3Script
    b3Core
    |> Seq.map (fun (k, v) -> ($"""Yaml.parse |> to yaml changes the YAML 1.2 number {k}: {v} (exit {codeOf r}, '{joined ls}')""", codeOf r == 0 && (ls |> Seq.contains $"{k}: {v}")))
    |> failing

// ---- H3R5-B4: tabs mishandled silently ------------------------------------------

let b4Tab = "\t"

// space indentation reads nested; a tab inside a value is content
let ctlFYamlSpaces d =
    ["name: web"; "spec:"; "  replicas: 3"; $"tag: x{b4Tab}y"; "c: web # note"] |> File.write $"{d}/s.yaml"
    let (r, ls) = fRun d "c.weir" ["let v = File.read \"s.yaml\" |> from yaml {| name: string; spec: {| replicas: int |}; tag: string; c: string |}"; "print $\"{v.spec.replicas} {Str.length v.tag} {v.c}\""]
    codeOf r == 0 && Seq.equal ls ["3 3 web"]

let h3r5b4 d =
    ["name: web"; "spec:"; $"{b4Tab}replicas: 3"; $"{b4Tab}image: nginx"] |> File.write $"{d}/tab.yaml"
    [$"name: web{b4Tab}# the app"; $"port: 8080{b4Tab}# http"] |> File.write $"{d}/tc.yaml"
    let typed = fRun d "b4a.weir" ["let a = File.read \"tab.yaml\" |> from yaml {| name: string; spec: Option<{| replicas: int; image: string |}> |} |> try result"; "print $\"{a}\""]
    let parsed = fRun d "b4b.weir" ["let a = File.read \"tab.yaml\" |> Yaml.parse |> try result"; "print $\"{a |> Result.isOk}\""]
    let comment = fRun d "b4c.weir" ["let a = File.read \"tc.yaml\" |> from yaml {| name: string; port: int |} |> try result"; "print $\"{a}\""]
    let (rt, lt) = typed
    let (rp, lp) = parsed
    let (rc, lc) = comment
    failing [
        ($"""a tab-indented nested mapping reads instead of refusing ('{joined lt}', exit {codeOf rt})""", codeOf rt == 0 && (lt |> Seq.exists (Str.startsWith "Error")))
        ($"""Yaml.parse of a tab-indented nested mapping succeeds instead of refusing ('{joined lp}', exit {codeOf rp})""", codeOf rp == 0 && Seq.equal lp ["false"])
        ($"""'name: web<TAB># c' keeps the comment in the value ('{joined lc}', exit {codeOf rc})""", codeOf rc == 0 && Seq.equal lc ["Ok ({ name = \"web\"; port = 8080 })"])
    ]

// ---- H3R5-B5: gen types: required + nullable drafts a plain Option ---------------

let b5Schema = """{"type": "object", "properties": {"name": {"type": "string"}, "parent": {"type": ["string", "null"]}, "note": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "legacy": {"type": "string", "nullable": true}}, "required": ["name", "parent", "note", "legacy"]}"""

// an OPTIONAL nullable property drafts Option; an absent key stays absent
let ctlFGenOptional d =
    fGen d [("nb", """{"type": "object", "properties": {"name": {"type": "string"}, "p": {"type": ["string", "null"]}}, "required": ["name"]}""")] (fun res ->
        let (add, gen) = res |> Seq.head |> snd
        let t = fText d "nb"
        let r = fRead d "nb" """{"name": "a"}"""
        codeOf add == 0 && codeOf gen == 0 && fHasField t "p" "Option<string>" && codeOf r == 0 && outOf r == "{\"name\":\"a\"}")

let h3r5b5 d =
    fGen d [("rn", b5Schema)] (fun res ->
        let (add, gen) = res |> Seq.head |> snd
        let t = fText d "rn"
        let r = fRead d "rn" """{"name": "a", "parent": null, "note": null, "legacy": null}"""
        let o = outOf r
        let fieldCase f =
            let kept = codeOf r == 0 && (o |> Str.contains $"\"{f}\":null")
            let noted = not (Seq.isEmpty (fNotes t f))
            ($"required + nullable '{f}': a null neither writes back nor is noted (out '{o}', exit {codeOf r})", kept || noted)
        Seq.append [fAddGen (add, gen)] (["parent"; "note"; "legacy"] |> Seq.map fieldCase) |> failing)

// ---- H3R5-B6: an int beyond int64 hints float; uint64 drafts int ----------------

let b6Schema = """{"type": "object", "properties": {"n": {"type": "integer", "format": "uint64"}, "k": {"type": "integer"}}, "required": ["n", "k"]}"""

let h3r5b6 d =
    let (r, _) = fRun d "b6.weir" ["let a = [\"{\\\"id\\\": 18446744073709551615}\"] |> from json {| id: int |}"; "print $\"{a.id}\""]
    let hint = diagOf r
    fGen d [("u6", b6Schema)] (fun res ->
        let (add, gen) = res |> Seq.head |> snd
        let t = fText d "u6"
        let back = fRead d "u6" """{"n": 18446744073709551615, "k": 1}"""
        let cases = [
            ($"""an int beyond int64 into an int field: the hint must point at Yaml, not float (exit {codeOf r}: {hint |> oneLine})""", codeOf r <> 0 && (hint |> Str.contains "Yaml") && not (hint |> Str.contains "declare it float"))
            fAddGen (add, gen)
            ($"""format uint64 drafts a plain int ('{t |> Seq.where (Str.contains " n:") |> joined}')""", not (fHasField t "n" "int"))
            ($"""18446744073709551615 through the drafted uint64 field loses its digits (exit {codeOf back}: {diagOf back |> oneLine})""", codeOf back == 0 && (outOf back |> Str.contains "\"n\":18446744073709551615"))
        ]
        failing cases)

// ---- H3R5-B7: whitespace-only XML text reads as "" ------------------------------

let b7Xml = ["<Project>"; "  <PropertyGroup>"; "    <Sep>&#32;</Sep>"; "    <Tab>&#9;</Tab>"; "    <Two>  </Two>"; "    <Word> a </Word>"; "    <Empty></Empty>"; "  </PropertyGroup>"; "</Project>"]

let b7Script reader = [
    "type PG = { Sep: string; Tab: string; Two: string; Word: string; Empty: string }"
    "type Proj = { PropertyGroup: PG }"
    $"let p = {reader} \"ws.xml\" |> from xml Proj"
    "print $\"[{p.PropertyGroup.Sep}] [{p.PropertyGroup.Tab}] [{p.PropertyGroup.Two}] [{p.PropertyGroup.Word}] [{p.PropertyGroup.Empty}]\""
]

// text with a word keeps its spaces, an empty element is ""
let ctlFXmlText d =
    b7Xml |> File.write $"{d}/ws.xml"
    let (r, ls) = fRun d "c.weir" (b7Script "File.read")
    codeOf r == 0 && (ls |> Seq.exists (fun l -> (l |> Str.contains "[ a ] []")))

let h3r5b7 d =
    b7Xml |> File.write $"{d}/ws.xml"
    ["File.readBytes"; "File.read"]
    |> Seq.indexed
    |> Seq.map (fun (i, reader) ->
        let (r, ls) = fRun d $"b7-{i}.weir" (b7Script reader)
        ($"""from xml ({reader}) drops whitespace-only text — want [ ] [<TAB>] [  ] as xml.etree reads (got '{joined ls |> Str.replace "\t" "<TAB>"}', exit {codeOf r})""", codeOf r == 0 && Seq.equal ls ["[ ] [\t] [  ] [ a ] []"]))
    |> failing

// ---- H3R5-E13 / H3R5-F3: XML encoding labels (R4) --------------------------------

// a document whose Title is "caf" + the hex bytes `mid`, under the label
let xEnc d name label mid =
    let p = $"{d}/{name}.xml"
    File.writeBytes p (Bytes.fromHex (hx $"<?xml version=\"1.0\" encoding=\"{label}\"?><Root><Title>caf" + mid + hx "</Title></Root>"))
    p

let xEncScript reader = ["type Root = { Title: string }"; $"print $\"{{{reader} (Self.args |> Seq.head) |> from xml Root |> try result}}\""]

let xEncRead d reader path =
    let r = runIn d "30" [put d $"x-{reader}.weir" (xEncScript reader); path]
    outOf r

// UTF-8 labelled UTF-8 reads; a real non-ASCII byte under Windows-1252 still
// refuses (no code pages)
let ctlFXmlLabels d =
    let ok = xEncRead d "File.readBytes" (xEnc d "u" "UTF-8" "c3a9")
    let cp = xEncRead d "File.readBytes" (xEnc d "w" "Windows-1252" "e9")
    ok == "Ok ({ Title = \"café\" })" && (cp |> Str.startsWith "Error")

let h3r5e13 d =
    [" windows-1252"; "x id"; "ebcdic;"]
    |> Seq.indexed
    |> Seq.map (fun (i, label) ->
        let got = xEncRead d "File.readBytes" (xEnc d $"m{i}" label "c3a9")
        ($"a malformed encoding label '{label}' over non-ASCII bytes is decoded as UTF-8 instead of refused ('{got}')", got |> Str.startsWith "Error"))
    |> failing

let h3r5f3 d =
    let cases = [
        ("pure ASCII labelled Windows-1252, bytes", "File.readBytes", "Windows-1252", "65", "cafe")
        ("pure ASCII labelled Windows-1252, text", "File.read", "Windows-1252", "65", "cafe")
        ("UTF-8 labelled UTF8", "File.readBytes", "UTF8", "c3a9", "café")
        ("UTF-8 labelled utf8, text", "File.read", "utf8", "c3a9", "café")
        ("Latin-1 labelled Latin-1", "File.readBytes", "Latin-1", "e9", "café")
    ]
    cases
    |> Seq.indexed
    |> Seq.map (fun (i, (label, reader, enc, mid, want)) ->
        let got = xEncRead d reader (xEnc d $"f{i}" enc mid)
        ($"from xml refuses {label} ('{got}')", got == $"Ok ({{ Title = \"{want}\" }})"))
    |> failing

// ---- H3R5-F4: try / try result drop a Yaml node's bigint digits ------------------

let f4Script = [
    "let doc = [\"{\\\"id\\\": 18446744073709551616}\"]"
    "print $\"LET {doc |> from json {| id: Yaml |} |> to json |> Str.join \"\"}\""
    "match doc |> from json {| id: Yaml |} |> try result with"
    "| Ok w -> print $\"RESULT {w |> to json |> Str.join \"\"}\""
    "| Error m -> print $\"RESULT error {m}\""
    "match doc |> from json {| id: Yaml |} |> try with"
    "| Some w -> print $\"TRY {w |> to json |> Str.join \"\"}\""
    "| None -> print \"TRY none\""
]

let ctlFBigintLet d =
    let (r, ls) = fRun d "c.weir" f4Script
    codeOf r == 0 && (ls |> Seq.contains "LET {\"id\":18446744073709551616}")

let h3r5f4 d =
    let (r, ls) = fRun d "f4.weir" f4Script
    failing [
        ($"""`|> try result` drops the digits of 18446744073709551616 ('{joined ls}', exit {codeOf r})""", ls |> Seq.contains "RESULT {\"id\":18446744073709551616}")
        ($"""`|> try` drops the digits of 18446744073709551616 ('{joined ls}', exit {codeOf r})""", ls |> Seq.contains "TRY {\"id\":18446744073709551616}")
    ]

// ---- H3R5-F5: gen types' enum note lists null the enum does not hold -------------

// kind: [string, null] + enum ["Pod"] (every yannh k8s apiVersion/kind);
// lvl: string (no null) + enum ["a", "b"]
let f5Schema = """{"type": "object", "additionalProperties": false, "properties": {"kind": {"type": ["string", "null"], "enum": ["Pod"]}, "lvl": {"type": "string", "enum": ["a", "b"]}, "hn": {"type": "string", "enum": ["x", null]}}}"""

// a note that lists null among the enum's values (`'Pod', null`)
let f5NullListed l = Str.isMatch @"',\s*null\b|\bnull\s*,\s*'" l

let h3r5f5 d =
    fGen d [("en", f5Schema)] (fun res ->
        let (add, gen) = res |> Seq.head |> snd
        let t = fText d "en"
        let noteOf f = fNotes t f |> Seq.freeze
        Seq.append [fAddGen (add, gen)] (
            [("kind", "the enum lacks null"); ("lvl", "the enum lacks null"); ("hn", "the type forbids null")]
            |> Seq.map (fun (f, why) ->
                let ns = noteOf f
                ($"""the enum note for {f} lists null though {why} ('{joined ns}')""", not (ns |> Seq.exists f5NullListed))))
        |> failing)

// ---- H3R5-F8: a block-scalar line starting with % reads as a directive -----------

let f8Script = [
    "type D = { fmt: string }"
    "type C = { data: D }"
    "let c = File.read \"cm.yaml\" |> from yaml C |> try result"
    "print $\"READ {c}\""
    "type T = { s: string }"
    "let y = { s = \"a\\n%b\" } |> to yaml"
    "print $\"BACK {y |> from yaml T |> try result}\""
]

// a block scalar without a %-line reads as before
let ctlFYamlBlock d =
    ["data:"; "  fmt: |"; "    LogFormat"; "    plain"] |> File.write $"{d}/cm.yaml"
    let (r, ls) = fRun d "c.weir" ["let c = File.read \"cm.yaml\" |> from yaml {| data: {| fmt: string |} |}"; "print (c.data.fmt |> Str.replace \"\\n\" \"|\")"]
    codeOf r == 0 && Seq.equal ls ["LogFormat|plain|"]

let h3r5f8 d =
    ["data:"; "  fmt: |"; "    LogFormat"; "    %h %l %u %t"] |> File.write $"{d}/cm.yaml"
    let (r, ls) = fRun d "f8.weir" f8Script
    failing [
        ($"""a block scalar line '%h %l %u %t' is read as a directive ('{joined ls}', exit {codeOf r})""", ls |> Seq.contains "READ Ok ({ data = { fmt = \"LogFormat\\n%h %l %u %t\\n\" } })")
        ($"""weir cannot read back its own to yaml of "a\n%b" ('{joined ls}')""", ls |> Seq.contains "BACK Ok ({ s = \"a\\n%b\" })")
    ]

// ---- H3R5-F9: to yaml writes U+2028 raw inside a block scalar --------------------

let f9Ls = Str.fromUtf8 (Bytes.fromHex "e280a8")

// the string each case writes, as a weir expression over `ls` (U+2028)
let f9Values = [("a", "\"x\\ny\" + ls"); ("b", "ls + \"-\\tz\\n\""); ("c", "\"\\n\" + ls")]

let f9Script v = [
    "type T = { s: string }"
    "let ls = Str.fromUtf8 (Bytes.fromHex \"e280a8\")"
    $"let v = {{ s = {v} }}"
    "let y = v |> to yaml |> Seq.freeze"
    "y |> File.write \"out.yaml\""
    "print $\"SAME {y |> from yaml T |> try result |> Result.map (fun b -> b == v) |> Result.defaultValue false}\""
]

// a multi-line string without U+2028 still goes out as a block scalar
let ctlFYamlBlockOut d =
    let (r, ls) = fRun d "c.weir" ["{| s = \"x\\ny\" |} |> to yaml |> Seq.iter print"]
    codeOf r == 0 && Seq.equal ls ["s: |-"; "  x"; "  y"]

let h3r5f9 d =
    f9Values
    |> Seq.map (fun (k, v) ->
        let sd = $"{d}/{k}"
        Dir.create sd
        let (r, ls) = fRun sd "f9.weir" (f9Script v)
        let out = linesOf $"{sd}/out.yaml"
        let raw = out |> Seq.exists (Str.contains f9Ls)
        ($"""to yaml of case {k} writes U+2028 raw (raw: {raw}) or weir cannot read it back equal ('{joined ls}', exit {codeOf r})""", codeOf r == 0 && not raw && (ls |> Seq.contains "SAME true")))
    |> failing

// ---- H3R5-F10: from yaml trims Unicode whitespace from plain scalars -------------

let f10Nbsp = Str.fromUtf8 (Bytes.fromHex "c2a0")

let f10Ideo = Str.fromUtf8 (Bytes.fromHex "e38080")

// spaces and tabs around a plain scalar still trim
let ctlFYamlTrim d =
    ["s:   x  "; "t: y\t"] |> File.write $"{d}/w.yaml"
    let (r, ls) = fRun d "c.weir" ["let v = File.read \"w.yaml\" |> from yaml {| s: string; t: string |}"; "print $\"[{v.s}] [{v.t}]\""]
    codeOf r == 0 && Seq.equal ls ["[x] [y]"]

let h3r5f10 d =
    [$"s: x{f10Nbsp}"; $"t: {f10Ideo}y"; $"{f10Ideo}k: v"] |> File.write $"{d}/u.yaml"
    let (r, ls) = fRun d "f10.weir" ["let v = File.read \"u.yaml\" |> from yaml {| s: string; t: string |}"; "print $\"S {v.s |> Str.length} T {v.t |> Str.length}\""; "File.read \"u.yaml\" |> Yaml.parse |> to json |> Seq.iter print"]
    let keyKept = ls |> Seq.exists (fun l -> l |> Str.contains $"\"{f10Ideo}k\"")
    failing [
        ($"""from yaml trims NBSP / U+3000 from plain scalars ('{joined ls}', exit {codeOf r})""", ls |> Seq.contains "S 2 T 2")
        ($"""from yaml trims U+3000 from a plain key ('{joined ls}')""", keyKept)
    ]

// ---- formats: the lists ------------------------------------------------------

let controlsF = [
    ("control-yaml-ints (H3R5-B1)", ctlFYamlInts)
    ("control-yaml-float-plain (H3R5-B2)", ctlFYamlFloatPlain)
    ("control-yaml11-strings (H3R5-B3 H3R5-B1)", ctlFYaml11Strings)
    ("control-yaml-spaces (H3R5-B4 H3R5-F10)", ctlFYamlSpaces)
    ("control-gen-optional (H3R5-B5 H3R5-B6 H3R5-F5)", ctlFGenOptional)
    ("control-xml-text (H3R5-B7)", ctlFXmlText)
    ("control-xml-labels (H3R5-E13 H3R5-F3)", ctlFXmlLabels)
    ("control-bigint-let (H3R5-F4)", ctlFBigintLet)
    ("control-yaml-block (H3R5-F8)", ctlFYamlBlock)
    ("control-yaml-block-out (H3R5-F9)", ctlFYamlBlockOut)
    ("control-yaml-trim (H3R5-F10)", ctlFYamlTrim)
]

let probesF = [
    ("H3R5-B1", h3r5b1); ("H3R5-B2", h3r5b2); ("H3R5-B3", h3r5b3); ("H3R5-B4", h3r5b4); ("H3R5-B5", h3r5b5); ("H3R5-B6", h3r5b6); ("H3R5-B7", h3r5b7)
    ("H3R5-E13", h3r5e13); ("H3R5-F3", h3r5f3); ("H3R5-F4", h3r5f4); ("H3R5-F5", h3r5f5); ("H3R5-F8", h3r5f8); ("H3R5-F9", h3r5f9); ("H3R5-F10", h3r5f10)
]

// ---- the lists ---------------------------------------------------------------

let controls = Seq.concat [controlsC; controlsD; controlsE; controlsS; controlsF] |> Seq.freeze

let probes = Seq.concat [probesC; probesD; probesE; probesS; probesF] |> Seq.freeze

// a label word starting with the --only text; an id ending in a digit never
// selects a longer number (H3R5-B1 is not H3R5-B10)
let picks o w =
    let rest = if Str.length w > Str.length o then Str.sub (Str.length o) (Str.length w - Str.length o) w else ""
    (w |> Str.startsWith o) && not ((Str.isMatch @"[0-9]$" o) && (Str.isMatch @"^[0-9]" rest))

let selected (label, _) =
    match cli.only with
    | Some o -> label |> Str.rsplit @"[ ()]+" |> Seq.exists (picks o)
    | None -> true

// ---- the verdict channel ------------------------------------------------------

let record vpath line =
    print $"  {line}"
    File.append vpath [line]

// every probe and control gets its own temp dir
let runProbe vpath (label, probe) =
    within tmp w
        let (ms, res) = msOf (fun () -> probe w |> try result)
        let took = $"[{ms}ms]"
        match res with
        | Ok fs when fs |> Seq.isEmpty -> record vpath $"{label} OK {took}"
        | Ok fs -> record vpath $"""{label} REPRODUCES ({fs |> Str.join "; "}) {took}"""
        | Error m when m |> Str.contains "SKIP: " -> record vpath $"{label} SKIP ({m})"
        | Error m -> record vpath $"{label} REPRODUCES (the probe failed to run: {m}) {took}"

let runControl vpath (label, ctl) =
    within tmp w
        let (ms, res) = msOf (fun () -> ctl w |> try result)
        let took = $"[{ms}ms]"
        match res with
        | Ok true -> record vpath $"{label} OK {took}"
        | Ok false -> record vpath $"*** CONTROL FAILED: {label} {took}"
        | Error m when m |> Str.contains "SKIP: " -> record vpath $"{label} SKIP ({m})"
        | Error m -> record vpath $"*** CONTROL FAILED: {label} (the control failed to run: {m})"

// ---- the gate ----------------------------------------------------------------

print "third bug hunt, round 5 fixes — repro gate (dev/plans/PLAN-hunt3r5-fixes.md)"
print $"  binary: {cli.bin}"

within tmp d
    let vpath = $"{d}/verdicts"
    [] |> File.write vpath

    if not toolsReady then
        record vpath "instruments SKIP (timeout/env/python3/ps/kill/setsid/bash/ln/mkfifo//proc missing) — every item stays OPEN"

    if toolsReady then
        print ""
        print "controls"
        controls |> Seq.where selected |> Seq.iter (runControl vpath)
        print ""
        print "probes"
        probes |> Seq.where selected |> Seq.iter (runProbe vpath)

    print ""
    let verdicts = File.read vpath |> Seq.freeze
    let open =
        verdicts
        |> Seq.where (fun l ->
            (l |> Str.contains "REPRODUCES") || (l |> Str.contains "CONTROL FAILED") || (l |> Str.contains "SKIP"))
        |> Seq.freeze

    let repro = verdicts |> Seq.where (fun l -> l |> Str.contains "REPRODUCES") |> Seq.length
    let skipped = verdicts |> Seq.where (fun l -> (l |> Str.startsWith "H3R5-") && (l |> Str.contains " SKIP")) |> Seq.length
    let ok = verdicts |> Seq.where (fun l -> (l |> Str.startsWith "H3R5-") && (l |> Str.contains " OK")) |> Seq.length
    print $"summary: {ok} probe(s) OK, {repro} REPRODUCE, {skipped} SKIP"

    if open |> Seq.isEmpty then
        print (if cli.only == None then "ALL ITEMS FIXED" else "ALL SELECTED ITEMS FIXED (--only)")
    else
        let n = open |> Seq.length
        print $"{n} line(s) keep the gate shut (a SKIP or a failed control counts):"
        open |> Seq.iter (fun l -> print $"  {l}")
        exit (if n > 255 then 255 else n)
