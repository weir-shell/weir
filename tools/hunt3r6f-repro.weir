// (tool, version, help, the --help exit code)
let sFakes = [
    ("sudo", "Sudo version 1.9.16", sSudoHelp, "")
    ("systemd-run", "systemd 258 (258.1)", sSystemdRunHelp, "")
    ("run0", "systemd 258 (258.1)", sRun0Help, "")
    ("chrt", "chrt from util-linux 2.41", sChrtHelp, "")
    ("strace", "strace -- version 6.16", sStraceHelp, "")
    ("uvx", "uvx 0.9.5", sUvxHelp, "")
    ("bunx", "1.3.0", sBunxHelp, "1")
    ("kill", "kill from procps-ng 4.0.4", sKillHelp, "")
    ("pkill", "pkill from procps-ng 4.0.4", sPkillHelp, "")
    ("systemctl", "systemd 258 (258.1)", sSystemctlHelp, "")
    ("tr", "tr (uutils coreutils) 0.2.2", sTrHelp, "")
    ("sha256sum", "sha256sum (uutils coreutils) 0.2.2", sShaHelp, "")
]

// the fake named `tool` in its own project under d
let sFakeProj d key tool =
    let proj = sProj d key
    match sFakes |> Seq.tryFind (fun (t, _, _, _) -> t == tool) with
    | Some (t, ver, help, rc) ->
        sTool proj t ver help
        if rc <> "" then [rc] |> File.write $"{proj}/bin/{t}.rc"
        proj
    | None -> fail $"no fake {tool}"

// ---- H3R6-S2: wrappers stop at their operand ---------------------------------

let s2Lines = [
    ("sudo", ["sudo -u postgres psql -c x"; "sudo apt-get install -y curl"; "sudo -E make install -j4"])
    ("systemd-run", ["systemd-run --user --scope -p MemoryMax=1G make -j4"])
    ("run0", ["run0 -u root ls -la"])
    ("chrt", ["chrt -r 1 make -j8"])
    ("strace", ["strace -f -o out ls -la"])
    ("uvx", ["uvx ruff check --fix ."])
    ("bunx", ["bunx prettier --write ."; "bunx --bun vite --port 3000"; "bunx -p typescript tsc --init"])
]

let h3r6s2 d =
    s2Lines
    |> Seq.collect (fun (tool, lines) -> sLinesClean (sFakeProj d tool tool) tool lines)
    |> failing

// ---- H3R6-S3: dashWords swallows single-letter typos -------------------------

let h3r6s3 d =
    Seq.append
        (sLinesFlagged (sFakeProj d "kill" "kill") "kill" [("kill -x 1234", "-x"); ("kill -a 1234", "-a")])
        (sLinesFlagged (sFakeProj d "pkill" "pkill") "pkill" [("pkill -Q nginx", "-Q"); ("pkill -E nginx", "-E")])
    |> failing

// ---- H3R6-S4: a listed --x=BOOL does not add --no-x ---------------------------

let h3r6s4 d =
    sLinesClean (sFakeProj d "systemctl" "systemctl") "systemctl" ["systemctl list-units --no-legend --plain"; "systemctl list-timers --all --no-legend"] |> failing

// ---- H3R6-S5: a fresh all-bool sig is read as an older one ---------------------

let h3r6s5 d =
    let partial =
        Seq.append
            (sLinesFlagged (sFakeProj d "sha" "sha256sum") "sha256sum" [("sha256sum -cQ s", "Q")])
            (sLinesFlagged (sFakeProj d "tr" "tr") "tr" [("tr -dQ x", "Q")])
        |> Seq.freeze
    // the same sigs marked exhaustive by hand: the bundle typo is an error
    let exhaustive =
        [("sha", "sha256sum", "sha256sum -cQ s"); ("tr", "tr", "tr -dQ x")]
        |> Seq.map (fun (key, tool, line) ->
            let proj = $"{d}/{key}"
            let f = $"{proj}/.weir/sigs/{tool}.weir"
            if File.exists f then File.append f ["let exhaustive = true"]
            let r = sCheck proj tool 40 line
            ($"""'{line}' under the generated sig marked exhaustive must be an error naming Q (exit {codeOf r}: '{sDiag r}')""", codeOf r <> 0 && sFlagged r && (diagOf r |> Str.contains "Q")))
        |> Seq.freeze
    Seq.append partial exhaustive |> failing

// the fakes' listed flags check clean and a made-up flag warns
let sKnown = [
    ("sudo", "sudo -u root id"); ("systemd-run", "systemd-run --user true"); ("run0", "run0 -u root id"); ("chrt", "chrt -m")
    ("strace", "strace -f ls"); ("uvx", "uvx --from x ruff"); ("bunx", "bunx --bun vite"); ("kill", "kill -TERM 1234")
    ("pkill", "pkill -e nginx"); ("systemctl", "systemctl --all list-units"); ("tr", "tr -d x"); ("sha256sum", "sha256sum -c s")
]

let ctlSKnownFlags d =
    sKnown
    |> Seq.forall (fun (tool, line) ->
        let proj = sFakeProj d tool tool
        let clean = sLinesClean proj tool [line] |> Seq.forall snd
        let bogus = sCheck proj tool 9 $"{tool} --h3r6-bogus x"
        clean && sFlagged bogus)

// ---- H3R6-S1 / H3R6-S6: git (the real one) ------------------------------------

let sGit d key =
    let hasGit = sh -c "command -v git" | succeeds
    if not hasGit then fail "SKIP: git not on PATH"
    sProj d key

let h3r6s1 d =
    let proj = sGit d "git"
    sLinesClean proj "git" ["git stash show --stat"; "git stash show --name-only stash@{1}"; "git stash show --patience -p"] |> failing

let h3r6s6 d =
    let proj = sGit d "git"
    sLinesFlagged proj "git" [("git config --gloabl user.name x", "--gloabl"); ("git config --lisst", "--lisst"); ("git stash --include-untraked", "--include-untraked")] |> failing

let ctlSGit d =
    let proj = sGit d "git"
    let clean = sLinesClean proj "git" ["git commit --amend -m x"; "git stash list --oneline"] |> Seq.forall snd
    clean && sFlagged (sCheck proj "git" 9 "git commit --h3r6-bogus")

// ---- H3R6-E1: a long tool path overflows NAME_MAX --------------------------------

let e1Help = ["Usage: ft [opts]"; ""; "Options:"; "  --aa   aa doc"]

let h3r6e1 d =
    let proj = sProj d "p"
    let deep = [0..49] |> Seq.map (fun i -> $"d{i}") |> Str.join "/"
    let td = $"{d}/tools/{deep}"
    Dir.create td
    ["ft 1.0"] |> File.write $"{td}/ft.version"
    e1Help |> File.write $"{td}/ft.help"
    sChmod (put td "ft" sFake)
    let r = runIn proj "60" ["add"; "sig"; $"{td}/ft"]
    let names = if Dir.exists $"{proj}/.weir/sigs" then Dir.list $"{proj}/.weir/sigs" |> Seq.map Path.fileName |> Seq.freeze else []
    let longest = names |> Seq.map (fun n -> Bytes.length (Str.toUtf8 n) |> Size.toBytes) |> Seq.fold (fun a b -> if b > a then b else a) 0
    failing [
        ($"""weir add sig of a tool at a {Str.length td}-char path must succeed with a sig file name under NAME_MAX (exit {codeOf r}, longest name {longest} bytes: {diagOf r |> oneLine |> Str.sub 0 200})""", codeOf r == 0 && not (Seq.isEmpty names) && longest <= 255 && not (diagOf r |> Str.contains "internal error"))
    ]

// ---- H3R6-E2: a signal to `weir add sig` orphans the probe ---------------------

// --help prints help, marks the log, then becomes `sleep <mark>`
let e2Tool log mark = [
    "#!/bin/sh"
    "case \"$1\" in"
    "  --version) echo \"hng 1.0\";;"
    $"  --help) printf 'Usage: hng [opts]\\n\\nOptions:\\n  --aa   aa\\n'; echo 'BODY DONE' >> '{log}'; {{ echo probe-armed > /dev/tty; }} 2>/dev/null; exec sleep {mark};;"
    "  *) exit 1;;"
    "esac"
]

let e2Leftover proj = Dir.list proj |> Seq.where (fun p -> p |> Path.fileName |> Str.contains "sigprobe") |> Seq.length

// a probe that exits at once leaves nothing behind
let ctlSAddQuick d =
    let proj = sProj d "quick"
    sTool proj "quick" "quick 1.0" ["Usage: quick [opts]"; ""; "Options:"; "  --aa   aa"]
    let (ms, r) = msOf (fun () -> sAdd proj "quick")
    codeOf r == 0 && ms <= 10000 && File.exists $"{proj}/.weir/sigs/quick.weir" && e2Leftover proj == 0

let h3r6e2 d =
    let pp = sProj d "pid"
    let mark = markOf 60 81
    sChmod (put pp "bin/hng" (e2Tool $"{pp}/log" mark))
    let run = sigRunEnv pp [sPathOf pp] ["TERM@log+300"] "15" mark ["add"; "sig"; "hng"]
    reap mark
    let pidLeft = e2Leftover pp
    let tp = sProj d "tty"
    let tmark = markOf 60 82
    sChmod (put tp "bin/hng" (e2Tool $"{tp}/log" tmark))
    let trun = ptyRun tp "15" [sPathOf tp; cli.bin; "add"; "sig"; "hng"] ["WAIT probe-armed"; ctrlC; "SLEEP 2000"]
    Duration.sleep 300ms
    let ttyOrphans = sleepersOf tmark |> Seq.length
    reap tmark
    let ttyLeft = e2Leftover tp
    failing [
        ($"a pid-directed SIGTERM to weir add sig mid-probe: the probe dies and its temp dir goes ({run.summary}, temp dirs left {pidLeft})", sigExit run.rc 15 && run.left == 0 && pidLeft == 0)
        ($"a terminal ^C to weir add sig mid-probe: the probe dies and its temp dir goes (EXIT {trun.code}, orphans {ttyOrphans}, temp dirs left {ttyLeft})", sigExit trun.code 2 && ttyOrphans == 0 && ttyLeft == 0)
    ]

// ---- H3R6-E3: a probe cut at its bound loses what it read ------------------------

let h3r6e3 d =
    let proj = sProj d "slow"
    let mark = markOf 60 83
    sChmod (put proj "bin/slow" ["#!/bin/sh"; "case \"$1\" in"; "  --version) echo \"slow 1.0\";;"; $"  --help) printf 'Usage: slow [opts]\\n\\nOptions:\\n  --aa   aa doc\\n  --bb   bb doc\\n'; exec sleep {mark};;"; "  *) exit 1;;"; "esac"])
    let (ms, r) = msOf (fun () -> sAdd proj "slow")
    reap mark
    let sig = linesOf $"{proj}/.weir/sigs/slow.weir"
    let kept = (sig |> Seq.exists (Str.contains "aa")) && (sig |> Seq.exists (Str.contains "bb"))
    let said = Str.isMatch @"(?i)cut|timed? ?out|time limit|bound|stopped|killed" (diagOf r)
    failing [
        ($"a --help that prints at once then lingers past the probe bound: the sig keeps the flags read (kept: {kept}; exit {codeOf r} after {ms}ms: {diagOf r |> oneLine})", codeOf r == 0 && kept)
        ($"the same: weir add sig says the probe was cut ({diagOf r |> oneLine})", said && not (diagOf r |> Str.contains "found no flags"))
    ]

// ---- H3R6-E4: a legacy-named sig owned by another entry is overwritten ----------

type SLockArt = { kind: string; name: string; path: string }

type SLock = { artifacts: seq<SLockArt> }

// the shape the previous generator wrote for 'a b' under its legacy name
let e4Legacy = ["module Ab"; "type Cmd = {"; "    [<Wire \"only-aSb\">]"; "    onlyASb: bool"; "}"]

let h3r6e4 d =
    let proj = sProj d "p"
    Dir.create $"{proj}/.weir/sigs"
    let legacy = $"{proj}/.weir/sigs/a_b.weir"
    e4Legacy |> File.write legacy
    let sha = File.sha256 legacy
    ["{ \"schemaVersion\": 1, \"artifacts\": [ { \"kind\": \"sig\", \"name\": \"a b\", \"url\": \"generated:help\","; $"  \"sha256\": \"{sha}\", \"path\": \"sigs/a_b.weir\" }} ] }}"] |> File.write $"{proj}/.weir/lock.json"
    sTool proj "a_b" "" ["Usage: t"; ""; "Options:"; "  --only-a_b   doc"]
    let add = sAdd proj "a_b"
    let arts = (linesOf $"{proj}/.weir/lock.json" |> from json SLock).artifacts |> Seq.where (fun a -> a.kind == "sig") |> Seq.freeze
    let holds n flag =
        match arts |> Seq.tryFind (fun a -> a.name == n) with
        | Some a -> linesOf $"{proj}/.weir/{a.path}" |> Seq.exists (Str.contains flag)
        | None -> false
    let verify = runIn proj "30" ["verify"]
    let paths = arts |> Seq.map (fun a -> $"{a.name}={a.path}") |> joined
    failing [
        ($"""weir add sig a_b beside a legacy-named a_b.weir owned by 'a b': 'a b' keeps its own flags (lock '{paths}'; add exit {codeOf add}: {diagOf add |> oneLine})""", holds "a b" "only-aSb")
        ($"""the same: a_b gets its own sig (lock '{paths}')""", codeOf add == 0 && holds "a_b" "only-a_b")
        ($"""the same: weir verify stays clean (exit {codeOf verify}: {diagOf verify |> oneLine})""", codeOf verify == 0)
    ]

// ---- H3R6-E11: the hand-write hint names the unencoded file ----------------------

let h3r6e11 d =
    let proj = sProj d "p"
    sChmod (put proj "bin/g++" ["#!/bin/sh"; "echo \"no help here\""])
    let add = sAdd proj "g++"
    let hinted = match diagOf add with | Regex @"write (\S+\.weir) by hand" p -> Some p | _ -> None
    match hinted with
    | Some rel ->
        let target = if rel |> Str.startsWith "/" then rel else $"{proj}/{rel}"
        Dir.create (Path.dir target)
        ["module Gpp"; "let version = \"g 1\""; "type Cmd = {"; "    aa: bool"; "}"; "let exhaustive = true"] |> File.write target
        let r = sCheck proj "g++" 1 "g++ --zz x"
        failing [
            ($"""the "write … by hand" hint for g++ must name the file #sig g++ reads (hint '{rel}'; a sig written there, check: '{sDiag r}')""", sFlagged r && (diagOf r |> Str.contains "--zz"))
        ]
    | None -> fail $"weir add sig g++ gave no hand-write hint (exit {codeOf add}: {diagOf add |> oneLine})"

// ---- H3R6-S7: sig-score passes on a crashed check, a broken sig, `// cleanup` ----

let s7Scorer () =
    let p =
        match cli.sigscore with
        | Some s -> s
        | None -> Path.combine (Self.scriptPath |> Path.dir) "sig-score.weir"
    if not (File.exists p) then fail $"SKIP: no sig-score.weir at {p}"
    p

// the weir under test, resolved to a file
let s7Bin () =
    if cli.bin |> Str.contains "/" then cli.bin else sh -c $"command -v '{cli.bin}'" | line

// a scorer tree under d: tools/sig-score.weir and tests/sigs/<sample>/ with
// a self-contained fake tool and the given lines.weir
let s7Tree d sample lines =
    let scorer = s7Scorer ()
    Dir.create $"{d}/tools"
    let copy = $"{d}/tools/sig-score.weir"
    if not (File.exists copy) then File.copy scorer copy
    let fx = $"{d}/tests/sigs/{sample}"
    Dir.create $"{fx}/exe"
    sChmod (put fx $"exe/{sample}" ["#!/bin/sh"; "case \"$1\" in"; $"  --help) printf 'Usage: {sample} [opts]\\n\\nOptions:\\n  --aa   aa doc\\n';;"; "  *) exit 1;;"; "esac"])
    lines |> File.write $"{fx}/lines.weir"
    copy

// a fake weir: `check` (and with `brk`, a sig written by `add`) misbehaves,
// everything else is the binary under test
let s7Fake d name mode =
    let real = s7Bin ()
    let body =
        match mode with
        | "crash" -> ["#!/bin/sh"; "if [ \"$1\" = check ]; then echo 'Unhandled exception: boom' >&2; exit 134; fi"; $"exec '{real}' \"$@\""]
        | _ -> ["#!/bin/sh"; $"if [ \"$1\" = add ]; then '{real}' \"$@\"; rc=$?; echo 'type Broken = {{' >> \".weir/sigs/$3.weir\"; exit $rc; fi"; $"exec '{real}' \"$@\""]
    let p = put d name body
    sChmod p
    p

let s7Score d scorer bin sample = runIn d "120" [scorer; "--bin"; bin; "--only"; sample]

// the scorer passes a good sample and fails a real FP, with the real binary
let ctlSScorer d =
    let scorer = s7Tree d "s7ok" [$"#sig s7ok"; "s7ok --aa x // clean"; "s7ok --zz x // typo: --zz"]
    let ok = s7Score d scorer (s7Bin ()) "s7ok"
    let _t2 = s7Tree d "s7fp" [$"#sig s7fp"; "s7fp --zz x // clean"]
    let fp = s7Score d scorer (s7Bin ()) "s7fp"
    codeOf ok == 0 && codeOf fp <> 0

let h3r6s7 d =
    let scorer = s7Tree d "s7a" ["#sig s7a"; "s7a --aa x // clean"]
    let crash = s7Score d scorer (s7Fake d "crash.sh" "crash") "s7a"
    let _b = s7Tree d "s7b" ["#sig s7b"; "s7b --aa x // clean"]
    let broken = s7Score d scorer (s7Fake d "broken.sh" "broken") "s7b"
    let _c = s7Tree d "s7c" ["#sig s7c"; "s7c --aa x // clean"; "s7c --zz x // cleanup the tree"]
    let cleanup = s7Score d scorer (s7Bin ()) "s7c"
    let shown r = $"exit {codeOf r}: {outOf r |> oneLine}"
    failing [
        ($"sig-score must fail a sample whose `weir check` crashed ({shown crash})", codeOf crash <> 0)
        ($"sig-score must fail a sample whose generated sig does not load ({shown broken})", codeOf broken <> 0)
        ($"sig-score must read `// clean` exactly, never inside `// cleanup …` ({shown cleanup})", codeOf cleanup == 0)
    ]

// ---- this part's lists ----------------------------------------------------------

let controlsS = [
    ("control-sig-known-flags (H3R6-S2 H3R6-S3 H3R6-S4 H3R6-S5)", ctlSKnownFlags)
    ("control-sig-git (H3R6-S1 H3R6-S6)", ctlSGit)
    ("control-sig-add-quick (H3R6-E1 H3R6-E2 H3R6-E3 H3R6-E4 H3R6-E11)", ctlSAddQuick)
    ("control-sig-scorer (H3R6-S7)", ctlSScorer)
]

let probesS = [
    ("H3R6-E1", h3r6e1); ("H3R6-E2", h3r6e2); ("H3R6-E3", h3r6e3); ("H3R6-E4", h3r6e4); ("H3R6-E11", h3r6e11)
    ("H3R6-S1", h3r6s1); ("H3R6-S2", h3r6s2); ("H3R6-S3", h3r6s3); ("H3R6-S4", h3r6s4); ("H3R6-S5", h3r6s5); ("H3R6-S6", h3r6s6); ("H3R6-S7", h3r6s7)
]
// ---- the lists ---------------------------------------------------------------

let controls = Seq.concat [controlsA; controlsP; controlsB; controlsF; controlsS] |> Seq.freeze

let probes = Seq.concat [probesA; probesP; probesB; probesF; probesS] |> Seq.freeze

// a label word starting with the --only text; an id ending in a digit never
// selects a longer number (H3R6-E1 is not H3R6-E10)
let picks o w =
    let rest = if Str.length w > Str.length o then Str.sub (Str.length o) (Str.length w - Str.length o) w else ""
    (w |> Str.startsWith o) && not ((Str.isMatch @"[0-9]$" o) && (Str.isMatch @"^[0-9]" rest))

let selected (label, _) =
    match cli.only with
    | Some o -> label |> Str.rsplit @"[ ()]+" |> Seq.exists (picks o)
    | None -> true

// ---- the verdict channel ------------------------------------------------------

let record vpath line =
    print $"  {line}"
    File.append vpath [line]

// every probe and control gets its own temp dir
let runProbe vpath (label, probe) =
    within tmp w
        let (ms, res) = msOf (fun () -> probe w |> try result)
        let took = $"[{ms}ms]"
        match res with
        | Ok fs when fs |> Seq.isEmpty -> record vpath $"{label} OK {took}"
        | Ok fs -> record vpath $"""{label} REPRODUCES ({fs |> Str.join "; "}) {took}"""
        | Error m when m |> Str.contains "SKIP: " -> record vpath $"{label} SKIP ({m})"
        | Error m -> record vpath $"{label} REPRODUCES (the probe failed to run: {m}) {took}"

let runControl vpath (label, ctl) =
    within tmp w
        let (ms, res) = msOf (fun () -> ctl w |> try result)
        let took = $"[{ms}ms]"
        match res with
        | Ok true -> record vpath $"{label} OK {took}"
        | Ok false -> record vpath $"*** CONTROL FAILED: {label} {took}"
        | Error m when m |> Str.contains "SKIP: " -> record vpath $"{label} SKIP ({m})"
        | Error m -> record vpath $"*** CONTROL FAILED: {label} (the control failed to run: {m})"

// ---- the gate ----------------------------------------------------------------

print "third bug hunt, round 6 fixes — repro gate (dev/plans/PLAN-hunt3r6-fixes.md)"
print $"  binary: {cli.bin}"

within tmp d
    let vpath = $"{d}/verdicts"
    [] |> File.write vpath

    if not toolsReady then
        record vpath "instruments SKIP (timeout/env/python3/ps/kill/setsid/bash/ln/mkfifo//proc missing) — every item stays OPEN"

    if toolsReady then
        print ""
        print "controls"
        controls |> Seq.where selected |> Seq.iter (runControl vpath)
        print ""
        print "probes"
        probes |> Seq.where selected |> Seq.iter (runProbe vpath)

    print ""
    let verdicts = File.read vpath |> Seq.freeze
    let open =
        verdicts
        |> Seq.where (fun l ->
            (l |> Str.contains "REPRODUCES") || (l |> Str.contains "CONTROL FAILED") || (l |> Str.contains "SKIP"))
        |> Seq.freeze

    let repro = verdicts |> Seq.where (fun l -> l |> Str.contains "REPRODUCES") |> Seq.length
    let skipped = verdicts |> Seq.where (fun l -> (l |> Str.startsWith "H3R6-") && (l |> Str.contains " SKIP")) |> Seq.length
    let ok = verdicts |> Seq.where (fun l -> (l |> Str.startsWith "H3R6-") && (l |> Str.contains " OK")) |> Seq.length
    print $"summary: {ok} probe(s) OK, {repro} REPRODUCE, {skipped} SKIP"

    if open |> Seq.isEmpty then
        print (if cli.only == None then "ALL ITEMS FIXED" else "ALL SELECTED ITEMS FIXED (--only)")
    else
        let n = open |> Seq.length
        print $"{n} line(s) keep the gate shut (a SKIP or a failed control counts):"
        open |> Seq.iter (fun l -> print $"  {l}")
        exit (if n > 255 then 255 else n)
