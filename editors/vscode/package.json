{
  "name": "weir",
  "displayName": "weir",
  "description": "Language support for weir, the typed shell — diagnostics, hover, and completion via `weir lsp`, plus TextMate colorization.",
  "version": "0.1.0",
  "publisher": "weir-local",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:weir"
  ],
  "contributes": {
    "languages": [
      {
        "id": "weir",
        "aliases": [
          "weir"
        ],
        "extensions": [
          ".weir"
        ],
        "firstLine": "^#!.*\\bweir\\b",
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "weir",
        "scopeName": "source.weir",
        "path": "./syntaxes/weir.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "weir",
      "properties": {
        "weir.serverPath": {
          "type": "string",
          "default": "weir",
          "description": "Path to the weir BINARY only (the client runs '<path> lsp' itself). A bare name resolves from PATH, then ~/.local/bin; an absolute path is the escape hatch."
        }
      }
    },
    "semanticTokenTypes": [
      {
        "id": "weirCommandHead",
        "description": "a command-mode head (external program)"
      },
      {
        "id": "weirArgv",
        "description": "a literal argv word in command mode"
      },
      {
        "id": "weirSplice",
        "description": "a splice island marker inside command mode"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "weir",
        "scopes": {
          "weirCommandHead": [
            "entity.name.function.command.weir"
          ],
          "weirArgv": [
            "string.unquoted.argument.weir"
          ],
          "weirSplice": [
            "keyword.operator.splice.weir"
          ]
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc --noEmit -p ./ && esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --minify",
    "watch": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --watch",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.91.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.4.0",
    "esbuild": "^0.25.0",
    "vscode-languageclient": "^10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/arquidevio/weir"
  }
}