{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "information_for_contributors": [
    "PORTED from editors/micro/weir.yaml, rule for rule — the micro file is the SPEC.",
    "Maintenance rule: a rule existing in one grammar only is DRIFT; add to BOTH or neither.",
    "The inventory test (ci/e2e.sh) diffs micro's '# rule:' annotations against this file's repository keys.",
    "Dialect delta: Oniguruma lookbehind/lookahead is used ONLY where it simplifies an existing micro rule (comment/district/single-quote guards; the verbatim end), never to add rules micro lacks.",
    "Command-mode single quotes: the opener needs a preceding space/line-start so apostrophes in comments (GUIDE's, don't) never open a region; a mid-word ' never opens one either, matching command arg tokenization.",
    "Raw kinds: verbatim @\"...\" has one escape (\"\" = a quote, via lookahead on the end); triple \"\"\"...\"\"\" has none at all and closes at the FIRST triple (FCS-verdict-pinned).",
    "The Regex pattern literal is its own RAW literal kind that paints as a string region — do not 'fix' the highlighting to imply string escapes inside it."
  ],
  "name": "weir",
  "scopeName": "source.weir",
  "patterns": [
    {
      "include": "#doc-comment"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#shebang"
    },
    {
      "include": "#directive"
    },
    {
      "include": "#interp-string"
    },
    {
      "include": "#raw-triple"
    },
    {
      "include": "#raw-verbatim"
    },
    {
      "include": "#plain-string"
    },
    {
      "include": "#type-param"
    },
    {
      "include": "#command-single-quote"
    },
    {
      "include": "#yaml-district"
    },
    {
      "include": "#binder"
    },
    {
      "include": "#within-kind"
    },
    {
      "include": "#adapter-word"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#reserved"
    },
    {
      "include": "#bool"
    },
    {
      "include": "#not"
    },
    {
      "include": "#field-name"
    },
    {
      "include": "#types"
    },
    {
      "include": "#builtin-types"
    },
    {
      "include": "#field-type"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#sigil-open"
    },
    {
      "include": "#force-prefix"
    },
    {
      "include": "#splice"
    },
    {
      "include": "#member"
    },
    {
      "include": "#field-sugar"
    },
    {
      "include": "#attribute"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "doc-comment": {
      "match": "(?:^|(?<=[ \\t]))///.*$",
      "name": "comment.line.documentation.weir"
    },
    "comment": {
      "match": "(?:^|(?<=[ \\t]))//.*$",
      "name": "comment.line.double-slash.weir"
    },
    "shebang": {
      "match": "^#!.*$",
      "name": "comment.line.shebang.weir"
    },
    "directive": {
      "match": "^#loose\\b",
      "name": "meta.preprocessor.weir"
    },
    "within-kind": {
      "match": "\\b(within)[ \\t]+(tmp|cd|env)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.weir"
        },
        "2": {
          "name": "keyword.other.within-kind.weir"
        }
      }
    },
    "adapter-word": {
      "match": "\\b(from|to)[ \\t]+(jsonl|json|yaml)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.weir"
        },
        "2": {
          "name": "keyword.other.adapter.weir"
        }
      }
    },
    "keywords": {
      "match": "\\b(let|in|if|then|elif|else|when|match|with|function|fun|type|of|from|to|for|do|module|import|within|retry|poll|until)\\b",
      "name": "keyword.control.weir"
    },
    "reserved": {
      "match": "\\b(rec|mutable|function)\\b",
      "name": "keyword.other.reserved.weir"
    },
    "bool": {
      "match": "\\b(true|false)\\b",
      "name": "constant.language.boolean.weir"
    },
    "not": {
      "match": "\\bnot\\b",
      "name": "keyword.operator.logical.weir"
    },
    "types": {
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
      "name": "entity.name.type.weir"
    },
    "builtin-types": {
      "match": "\\b(int|string|bool|unit)\\b",
      "name": "entity.name.type.weir"
    },
    "numbers": {
      "match": "\\b[0-9]+\\b",
      "name": "constant.numeric.weir"
    },
    "sigil-open": {
      "match": "\\$\\(|!\\(|[$!][a-z_][A-Za-z0-9_]*\\(",
      "name": "keyword.other.sigil.weir"
    },
    "force-prefix": {
      "match": "\\^[A-Za-z][A-Za-z0-9_.-]*",
      "name": "keyword.other.force.weir"
    },
    "splice": {
      "match": "\\$[a-z_][A-Za-z0-9_]*",
      "name": "variable.other.splice.weir"
    },
    "attribute": {
      "match": "\\[<|>\\]",
      "name": "keyword.operator.attribute.weir"
    },
    "operators": {
      "match": "\\|>|>>|<<|==|<>|<=|>=|->|\\.\\.|::|&&|\\|\\||[+\\-*/<>=;,]|\\|",
      "name": "keyword.operator.weir"
    },
    "field-sugar": {
      "match": "_\\.[A-Za-z][A-Za-z0-9_]*|_\\[",
      "name": "variable.other.member.weir"
    },
    "interp-string": {
      "begin": "\\$\"",
      "end": "\"",
      "name": "string.interpolated.weir",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.weir"
        },
        {
          "match": "\\{\\{|\\}\\}",
          "name": "constant.character.escape.weir"
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "name": "meta.interpolation.weir",
          "patterns": [
            {
              "match": "\\b(if|then|elif|else|when|match|with|function|fun|let|in)\\b",
              "name": "keyword.control.weir"
            },
            {
              "include": "#bool"
            },
            {
              "include": "#types"
            },
            {
              "include": "#builtin-types"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#field-sugar"
            },
            {
              "match": "\\|>|==|<>|<=|>=|->|\\.\\.|::|[+\\-*/<>=]",
              "name": "keyword.operator.weir"
            },
            {
              "match": "\\b[a-z_][A-Za-z0-9_]*\\b",
              "name": "variable.other.weir"
            }
          ]
        }
      ]
    },
    "raw-triple": {
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "name": "string.quoted.triple.weir"
    },
    "raw-verbatim": {
      "begin": "@\"",
      "end": "\"(?!\")",
      "name": "string.quoted.verbatim.weir",
      "patterns": [
        {
          "match": "\"\"",
          "name": "constant.character.escape.weir"
        }
      ]
    },
    "plain-string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.weir",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.weir"
        }
      ]
    },
    "command-single-quote": {
      "begin": "(?<=^|[ \\t])'",
      "end": "'",
      "name": "string.quoted.single.weir"
    },
    "field-type": {
      "match": "(:)\\s*([a-z_][A-Za-z0-9_]*)",
      "captures": {
        "2": {
          "name": "entity.name.type.weir"
        }
      }
    },
    "member": {
      "match": "\\.[A-Za-z_][A-Za-z0-9_]*",
      "name": "variable.other.member.weir"
    },
    "binder": {
      "match": "\\b(let|fun)\\s+([a-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.control.weir"
        },
        "2": {
          "name": "variable.weir"
        }
      }
    },
    "type-param": {
      "match": "'[a-zA-Z_][A-Za-z0-9_]*(?![^\\n]*'(?![A-Za-z0-9_]))",
      "name": "entity.name.type.weir"
    },
    "field-name": {
      "match": "(?:^|(?<=[{;]))\\s*([A-Za-z_][A-Za-z0-9_]*)(?=\\s*[:=])",
      "captures": {
        "1": {
          "name": "variable.other.property.weir"
        }
      }
    },
    "yaml-district": {
      "comment": "the yaml district [D:yaml-district]: a line-end `yaml` marker opens a checked template block. Lookbehinds exclude the `to yaml`/`from yaml` adapters (tree-sitter does this lexically via its adapter token; RE2 cannot at all — micro-exempt). The while continues on ANY indented or blank line, not indent>=base — a renderer bound, same charter as tree-sitter's over-accepts.",
      "begin": "(?:^|(?<=[ \\t]))(?<!\\bto[ \\t])(?<!\\bfrom[ \\t])(yaml(?:[ \\t]+schema=[a-z0-9-]+)?)[ \\t]*$",
      "while": "^(?=[ \\t])|^[ \\t]*$",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.district.weir"
        }
      },
      "patterns": [
        {
          "comment": "block scalar content is LITERAL [D:block-scalars] — no splice/for coloring inside; the while backreferences the header's indent, so the region ends at the first line not deeper than it",
          "begin": "^([ \\t]*)(?:(-)[ \\t]+|((?:- )*[^:#$\"\\s][^:#$\"]*?)(:)[ \\t]*)(\\|-?)[ \\t]*$",
          "while": "^(?:\\1[ \\t]|[ \\t]*$)",
          "contentName": "string.unquoted.block.yaml.weir",
          "beginCaptures": {
            "2": {
              "name": "punctuation.definition.list.weir"
            },
            "3": {
              "name": "variable.other.property.weir"
            },
            "4": {
              "name": "punctuation.separator.key-value.weir"
            },
            "5": {
              "name": "keyword.other.district.weir"
            }
          },
          "patterns": []
        },
        {
          "begin": "^[ \\t]*(for)\\b",
          "end": "$",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.weir"
            }
          },
          "patterns": [
            {
              "match": "\\bin\\b",
              "name": "keyword.control.weir"
            },
            {
              "match": "\\b[a-z_][A-Za-z0-9_]*\\b",
              "name": "variable.other.weir"
            },
            {
              "match": "[(),]",
              "name": "punctuation.weir"
            }
          ]
        },
        {
          "begin": "\\$\\(",
          "end": "\\)",
          "name": "meta.interpolation.weir",
          "captures": {
            "0": {
              "name": "keyword.other.sigil.weir"
            }
          },
          "patterns": [
            {
              "include": "#bool"
            },
            {
              "include": "#types"
            },
            {
              "include": "#builtin-types"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#field-sugar"
            },
            {
              "match": "\\|>|==|<>|<=|>=|->|\\.\\.|::|[+\\-*/<>=]",
              "name": "keyword.operator.weir"
            },
            {
              "match": "\\b[a-z_][A-Za-z0-9_]*\\b",
              "name": "variable.other.weir"
            }
          ]
        },
        {
          "include": "#splice"
        },
        {
          "include": "#plain-string"
        },
        {
          "match": "(?:^|(?<=[ \\t]))#.*$",
          "name": "comment.line.number-sign.weir"
        },
        {
          "match": "^[ \\t]*(-)(?=[ \\t]|$)",
          "captures": {
            "1": {
              "name": "punctuation.definition.list.weir"
            }
          }
        },
        {
          "match": "(?:^[ \\t]*|(?<=-[ \\t]))([^:\\s#$\"][^:#$\"]*?)(:)(?=[ \\t]|$)",
          "captures": {
            "1": {
              "name": "variable.other.property.weir"
            },
            "2": {
              "name": "punctuation.separator.key-value.weir"
            }
          }
        },
        {
          "match": "(?:[^#$\"\\n]|(?<![ \\t])#)+",
          "name": "string.unquoted.yaml.weir"
        }
      ]
    }
  }
}
