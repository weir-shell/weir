let rs = [1; 2] |> Seq.pmap (fun i ->
    let firsts = $(sh -c "yes") |> Seq.take 3 |> Seq.freeze
    let lazyCmd = $(sh -c "echo ran >&2; echo one; echo two")
    let n = lazyCmd |> Seq.length
    let again = lazyCmd |> Str.join "+"
    let evens = $(seq 1 20) |> Seq.where (fun l -> (Str.toInt l) % 2 == 0) |> Seq.map (fun l -> $"<{l}>") |> Seq.take 4 |> Str.join ""
    let viaCmd = $(seq 1 3) |> Seq.map (fun l -> $(sh -c $"echo x{l}") |> Str.join "") |> Str.join ","
    let total = $(seq 1 100) |> Seq.fold (fun a l -> a + Str.toInt l) 0
    let picked = $(seq 1 9) |> Seq.choose (fun l -> if l == "5" then Some $(sh -c "echo five") else None) |> Seq.map (fun s -> Str.join "" s) |> Str.join ""
    $(sh -c "printf 'p1\np2\n'") |> Seq.map (fun l -> $"{i}:{l}") |> Seq.iter (fun _ -> ())
    $"{i} {firsts} {n} {again} {evens} {viaCmd} {total} {picked}")
rs |> Seq.iter print
let bad = [1] |> Seq.pmap (fun _ -> $(sh -c "echo a; exit 3") |> Seq.map Str.toUpper |> Str.join ",") |> try result
print $"{bad}"
let unread = [1] |> Seq.pmap (fun _ ->
    let _never = $(sh -c "echo SHOULD-NOT-RUN >&2")
    "ok")
unread |> Seq.iter print
[1] |> Seq.piter (fun _ ->
    $(sh -c "echo a; echo b; exit 4") |> Seq.map Str.toUpper |> print)
