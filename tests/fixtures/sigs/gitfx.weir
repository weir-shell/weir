    [<Wire "-n">]
    shortn: bool
    noTags: bool
    noVerbose: bool
    [<Wire "-t">]
    shortt: string
    tags: bool
    /// be verbose; must be placed before a subcommand
    [<Short "v">]
    verbose: bool
}
type RemoteAddFlags = {
    /// fetch the remote branches
    [<Short "f">]
