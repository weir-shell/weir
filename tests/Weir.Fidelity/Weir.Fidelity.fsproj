<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- the SHIPPED binary runs invariant (Weir.fsproj); a culture-mode
         host would referee different string semantics [D:invariant-strings] -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.302" />
    <PackageReference Include="Expecto" Version="10.2.1" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" Version="0.14.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="FSharp.Compiler.Service" Version="43.12.204" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Weir\Weir.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Oracle.fs" />
    <Compile Include="Pins.fs" />
    <Compile Include="Corpus.fs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\fidelity\divergences.md" CopyToOutputDirectory="PreserveNewest" Link="divergences.md" />
  </ItemGroup>

</Project>
