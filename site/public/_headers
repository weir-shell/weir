# Cloudflare Pages headers [D:site-deploy] — the installers must render
# as TEXT in a browser (a click on the install line should show the
# script, not download it); curl|sh is content-type-blind either way.
/install.sh
  Content-Type: text/plain; charset=utf-8
/install.ps1
  Content-Type: text/plain; charset=utf-8
