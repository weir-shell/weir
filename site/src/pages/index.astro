---
// The hero [D:hero] [D:hero-3]: the fold leads with a SHORT typed
// boundary that ENDS in a real command — `from json` parses the
// version, `git tag` consumes it (the typed value crosses into argv
// as exactly one word). Beat 1 shows the check at three distances
// [D:hero-3]: a tool's flag (#sig), a manifest's key (yaml schema=),
// and a program name (PATH) — three mistakes, none of them weir, one
// `weir check` report. Sections are gleam-shaped [D:site-style]:
// short prose BESIDE its example (desktop), stacked on mobile, the
// install lines below the demo on phones (nobody pipes curl|sh
// there). Every quoted output on this page comes from a run of the
// shipped binary and is pinned (unit byte-pin for the splice
// refusal; the e2e hero-currency cell for everything quoted) —
// never the docs gate, which asserts executability, not output.
import Base from "../layouts/Base.astro";
import queilThemes from "../lib/queil-weir.mjs";
import { Code } from "astro:components";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";

// process.cwd() (the site dir), not import.meta.url — Astro 7 bundles
// page frontmatter into prerender chunks, so import.meta.url no longer
// anchors the source file (showcase/reference already read this way)
const weirGrammar = JSON.parse(
  readFileSync(resolve(process.cwd(), "../editors/vscode/syntaxes/weir.tmLanguage.json"), "utf8"),
);

const heroWeir = `type Pkg = { name: string; version: string }

let pkg = File.read "package.json" |> from json Pkg
git tag $"v{pkg.version}"
print $"tagged {pkg.name} v{pkg.version}"`;

// verbatim from running the script in a git repo — e2e-pinned
const heroOut = `tagged acme-api v2.4.0`;

const beat1Weir = `#sig bicep

bicep build --outfil main.json

let config = yaml schema=k8s-configmap
    apiVerison: v1
    kind: ConfigMap
    metadata:
        name: site-config
    data:
        template: main.json

config |> to yaml |> File.write "config.yaml"
rsnyc -av main.json config.yaml backup:/srv/site`;

// verbatim from \`weir check deploy.weir\` — e2e-pinned
const beat1Check = `deploy.weir:3:13: error [sig]: unknown flag '--outfil' for bicep. Did you mean '--outfile'? (#sig bicep, line 1; exhaustive signature)
deploy.weir:6:5: error [schema]: schema k8s-configmap: unknown field 'apiVerison' — did you mean 'apiVersion'?
deploy.weir:14:1: warning [cmd-not-found]: command not found on PATH: rsnyc — weir resolves commands at check time; the script runs once it is installed`;

const beat2Weir = `type Cli = {
    /// print what would happen, deploy nothing
    dryRun: bool

    /// the environment to deploy to
    target: string

    /// wait this long for the health check
    timeout: Option<Duration>
}

let cli = Args.load Cli`;

// verbatim from \`weir ship.weir --help\` (v0.0.22) — e2e-pinned
const beat2Help = `usage: ship.weir [flags]
  -d, --dry-run               print what would happen, deploy nothing
      --target <string>       required — the environment to deploy to
      --timeout <duration>    optional — wait this long for the health check`;

const spliceWeir = `let steamroot = Self.scriptPath |> Path.dir
rm -rf $steamroot/*`;

// verbatim from \`weir check\` — byte-pinned in Tests.fs + e2e
const spliceRefusal = `steam.weir:2:18: error [parse]: argv words do not concatenate — adjacent pieces would each become their OWN
argument (\`$root/*\` would pass \`/*\` separately; \`--flag="v"\` would pass
\`--flag=\` separately). Build one word with an interpolated arg (\`$"{root}/*"\`,
\`$"--flag={v}"\`), quote the whole word, or use \`Path.under dir name\` for a
filesystem path (it refuses a result that escapes dir, where \`Path.combine\`
would follow it)`;

const steamBash = `# figure out the absolute path to the script being run
STEAMROOT="$(cd "\${0%/*}" && echo $PWD)"

# Scary!
rm -rf "$STEAMROOT/"*`;

// verbatim from \`weir check --can tools/fuzz.weir\` (v0.0.8) — e2e-pinned
const canReport = `tools/fuzz.weir can (capability, not behaviour — an untaken branch still counts):
  runs:
    git  tools/fuzz.weir:23:12
    ci/deep-lock.sh × 2  tools/fuzz.weir:31:41 tools/fuzz.weir:72:5
    date  tools/fuzz.weir:39:15
    dotnet  tools/fuzz.weir:59:56
  reads:
    File.read (path not statically known)  tools/fuzz.weir:65:20
  writes:
    within tmp (a temporary directory)  tools/fuzz.weir:47:1
  environment:
    reads WEIR_FUZZ_STRICT_SPANS (Env.get)  tools/fuzz.weir:43:14
    sets WEIR_FUZZ_SEED, WEIR_FUZZ_COUNT, WEIR_FUZZ_REPORT for children (within env)  tools/fuzz.weir:54:49
  terminates:
    fail  tools/fuzz.weir:68:9`;
---

<Base search={false}>
  <div class="hero-grid">
    <div class="hero-intro">
      <svg class="mark-lg" viewBox="18 32 92 62" width="76" height="51" aria-hidden="true">
        <rect class="b1" x="20" y="34" width="56" height="12" rx="6" />
        <rect class="b2" x="36" y="57" width="56" height="12" rx="6" />
        <rect class="b3" x="52" y="80" width="56" height="12" rx="6" />
      </svg>
      <h1>For scripts that became tools.</h1>
      <p class="what">weir is a typed shell-scripting language.</p>
      <p class="sub">
        Commands, pipes and files, like a shell — the whole file
        checked before anything runs. One static binary, with the
        editor LSP built in.
      </p>
    </div>
    <div class="hero-demo">
      <Code code={heroWeir} lang={weirGrammar} themes={queilThemes} defaultColor={false} />
      <figure class="term">
        <figcaption>$ weir tag.weir</figcaption>
        <pre class="report">{heroOut}</pre>
      </figure>
      <p class="hero-caption">
        Declare the shape; <code>from json</code> parses a file or a
        tool's output into it — and the typed value crosses back into
        a real command's argv as exactly one word.
      </p>
    </div>
    <div class="hero-install">
      <p class="install-label">Quick install</p>
      <div class="install-lines">
        <div class="install-line">
          <span class="os" aria-label="Linux and macOS"><svg class="os-ico" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" role="img" aria-label="Linux"><path d="M12.504 0c-.155 0-.315.008-.48.021-4.226.333-3.105 4.807-3.17 6.298-.076 1.092-.3 1.953-1.05 3.02-.885 1.051-2.127 2.75-2.716 4.521-.278.832-.41 1.684-.287 2.489a.424.424 0 00-.11.135c-.26.268-.45.6-.663.839-.199.199-.485.267-.797.4-.313.136-.658.269-.864.68-.09.189-.136.394-.132.602 0 .199.027.4.055.536.058.399.116.728.04.97-.249.68-.28 1.145-.106 1.484.174.334.535.47.94.601.81.2 1.91.135 2.774.6.926.466 1.866.67 2.616.47.526-.116.97-.464 1.208-.946.587-.003 1.23-.269 2.26-.334.699-.058 1.574.267 2.577.2.025.134.063.198.114.333l.003.003c.391.778 1.113 1.132 1.884 1.071.771-.06 1.592-.536 2.257-1.306.631-.765 1.683-1.084 2.378-1.503.348-.199.629-.469.649-.853.023-.4-.2-.811-.714-1.376v-.097l-.003-.003c-.17-.2-.25-.535-.338-.926-.085-.401-.182-.786-.492-1.046h-.003c-.059-.054-.123-.067-.188-.135a.357.357 0 00-.19-.064c.431-1.278.264-2.55-.173-3.694-.533-1.41-1.465-2.638-2.175-3.483-.796-1.005-1.576-1.957-1.56-3.368.026-2.152.236-6.133-3.544-6.139zm.529 3.405h.013c.213 0 .396.062.584.198.19.135.33.332.438.533.105.259.158.459.166.724 0-.02.006-.04.006-.06v.105a.086.086 0 01-.004-.021l-.004-.024a1.807 1.807 0 01-.15.706.953.953 0 01-.213.335.71.71 0 00-.088-.042c-.104-.045-.198-.064-.284-.133a1.312 1.312 0 00-.22-.066c.05-.06.146-.133.183-.198.053-.128.082-.264.088-.402v-.02a1.21 1.21 0 00-.061-.4c-.045-.134-.101-.2-.183-.333-.084-.066-.167-.132-.267-.132h-.016c-.093 0-.176.03-.262.132a.8.8 0 00-.205.334 1.18 1.18 0 00-.09.4v.019c.002.089.008.179.02.267-.193-.067-.438-.135-.607-.202a1.635 1.635 0 01-.018-.2v-.02a1.772 1.772 0 01.15-.768c.082-.22.232-.406.43-.533a.985.985 0 01.594-.2zm-2.962.059h.036c.142 0 .27.048.399.135.146.129.264.288.344.465.09.199.14.4.153.667v.004c.007.134.006.2-.002.266v.08c-.03.007-.056.018-.083.024-.152.055-.274.135-.393.2.012-.09.013-.18.003-.267v-.015c-.012-.133-.04-.