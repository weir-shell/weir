---
// The hero [D:hero]: the maintenance story, told in three beats that
// each answer one alternative — bash/PowerShell/Nushell (the check is
// the test), PowerShell at tool scale (a real CLI, free), F# scripts
// (one static binary). Beat 1 sits IN the fold ([D:og-card]'s sibling
// move: a language's product is code, so the fold shows a refusal
// beside the install lines). The catastrophe material
// (splice/Steam/pgpool) illustrates "predictable" BELOW the fold;
// --can is a second-visit feature and sits below too. Every quoted
// output on this page comes from a run of the shipped binary and is
// pinned (unit byte-pin for the splice refusal; the e2e hero-currency
// cell for everything quoted) — never the docs gate, which asserts
// executability, not output.
import Base from "../layouts/Base.astro";
import queilThemes from "../lib/queil-weir.mjs";
import { Code } from "astro:components";
import { readFileSync } from "node:fs";

const weirGrammar = JSON.parse(
  readFileSync(
    new URL("../../../editors/vscode/syntaxes/weir.tmLanguage.json", import.meta.url),
    "utf8",
  ),
);

const beat1Weir = `type Cli = {
    /// print what would happen, upload nothing
    dryRun: bool
}

let cli = Args.load Cli
tar czf bundle.tar.gz dist/
if not cli.dryRun then rsnyc -av bundle.tar.gz backup:/srv/dist`;

// verbatim from running the script above — e2e-pinned
const beat1Refusal = `release.weir:8:24: parse error:
if not cli.dryRun then rsnyc -av bundle.tar.gz backup:/srv/dist
                       ^
unknown command 'rsnyc' — not found on PATH. weir resolves command names before running: install the tool, or run it through sh -c`;

const beat2Weir = `type Cli = {
    /// print what would happen, deploy nothing
    dryRun: bool

    /// the environment to deploy to
    target: string

    /// wait this long for the health check
    timeout: Option<Duration>
}

let cli = Args.load Cli`;

// verbatim from \`weir deploy.weir --help\` (v0.0.3) — e2e-pinned
const beat2Help = `usage: [flags]
  -d, --dry-run               print what would happen, deploy nothing
      --target <string>       required — the environment to deploy to
      --timeout               optional — wait this long for the health check`;

const spliceWeir = `let steamroot = Self.scriptPath |> Path.dir
rm -rf $steamroot/*`;

// verbatim from \`weir check\` — byte-pinned in Tests.fs + e2e
const spliceRefusal = `steam.weir:2:18: error [parse]: argv words do not concatenate — adjacent pieces would each become their OWN
argument (\`$root/*\` would pass \`/*\` separately; \`--flag="v"\` would pass
\`--flag=\` separately). Build one word with an interpolated arg (\`$"{root}/*"\`,
\`$"--flag={v}"\`), quote the whole word, or use \`Path.under dir name\` for a
filesystem path (it refuses a result that escapes dir, where \`Path.combine\`
would follow it)`;

const steamBash = `# figure out the absolute path to the script being run
STEAMROOT="$(cd "\${0%/*}" && echo $PWD)"

# Scary!
rm -rf "$STEAMROOT/"*`;

// verbatim from \`weir check --can tools/fuzz.weir\` (v0.0.8) — e2e-pinned
const canReport = `tools/fuzz.weir can (capability, not behaviour — an untaken branch still counts):
  runs:
    git  tools/fuzz.weir:23:12
    ci/deep-lock.sh × 2  tools/fuzz.weir:31:41 tools/fuzz.weir:72:5
    date  tools/fuzz.weir:39:15
    dotnet  tools/fuzz.weir:59:56
  reads:
    File.read (path not statically known)  tools/fuzz.weir:65:20
  writes:
    within tmp (a temporary directory)  tools/fuzz.weir:47:1
  environment:
    reads WEIR_FUZZ_STRICT_SPANS (Env.get)  tools/fuzz.weir:43:14
    sets WEIR_FUZZ_SEED, WEIR_FUZZ_COUNT, WEIR_FUZZ_REPORT for children (within env)  tools/fuzz.weir:54:49
  terminates:
    fail  tools/fuzz.weir:68:9`;
---

<Base>
  <div class="hero-grid">
    <div class="hero-intro">
      <h1>For scripts that became tools.</h1>
      <p class="what">weir is a typed shell-scripting language.</p>
      <p class="sub">
        Commands, pipes and files, like bash — with a checker up front.
        The whole file is checked, every command included, and nothing
        runs until everything checks. One static binary: no runtime, no
        compile step, the same on Linux, macOS and Windows.
      </p>
      <div class="install-lines">
        <div class="install-line">
          <span class="os">Linux · macOS</span>
          <pre><code id="install-cmd">curl -fsSL https://weir.sh/install.sh | sh</code></pre>
          <button class="copy-btn" data-copy="install-cmd" aria-label="Copy install command" title="Copy">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="5" y="5" width="9" height="9" rx="1.5"/><path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5"/></svg>
          </button>
        </div>
        <div class="install-line">
          <span class="os">Windows</span>
          <pre><code id="install-cmd-win">irm https://weir.sh/install.ps1 | iex</code></pre>
          <button class="copy-btn" data-copy="install-cmd-win" aria-label="Copy Windows install command" title="Copy">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="5" y="5" width="9" height="9" rx="1.5"/><path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5"/></svg>
          </button>
        </div>
        <p class="install-more">
          <a href="/docs/install/">More install options</a> — Docker,
          checksums, air-gapped.
        </p>
      </div>
    </div>
    <div class="hero-demo">
      <p class="hero-label">
        release.weir — a typed flag, two commands, one misspelled:
      </p>
      <Code code={beat1Weir} lang={weirGrammar} themes={queilThemes} defaultColor={false} />
      <p class="hero-label">Run it:</p>
      <pre class="refusal wrap">{beat1Refusal}</pre>
      <p class="hero-caption">
        <strong>Nothing ran</strong> — the bundle was never created,
        nothing uploaded, no half-finished state.
      </p>
    </div>
  </div>

  <h2>The check is the test</h2>
  <p>
    That refusal is the whole idea. Your shell finds out when it gets
    there; weir resolves every command — including the ones on your
    PATH — and checks every type in the file before the first one
    runs. The output above is not a mock-up: every quoted output on
    this page comes from running the shipped binary, verified in CI.
  </p>

  <h2>A real CLI, free</h2>
  <p>Declare the shape; the interface is derived.</p>
  <Code code={beat2Weir} lang={weirGrammar} themes={queilThemes} defaultColor={false} />
  <pre class="report">{beat2Help}</pre>
  <p>
    <code>dryRun</code> became <code>--dry-run</code> with an
    unambiguous <code>-d</code>; the <code>///</code> docs became the
    help text. You did not write an argument parser, and you cannot
    forget to update <code>--help</code>. Unknown flags, missing
    requireds and unparseable values arrive together, in one boundary
    error, before any effect runs.
  </p>

  <h2>Predictable, illustrated</h2>
  <p>
    Two bash mechanisms have deleted real machines: an unquoted
    variable <em>splitting</em> into words, and a path <em>glued</em>
    from pieces that came apart. pgpool-II was patching the first by
    hand in review as recently as September 2025 — quoting variables
    in an <code>rm</code> so an empty expansion could not widen it.
    Valve shipped the second in 2015:
  </p>
  <div class="hero-band">
    <div class="hero-pair">
      <div class="hero-cell">
        <p class="hero-label">steam.sh, shipped:</p>
        <Code code={steamBash} lang="bash" themes={queilThemes} defaultColor={false} />
        <p class="hero-caption">

          When the folder was moved, the <code>cd</code> inside the
          substitution failed — and <code>&#36;(…)</code> came back
          <em>empty</em>. Not unset: empty. <code>"$STEAMROOT/"*</code>
          became <code>/*</code>, and the last line deleted everything
          users owned,
          <a href="https://github.com/ValveSoftware/steam-for-linux/issues/3671">mounted
          backup drives included</a>.
        </p>
      </div>
      <div class="hero-cell">
        <p class="hero-label">The same shape, in weir:</p>
        <Code code={spliceWeir} lang={weirGrammar} themes={queilThemes} defaultColor={false} />
        <pre class="refusal">{spliceRefusal}</pre>
      </div>
    </div>
  </div>
  <p>
    weir removes both ingredients, separately. A spliced value is
    always exactly one argv word — splitting is not a thing that can
    happen, quoted or not. And gluing is not either:
    <code>$steamroot/*</code> is refused at check time,
    unconditionally — the pieces would be separate arguments, so the
    shape is unrepresentable; building that word takes a deliberate
    <code>$"&#123;steamroot&#125;/*"</code>. The root itself is the
    second layer: <code>Self.scriptPath</code> is an absolute path by
    construction, and taking its directory cannot fail — there is no
    <code>cd</code>-and-echo substitution to quietly come back empty. Neither failure is a
    mistake weir detects; both are sentences weir cannot say.
  </p>

  <h2>See what a script can do before you run it</h2>
  <p>
    Command names are literal and nothing expands inside argv, so the
    set of things a script can reach is statically knowable — and
    <code>weir check --can</code> reports it, with a source line for
    every claim:
  </p>
  <pre class="report">{canReport}</pre>

  <h2>Why not the alternatives</h2>
  <p class="hero-caption">In the author's words.</p>
  <p>
    <strong>PowerShell</strong> was fine for small scripts. At tool
    scale it got hard to maintain — the quirks compound, and it is not
    typed where it counts.
  </p>
  <p>
    <strong>F# scripts</strong> had the types — weir is F#-shaped
    because F# scripting was the closest thing that worked. What did
    not work: compilation times, caching that is hard to get right,
    wrappers to make scripting fit the task, CLR bloat in the
    language, a runtime dependency — and I needed the
    <em>scripts</em> to behave identically in Linux CI and on
    macOS/Windows dev machines, not just the platform to exist there.
  </p>
  <p>
    <strong>Nushell</strong> is nice, but not strongly typed enough —
    the type system is still being worked out, and it did not meet the
    predictability bar.
  </p>

  <h2>Provenance</h2>
  <p>
    weir was written almost entirely by an AI agent, directed by one
    person through plans, reviews and rulings — about two months, part
    time. That is a statement about economics, not capability: a
    language like this was always possible, and never affordable —
    three or four years of a non-specialist's evenings, or two months.
    The design risk was compressed the same way: weir does not invent
    a language. It selects from F#, which works, and adds the
    shell-specific parts.
  </p>
  <p>What makes that checkable rather than a claim:</p>
  <ul>
    <li>every fenced example in the docs executes in CI, and
      error-demonstrating blocks must <em>fail</em></li>
    <li>every shipped module member is asserted present in the rule
      file — the docs' completeness is a checked property, not a
      hope</li>
    <li>an F# fidelity oracle referees every divergence claim through
      the same checker the runner uses</li>
    <li>the parser's recursion graph is enumerated — a new unguarded
      axis is a CI failure, not a review finding</li>
    <li>an external referee pushes eighty hostile payloads through
      PyYAML and Python's <code>json</code>, because weir refereeing
      its own output missed four defects</li>
    <li>five adversarial reviews, findings and all, in the
      <a href="https://github.com/weir-shell/weir/blob/main/docs/DECISIONS.md">public
      ledger</a></li>
  </ul>
  <p>
    <strong>Don't trust it; check it.</strong> <code>git clone</code>
    and <code>./ci/local.sh</code> run the whole battery. The longer
    story — what broke, what the instruments missed, and what still
    needed a human — is <a href="/docs/method/">The method</a>.
  </p>

  <h2>Learn more</h2>
  <ul>
    <li><a href="/docs/guide/">The guide</a> — start here; every example runs in CI.</li>
    <li><a href="/reference/">The reference</a> — the language and every module.</li>
    <li><a href="/showcase/">The showcase</a> — one script touring the whole language, CI-run.</li>
    <li><a href="/docs/coming-from/">Coming from bash, PowerShell, Python…</a></li>
    <li><a href="/changelog/">Changelog</a></li>
  </ul>
</Base>

<style is:global>
  /* the fold shows the language: intro left, a live refusal right —
     full-bleed like the hero band, stacking on narrow screens. The
     demo's quoted output wraps (class "wrap") instead of scrolling,
     so the whole refusal is visible in the column */
  .hero-grid {
    width: min(72rem, calc(100vw - 2.5rem));
    margin-left: 50%;
    transform: translateX(-50%);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(23rem, 1fr));
    gap: 2rem;
    align-items: start;
  }
  .hero-demo { margin-top: var(--space-4); }
  .hero-demo .astro-code { font-size: 0.85rem; }
  .refusal.wrap { white-space: pre-wrap; overflow-wrap: anywhere; }
  @media (max-width: 46rem) {
    .hero-demo { margin-top: 0; }
  }
  /* the hero's rhythm: headline+rule+category are ONE unit (tight),
     the paragraph another, the install block a third — gaps group */
  h1 { margin: var(--space-3) 0 0; }
  h1::after {
    content: "";
    display: block;
    width: 3.5rem;
    height: 3px;
    background: var(--accent);
    border-radius: 2px;
    margin-top: var(--space-2);
  }
  .what {
    font-size: var(--text-lg);
    font-weight: 600;
    margin: var(--space-2) 0 var(--space-4);
  }
  .sub { font-size: var(--text-base); margin: 0 0 var(--space-4); }
  .install-lines {
    margin: 0 0 var(--space-5);
    padding: var(--space-3);
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .install-line {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .install-more { margin: 0.15rem 0 0; font-size: var(--text-sm); color: var(--muted); }
  /* inside the bounded block the rows drop their own chrome */
  .install-line pre {
    background: transparent;
    border: none;
    padding: 0.2rem 0;
  }
  .install-line .os {
    color: var(--muted);
    font-size: 0.8rem;
    min-width: 6.5rem;
    flex-shrink: 0;
  }
  @media (max-width: 520px) {
    .install-line { flex-wrap: wrap; }
    .install-line .os { flex-basis: 100%; min-width: 0; }
  }
  .install-line pre { margin: 0; flex: 1; min-width: 0; }
  .copy-btn {
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--accent);
    border-radius: 6px;
    padding: 0.45rem 0.55rem;
    cursor: pointer;
    line-height: 0;
  }
  .copy-btn:hover { color: var(--accent); border-color: var(--accent); }
  .copy-btn.copied { color: var(--ok); border-color: var(--ok); }
  .hero-band {
    width: min(72rem, calc(100vw - 2.5rem));
    margin-left: 50%;
    transform: translateX(-50%);
  }
  .hero-pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: 1.25rem;
    align-items: start;
  }
  .hero-cell pre { margin-top: 0.35rem; }
  .hero-label { margin-bottom: 0; color: var(--muted); font-size: 0.9rem; }
  .hero-caption { font-size: 0.9rem; color: var(--muted); }
  .refusal, .report {
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-left: 3px solid var(--danger);
    color: var(--fg);
    font-size: 0.8rem;
    line-height: 1.5;
    padding: 0.7rem 0.9rem;
    border-radius: 6px;
    overflow-x: auto;
  }
  .report { border-left-color: var(--accent); }
</style>

<script>
  // the one script on the page: copy the install line. Progressive —
  // without JS the button does nothing and the text is still selectable.
  for (const btn of document.querySelectorAll(".copy-btn")) {
    btn.addEventListener("click", async () => {
      const el = document.getElementById(btn.dataset.copy);
      await navigator.clipboard.writeText(el.textContent.trim());
      btn.classList.add("copied");
      setTimeout(() => btn.classList.remove("copied"), 1200);
    });
  }
</script>
