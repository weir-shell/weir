---
// The hero [D:hero] [D:hero-3]: the fold leads with a SHORT typed
// boundary that ENDS in a real command — `from json` parses the
// version, `git tag` consumes it (the typed value crosses into argv
// as exactly one word). Beat 1 shows the check at three distances
// [D:hero-3]: a tool's flag (#sig), a manifest's key (yaml schema=),
// and a program name (PATH) — three mistakes, none of them weir, one
// `weir check` report. Sections are gleam-shaped [D:site-style]:
// short prose BESIDE its example (desktop), stacked on mobile, the
// install lines below the demo on phones (nobody pipes curl|sh
// there). Every quoted output on this page comes from a run of the
// shipped binary and is pinned (unit byte-pin for the splice
// refusal; the e2e hero-currency cell for everything quoted) —
// never the docs gate, which asserts executability, not output.
import Base from "../layouts/Base.astro";
import queilThemes from "../lib/queil-weir.mjs";
import { Code } from "astro:components";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";

// process.cwd() (the site dir), not import.meta.url — Astro 7 bundles
// page frontmatter into prerender chunks, so import.meta.url no longer
// anchors the source file (showcase/reference already read this way)
const weirGrammar = JSON.parse(
  readFileSync(resolve(process.cwd(), "../editors/vscode/syntaxes/weir.tmLanguage.json"), "utf8"),
);

const heroWeir = `type Pkg = { name: string; version: string }

let pkg = File.read "package.json" |> from json Pkg
git tag $"v{pkg.version}"`;

const beat1Weir = `#sig bicep

bicep build --outfil main.json

let config = yaml schema=k8s-configmap
    apiVerison: v1
    kind: ConfigMap
    metadata:
        name: site-config
    data:
        template: main.json

config |> to yaml |> File.write "config.yaml"
rsnyc -av main.json config.yaml backup:/srv/site`;

// verbatim from \`weir check deploy.weir\` — e2e-pinned
const beat1Check = `deploy.weir:3:13: error [sig]: unknown flag '--outfil' for bicep. Did you mean '--outfile'? (#sig bicep, line 1; exhaustive signature)
deploy.weir:6:5: error [schema]: schema k8s-configmap: unknown field 'apiVerison' — did you mean 'apiVersion'?
deploy.weir:14:1: warning [cmd-not-found]: command not found on PATH: rsnyc — weir resolves commands at check time; the script runs once it is installed`;

const beat2Weir = `type Cli = {
    /// print what would happen, deploy nothing
    dryRun: bool

    /// the environment to deploy to
    target: string

    /// wait this long for the health check
    timeout: Option<Duration>
}

let cli = Args.load Cli`;

// verbatim from \`weir ship.weir --help\` (v0.0.22) — e2e-pinned
const beat2Help = `usage: ship.weir [flags]
  -d, --dry-run               print what would happen, deploy nothing
      --target <string>       required — the environment to deploy to
      --timeout <duration>    optional — wait this long for the health check`;

const spliceWeir = `let steamroot = Self.scriptPath |> Path.dir
rm -rf $steamroot/*`;

// verbatim from \`weir check\` — byte-pinned in Tests.fs + e2e
const spliceRefusal = `steam.weir:2:18: error [parse]: argv words do not concatenate — adjacent pieces would each become their OWN
argument (\`$root/*\` would pass \`/*\` separately; \`--flag="v"\` would pass
\`--flag=\` separately). Build one word with an interpolated arg (\`$"{root}/*"\`,
\`$"--flag={v}"\`), quote the whole word, or use \`Path.under dir name\` for a
filesystem path (it refuses a result that escapes dir, where \`Path.combine\`
would follow it)`;

const steamBash = `# figure out the absolute path to the script being run
STEAMROOT="$(cd "\${0%/*}" && echo $PWD)"

# Scary!
rm -rf "$STEAMROOT/"*`;

// verbatim from \`weir check --can tools/fuzz.weir\` — e2e-pinned
const canReport = `tools/fuzz.weir can (capability, not behaviour — an untaken branch still counts):
  ambient reads (inform, change nothing):
    reads:
      File.read (path not statically known)  tools/fuzz.weir:59:20
    environment:
      reads WEIR_FUZZ_STRICT_SPANS (Env.get)  tools/fuzz.weir:43:14
  mutations:
    runs:
      git  tools/fuzz.weir:23:12
      ci/deep-lock.sh × 2  tools/fuzz.weir:31:1, 66:5
      date  tools/fuzz.weir:39:17
      dotnet  tools/fuzz.weir:53:9
    writes:
      within tmp (a temporary directory)  tools/fuzz.weir:47:1
    environment:
      sets WEIR_FUZZ_SEED, WEIR_FUZZ_COUNT, WEIR_FUZZ_REPORT for children (within env)  tools/fuzz.weir:52:5
    terminates:
      fail  tools/fuzz.weir:62:9`;
---

<Base search={false}>
  <div class="hero-grid">
    <div class="hero-intro">
      <svg class="mark-lg" viewBox="18 32 92 62" width="76" height="51" aria-hidden="true">
        <rect class="b1" x="20" y="34" width="56" height="12" rx="6" />
        <rect class="b2" x="36" y="57" width="56" height="12" rx="6" />
        <rect class="b3" x="52" y="80" width="56" height="12" rx="6" />
      </svg>
      <h1>For scripts that became tools.</h1>
      <p class="what">
        weir is a typed shell-scripting language: the whole file is
        checked before anything runs.
      </p>
    </div>
    <div class="hero-demo">
      <Code code={heroWeir} lang={weirGrammar} themes={queilThemes} defaultColor={false} />
    </div>
    <div class="hero-install">
      <div class="install-line">
        <pre><code id="install-cmd">curl -fsSL https://weir.sh/install.sh | sh</code></pre>
        <button class="copy-btn" data-copy="install-cmd" aria-label="Copy install command" title="Copy">
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="5" y="5" width="9" height="9" rx="1.5"/><path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5"/></svg>
        </button>
      </div>
      <p class="hero-links">
        <a href="/docs/install/">Windows and other options</a>
        <a href="/docs/guide/">Read the guide</a>
      </p>
    </div>

  </div>

  <section class="feature">
    <div class="feature-prose">
      <h2>The check reaches past your code</h2>
      <p>
        Three mistakes here, and none of them is weir syntax: a
        misspelled <code>bicep</code> flag, a typo in a Kubernetes
        key, and a command that isn't installed. The flag is checked
        against a generated signature (<code>weir add sig bicep</code>),
        the key against a vendored schema (<code>weir add schema</code>),
        the command against your PATH. One report, each finding on
        its line, and nothing ran.
      </p>
      <p class="fine">
        Nothing on this page is a mock-up. Every quoted output comes
        from running the shipped binary, and CI checks it still does.
      </p>
    </div>
    <div class="feature-demo">
      <Code code={beat1Weir} lang={weirGrammar} themes={queilThemes} defaultColor={false} />
      <figure class="term">
        <figcaption>$ weir check deploy.weir</figcaption>
        <pre class="refusal wrap">{beat1Check}</pre>
      </figure>
    </div>
  </section>

  <section class="feature">
    <div class="feature-prose">
      <h2>A real CLI, for free</h2>
      <p>
        Declare a record and the flags follow. The <code>///</code>
        comments become the help text, so <code>--help</code> can't
        drift from the code. Unknown flags, missing values and bad
        values are reported together, in one message, before the
        script does anything.
      </p>
    </div>
    <div class="feature-demo">
      <Code code={beat2Weir} lang={weirGrammar} themes={queilThemes} defaultColor={false} />
      <figure class="term">
        <figcaption>$ weir ship.weir --help</figcaption>
        <pre class="report">{beat2Help}</pre>
      </figure>
    </div>
  </section>

  <h2>Two bash habits, gone</h2>
  <p>
    Two shell mechanisms keep wrecking machines. One is an unquoted
    variable <em>splitting</em> into words; it is still being quoted
    away by hand, as pgpool did to an <code>rm -rf</code> in
    <a href="https://github.com/pgpool/pgpool2/commit/58446a6">September
    2025</a>, caught in review. The other is a path <em>glued</em>
    from pieces that came apart. Valve shipped that in 2015, and it
    wiped real drives:
  </p>
  <div class="hero-band">
    <div class="hero-pair">
      <div class="hero-cell">
        <p class="hero-label">steam.sh, shipped:</p>
        <Code code={steamBash} lang="bash" themes={queilThemes} defaultColor={false} />
        <p class="hero-caption">
          When the folder moved, <code>&#36;(…)</code> came back
          <em>empty</em>, <code>"$STEAMROOT/"*</code> became
          <code>/*</code>, and the last line deleted everything the
          user owned, <a href="https://github.com/ValveSoftware/steam-for-linux/issues/3671">mounted
          backup drives included</a>.
        </p>
      </div>
      <div class="hero-cell">
        <p class="hero-label">The same shape, in weir:</p>
        <Code code={spliceWeir} lang={weirGrammar} themes={queilThemes} defaultColor={false} />
        <figure class="term">
          <figcaption>$ weir check steam.weir</figcaption>
          <pre class="refusal">{spliceRefusal}</pre>
        </figure>
      </div>
    </div>
  </div>
  <p>
    weir removes both: a spliced value is always exactly one argument,
    and gluing pieces into one word is not something you can write.
    These aren't mistakes weir catches. They are sentences it cannot
    say.
  </p>

  <section class="feature">
    <div class="feature-prose">
      <h2>See what a script can do before you run it</h2>
      <p>
        Command names are literal and nothing expands inside argv, so
        a script's reach can be read off the source. Useful for your
        own scripts; more useful for someone else's.
        <code>weir check --can</code> lists it, with a line number for
        every claim.
      </p>
    </div>
    <div class="feature-demo">
      <figure class="term">
        <figcaption>$ weir check --can tools/fuzz.weir</figcaption>
        <pre class="report">{canReport}</pre>
      </figure>
    </div>
  </section>

  <h2>Also in the box</h2>
  <ul class="falls-out">
    <li>
      <a href="/docs/guide/#scoped-resources-within-and-always"><code>within proc</code></a> —
      a background process gets a scope instead of an <code>&amp;</code>;
      the whole tree is killed and reaped however the scope ends.
    </li>
    <li>
      <a href="/docs/guide/#secrets-tokens-that-cannot-leak-into-logs"><code>Secret</code></a> —
      a token that cannot reach a log line, a shown record, or the
      wire. <code>Secret.reveal</code> is the only way out, so auditing
      is grepping for it.
    </li>
    <li>
      <a href="/docs/guide/#retrying-and-polling"><code>retry</code> and <code>poll</code></a> —
      bounded loops; <code>repeat</code> is the one that runs until
      stopped, and finishes its iteration on Ctrl+C.
      <code>watch=</code> fails a wait the moment the child dies, with
      its last output.
    </li>
    <li>
      <a href="/docs/guide/#exit-codes-from-command-to-value">exit codes as data</a> —
      <code>| complete</code> and <code>| succeeds</code> turn a
      command's outcome into a value, and <code>Seq.exactlyOne</code>
      means <em>one line</em> where <code>head -1</code> would quietly
      take the first of two.
    </li>
    <li>
      <a href="/docs/guide/#scoped-resources-within-and-always"><code>within lock</code></a> —
      an advisory file lock the kernel releases on any death,
      <code>kill -9</code> included.
    </li>
    <li>
      <a href="/docs/tooling/#yaml-schemas">the <code>yaml</code> block</a> —
      splices are nodes, never text, so YAML injection can't be
      written. The same rule as argv, one format over.
    </li>
  </ul>

  <h2>Why another one</h2>
  <p>
    I wanted a fast, typed, functional, cross-platform scripting
    language for devops and daily tasks, and kept not finding it.
    <strong>bash</strong> has no types: a misspelled command, an unset
    variable, a value that splits in two all wait until the shell
    reaches that line, mid-run. <strong>PowerShell</strong> is typed
    where it's convenient and not where it counts, and its quirks
    compound as scripts grow. <strong>F# scripts</strong> had the
    types and the ergonomics I liked (weir's syntax comes from there),
    but not the start-up time, and not the same behaviour on a Linux
    CI runner and a Windows laptop. <strong>Nushell</strong> is nice,
    but its type system is still settling. weir keeps the parts of F#
    that work for scripting, drops the rest, and adds the shell.
    <a href="https://queil.net/2026/10/weir/">The longer version</a>.
  </p>

  <h2>Learn more</h2>
  <ul>
    <li><a href="/docs/guide/">The guide</a> — start here; every example runs in CI.</li>
    <li><a href="/reference/">The reference</a> — the language and every module.</li>
    <li><a href="/showcase/">The showcase</a> — one script touring the whole language, CI-run.</li>
    <li><a href="/docs/coming-from/">Coming from bash, PowerShell, Python…</a></li>
    <li><a href="/docs/method/">How it was built</a> — and how to check it yourself: <code>git clone</code>, then <code>./ci/local.sh</code>.</li>
    <li><a href="/changelog/">Changelog</a></li>
  </ul>
</Base>

<style is:global>
  /* the hero's rhythm [D:hero-min]: headline+rule, the one sentence,
     the snippet, the install line — nothing else above the fold */
  h1 {
    margin: var(--space-3) 0 0;
    font-size: clamp(2.1rem, 4.5vw, 2.6rem);
    letter-spacing: -0.015em;
  }
  h1::after {
    content: "";
    display: block;
    width: 4.5rem;
    height: 3px;
    background: linear-gradient(90deg, var(--b1) 0 34%, var(--b2) 34% 67%, var(--b3) 67% 100%);
    border-radius: 2px;
    margin-top: var(--space-2);
  }
  .mark-lg { display: block; margin-bottom: var(--space-2); }
  .what {
    font-size: var(--text-lg);
    margin: var(--space-2) 0 var(--space-4);
    max-width: 68ch;
  }
  .install-line {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .install-line pre { margin: 0; flex: 1; min-width: 0; }
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-2) 0 var(--space-5);
    font-size: var(--text-sm);
  }
  .copy-btn {
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--accent);
    border-radius: 6px;
    padding: 0.45rem 0.55rem;
    cursor: pointer;
    line-height: 0;
  }
  .copy-btn:hover { color: var(--accent); border-color: var(--accent); }
  .copy-btn.copied { color: var(--ok); border-color: var(--ok); }
  /* the fold is a single stacked column [D:hero-2]: intro, then the
     code demo, then the install lines — top to bottom, a little wider
     than the reading measure so the larger code fits (no full-bleed,
     no side-by-side); the feature sections below still go two-up */
  .hero-grid {
    width: min(52rem, calc(100vw - 2.5rem));
    margin-left: 50%;
    transform: translateX(-50%);
    padding: var(--space-3) 0 var(--space-3);
  }
  .hero-demo { margin: var(--space-4) 0; }
  .hero-demo .astro-code { font-size: var(--text-code); }
  .refusal.wrap { white-space: pre-wrap; overflow-wrap: anywhere; }
  /* feature sections [D:hero-2]: short prose BESIDE its example —
     the gleam shape; stacked on narrow screens */
  .feature {
    width: min(72rem, calc(100vw - 2.5rem));
    margin-left: 50%;
    transform: translateX(-50%);
    display: grid;
    gap: 0 4rem;
    margin-top: var(--space-5);
    align-items: start;
    grid-template-columns: 1fr;
  }
  @media (min-width: 50rem) {
    .feature { grid-template-columns: minmax(0, 24rem) 1fr; }
  }
  .feature .fine { font-size: var(--text-sm); color: var(--muted); }
  /* min-width: 0 lets a wide code line SCROLL (pre's overflow-x) instead
     of expanding the grid track past the viewport — a grid child
     defaults to min-width: auto, which clipped snippets on phones */
  .feature-demo { margin-top: var(--space-3); min-width: 0; }
  .feature-prose { min-width: 0; }
  .feature-prose h2 { margin-top: var(--space-4); }
  .feature-demo .astro-code { font-size: var(--text-code); }
  .hero-band {
    width: min(72rem, calc(100vw - 2.5rem));
    margin-left: 50%;
    transform: translateX(-50%);
  }
  .hero-pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: 1.25rem;
    align-items: start;
  }
  .hero-cell pre { margin-top: 0.35rem; }
  .hero-label { margin-bottom: 0; color: var(--muted); font-size: 0.9rem; }
  .hero-caption { font-size: 0.9rem; color: var(--muted); }
  .falls-out li { margin-bottom: 0.55rem; }
  /* terminal chrome [D:site-style]: the caption is the COMMAND that
     produced the quoted output — provenance made visible, never
     decoration (the outputs stay e2e-pinned bytes) */
  .term {
    margin: var(--space-3) 0;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }
  .term figcaption {
    font: 0.78rem/1 "Iosevka Term Ext", ui-monospace, monospace;
    color: var(--muted);
    background: var(--code-bg);
    padding: 0.55rem 0.9rem;
    border-bottom: 1px solid var(--border);
  }
  .term pre {
    margin: 0;
    border: none;
    border-radius: 0;
  }
  .term .refusal { border-left: 3px solid var(--danger); }
  .term .report { border-left: 3px solid var(--accent); }
  .refusal, .report {
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-left: 3px solid var(--danger);
    color: var(--fg);
    font-size: var(--text-sm);
    line-height: 1.5;
    padding: 0.7rem 0.9rem;
    border-radius: 6px;
    overflow-x: auto;
  }
  .report { border-left-color: var(--accent); }
</style>

<script>
  // the one script on the page: copy the install line. Progressive —
  // without JS the button does nothing and the text is still selectable.
  for (const btn of document.querySelectorAll(".copy-btn")) {
    btn.addEventListener("click", async () => {
      const el = document.getElementById(btn.dataset.copy);
      await navigator.clipboard.writeText(el.textContent.trim());
      btn.classList.add("copied");
      setTimeout(() => btn.classList.remove("copied"), 1200);
    });
  }
</script>
