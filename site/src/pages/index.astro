---
// The hero [D:hero] [D:hero-2]: the fold leads with the user's REAL
// PR check — kustomize build piped into kubeconform, then the same
// captured stream read as a tagged union for policy. It gates, it
// does not deploy: flux/argocd own apply, so the script sits WITH
// GitOps, not against it (kubeclt apply was the anti-pattern; the
// typo beat is rsnyc — the backup script is timeless glue). The
// force-once-consume-twice law is on display on purpose. Sections are gleam-shaped [D:site-style]:
// short prose BESIDE its example (desktop), stacked on mobile, the
// install lines below the demo on phones (nobody pipes curl|sh
// there). Every quoted output on this page comes from a run of the
// shipped binary and is pinned (unit byte-pin for the splice
// refusal; the e2e hero-currency cell for everything quoted) —
// never the docs gate, which asserts executability, not output.
import Base from "../layouts/Base.astro";
import queilThemes from "../lib/queil-weir.mjs";
import { Code } from "astro:components";
import { readFileSync } from "node:fs";

const weirGrammar = JSON.parse(
  readFileSync(
    new URL("../../../editors/vscode/syntaxes/weir.tmLanguage.json", import.meta.url),
    "utf8",
  ),
);

const heroWeir = `type Spec = { replicas: int }
type Workload = { spec: Spec }

[<Tag "kind">]
type K8s =
    | Deployment of Workload
    | [<Other>] Unchecked of string

let manifests = kustomize build overlays/prod |> Seq.force

manifests | kubeconform -strict

for doc in manifests |> from yaml stream K8s do
    match doc with
    | Deployment d when d.spec.replicas < 2 -> fail "single-replica Deployment"
    | Deployment d -> print $"ok: {d.spec.replicas} replicas"
    | Unchecked kind -> print $"schema-only: {kind}"`;

// verbatim from running the check over a three-document build
// (Deployment, Service, CronJob) — e2e-pinned against stub tools
const heroOut = `ok: 3 replicas
schema-only: Service
schema-only: CronJob`;

const beat1Weir = `type Cli = {
    /// print what would happen, upload nothing
    dryRun: bool
}

let cli = Args.load Cli
tar czf bundle.tar.gz dist/
if not cli.dryRun then rsnyc -av bundle.tar.gz backup:/srv/dist`;

// verbatim from running the script above — e2e-pinned
const beat1Refusal = `release.weir:8:24: parse error:
if not cli.dryRun then rsnyc -av bundle.tar.gz backup:/srv/dist
                       ^
unknown command 'rsnyc' — not found on PATH. weir resolves command names before running: install the tool, or run it through sh -c`;

const beat2Weir = `type Cli = {
    /// print what would happen, deploy nothing
    dryRun: bool

    /// the environment to deploy to
    target: string

    /// wait this long for the health check
    timeout: Option<Duration>
}

let cli = Args.load Cli`;

// verbatim from \`weir deploy.weir --help\` (v0.0.3) — e2e-pinned
const beat2Help = `usage: [flags]
  -d, --dry-run               print what would happen, deploy nothing
      --target <string>       required — the environment to deploy to
      --timeout               optional — wait this long for the health check`;

const spliceWeir = `let steamroot = Self.scriptPath |> Path.dir
rm -rf $steamroot/*`;

// verbatim from \`weir check\` — byte-pinned in Tests.fs + e2e
const spliceRefusal = `steam.weir:2:18: error [parse]: argv words do not concatenate — adjacent pieces would each become their OWN
argument (\`$root/*\` would pass \`/*\` separately; \`--flag="v"\` would pass
\`--flag=\` separately). Build one word with an interpolated arg (\`$"{root}/*"\`,
\`$"--flag={v}"\`), quote the whole word, or use \`Path.under dir name\` for a
filesystem path (it refuses a result that escapes dir, where \`Path.combine\`
would follow it)`;

const steamBash = `# figure out the absolute path to the script being run
STEAMROOT="$(cd "\${0%/*}" && echo $PWD)"

# Scary!
rm -rf "$STEAMROOT/"*`;

// verbatim from \`weir check --can tools/fuzz.weir\` (v0.0.8) — e2e-pinned
const canReport = `tools/fuzz.weir can (capability, not behaviour — an untaken branch still counts):
  runs:
    git  tools/fuzz.weir:23:12
    ci/deep-lock.sh × 2  tools/fuzz.weir:31:41 tools/fuzz.weir:72:5
    date  tools/fuzz.weir:39:15
    dotnet  tools/fuzz.weir:59:56
  reads:
    File.read (path not statically known)  tools/fuzz.weir:65:20
  writes:
    within tmp (a temporary directory)  tools/fuzz.weir:47:1
  environment:
    reads WEIR_FUZZ_STRICT_SPANS (Env.get)  tools/fuzz.weir:43:14
    sets WEIR_FUZZ_SEED, WEIR_FUZZ_COUNT, WEIR_FUZZ_REPORT for children (within env)  tools/fuzz.weir:54:49
  terminates:
    fail  tools/fuzz.weir:68:9`;
---

<Base>
  <div class="hero-grid">
    <div class="hero-intro">
      <svg class="mark-lg" viewBox="18 32 92 62" width="76" height="51" aria-hidden="true">
        <rect class="b1" x="20" y="34" width="56" height="12" rx="6" />
        <rect class="b2" x="36" y="57" width="56" height="12" rx="6" />
        <rect class="b3" x="52" y="80" width="56" height="12" rx="6" />
      </svg>
      <h1>For scripts that became tools.</h1>
      <p class="what">weir is a typed shell-scripting language.</p>
      <p class="sub">
        Commands, pipes and files, like bash — checked whole before
        anything runs. One static binary, identical on Linux, macOS
        and Windows.
      </p>
    </div>
    <div class="hero-install">
      <div class="install-lines">
        <div class="install-line">
          <span class="os">Linux · macOS</span>
          <pre><code id="install-cmd">curl -fsSL https://weir.sh/install.sh | sh</code></pre>
          <button class="copy-btn" data-copy="install-cmd" aria-label="Copy install command" title="Copy">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="5" y="5" width="9" height="9" rx="1.5"/><path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5"/></svg>
          </button>
        </div>
        <div class="install-line">
          <span class="os">Windows</span>
          <pre><code id="install-cmd-win">irm https://weir.sh/install.ps1 | iex</code></pre>
          <button class="copy-btn" data-copy="install-cmd-win" aria-label="Copy Windows install command" title="Copy">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="5" y="5" width="9" height="9" rx="1.5"/><path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5"/></svg>
          </button>
        </div>
        <p class="install-more">
          <a href="/docs/install/">More install options</a> — Docker,
          checksums, air-gapped.
        </p>
      </div>
    </div>
    <div class="hero-demo">
      <Code code={heroWeir} lang={weirGrammar} themes={queilThemes} defaultColor={false} />
      <figure class="term">
        <figcaption>$ weir pr-check.weir</figcaption>
        <pre class="report">{heroOut}</pre>
      </figure>
      <p class="hero-caption">
        A real PR check: kustomize's stream is captured once and used
        twice — piped into kubeconform for schema validity, then read
        as a tagged union for the policy the schema cannot state. A
        breach fails the merge; flux applies what passed.
      </p>
    </div>
  </div>

  <section class="feature">
    <div class="feature-prose">
      <h2>The check is the test</h2>
      <p>
        Every command resolves — your PATH included — and every type
        checks before the first effect runs. One misspelled word and
        the whole script refuses: <code>tar</code> never created a
        byte.
      </p>
      <p class="fine">
        Nothing on this page is a mock-up — every quoted output comes
        from running the shipped binary, verified in CI.
      </p>
    </div>
    <div class="feature-demo">
      <Code code={beat1Weir} lang={weirGrammar} themes={queilThemes} defaultColor={false} />
      <figure class="term">
        <figcaption>$ weir release.weir</figcaption>
        <pre class="refusal wrap">{beat1Refusal}</pre>
      </figure>
    </div>
  </section>

  <section class="feature">
    <div class="feature-prose">
      <h2>A real CLI, free</h2>
      <p>
        Declare the shape; the interface is derived. The
        <code>///</code> docs become the help text, so you cannot
        forget to update <code>--help</code> — and unknown flags,
        missing requireds and bad values arrive together, in one
        error, before any effect.
      </p>
    </div>
    <div class="feature-demo">
      <Code code={beat2Weir} lang={weirGrammar} themes={queilThemes} defaultColor={false} />
      <figure class="term">
        <figcaption>$ weir deploy.weir --help</figcaption>
        <pre class="report">{beat2Help}</pre>
      </figure>
    </div>
  </section>

  <h2>Predictable, illustrated</h2>
  <p>
    Two bash mechanisms have deleted real machines: an unquoted
    variable <em>splitting</em> into words, and a path <em>glued</em>
    from pieces that came apart. Valve shipped the second in 2015:
  </p>
  <div class="hero-band">
    <div class="hero-pair">
      <div class="hero-cell">
        <p class="hero-label">steam.sh, shipped:</p>
        <Code code={steamBash} lang="bash" themes={queilThemes} defaultColor={false} />
        <p class="hero-caption">
          When the folder moved, <code>&#36;(…)</code> came back
          <em>empty</em> — <code>"$STEAMROOT/"*</code> became
          <code>/*</code>, and the last line deleted everything users
          owned, <a href="https://github.com/ValveSoftware/steam-for-linux/issues/3671">mounted
          backup drives included</a>.
        </p>
      </div>
      <div class="hero-cell">
        <p class="hero-label">The same shape, in weir:</p>
        <Code code={spliceWeir} lang={weirGrammar} themes={queilThemes} defaultColor={false} />
        <figure class="term">
          <figcaption>$ weir check steam.weir</figcaption>
          <pre class="refusal">{spliceRefusal}</pre>
        </figure>
      </div>
    </div>
  </div>
  <p>
    Weir removes both ingredients: a spliced value is always exactly
    one argv word, and gluing is unrepresentable — neither failure is
    a mistake weir detects, both are sentences weir cannot say.
  </p>

  <section class="feature">
    <div class="feature-prose">
      <h2>See what a script can do before you run it</h2>
      <p>
        Command names are literal and nothing expands inside argv, so
        a script's reach is statically knowable —
        <code>weir check --can</code> reports it, with a source line
        for every claim.
      </p>
    </div>
    <div class="feature-demo">
      <figure class="term">
        <figcaption>$ weir check --can tools/fuzz.weir</figcaption>
        <pre class="report">{canReport}</pre>
      </figure>
    </div>
  </section>

  <h2>Why not the alternatives</h2>
  <p>
    In the author's words: <strong>PowerShell</strong> compounds its
    quirks at tool scale and is not typed where it counts.
    <strong>F# scripts</strong> had the types — weir is F#-shaped
    because they were closest — but not the start-up time, the
    caching, or identical behaviour across Linux CI and macOS/Windows
    dev machines. <strong>Nushell</strong> is nice, but its type
    system is still being worked out. Weir selects from F#, which
    works, and adds the shell-specific parts.
  </p>

  <h2>Provenance</h2>
  <p>
    weir was written almost entirely by an AI agent, directed by one
    person through plans, reviews and rulings — about two months,
    part time. That is a statement about economics, not capability.
    What makes it checkable rather than a claim: every fenced example
    in the docs executes in CI (error demos must <em>fail</em>); an
    F# fidelity oracle referees every divergence claim; an external
    referee pushes eighty hostile payloads through PyYAML and
    Python's <code>json</code>; and five adversarial reviews sit,
    findings and all, in the
    <a href="https://github.com/weir-shell/weir/blob/main/docs/DECISIONS.md">public ledger</a>.
  </p>
  <p>
    <strong>Don't trust it; check it.</strong> <code>git clone</code>
    and <code>./ci/local.sh</code> run the whole battery. The longer
    story is <a href="/docs/method/">The method</a>.
  </p>

  <h2>Learn more</h2>
  <ul>
    <li><a href="/docs/guide/">The guide</a> — start here; every example runs in CI.</li>
    <li><a href="/reference/">The reference</a> — the language and every module.</li>
    <li><a href="/showcase/">The showcase</a> — one script touring the whole language, CI-run.</li>
    <li><a href="/docs/coming-from/">Coming from bash, PowerShell, Python…</a></li>
    <li><a href="/changelog/">Changelog</a></li>
  </ul>
</Base>

<style is:global>
  /* the hero's rhythm: headline+rule+category are ONE unit (tight),
     the paragraph another, the install block a third — gaps group */
  h1 {
    margin: var(--space-3) 0 0;
    font-size: clamp(2.1rem, 4.5vw, 2.6rem);
    letter-spacing: -0.015em;
  }
  h1::after {
    content: "";
    display: block;
    width: 4.5rem;
    height: 3px;
    background: linear-gradient(90deg, var(--b1) 0 34%, var(--b2) 34% 67%, var(--b3) 67% 100%);
    border-radius: 2px;
    margin-top: var(--space-2);
  }
  .mark-lg { display: block; margin-bottom: var(--space-2); }
  .what {
    font-size: var(--text-lg);
    font-weight: 600;
    margin: var(--space-2) 0 var(--space-4);
  }
  .sub { font-size: var(--text-base); margin: 0 0 var(--space-4); }
  .install-lines {
    margin: 0 0 var(--space-5);
    padding: var(--space-3);
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .install-line {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .install-more { margin: 0.15rem 0 0; font-size: var(--text-sm); color: var(--muted); }
  /* inside the bounded block the rows drop their own chrome */
  .install-line pre {
    background: transparent;
    border: none;
    padding: 0.2rem 0;
  }
  .install-line .os {
    color: var(--muted);
    font-size: 0.8rem;
    min-width: 6.5rem;
    flex-shrink: 0;
  }
  @media (max-width: 520px) {
    .install-line { flex-wrap: wrap; }
    .install-line .os { flex-basis: 100%; min-width: 0; }
  }
  .install-line pre { margin: 0; flex: 1; min-width: 0; }
  .copy-btn {
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--accent);
    border-radius: 6px;
    padding: 0.45rem 0.55rem;
    cursor: pointer;
    line-height: 0;
  }
  .copy-btn:hover { color: var(--accent); border-color: var(--accent); }
  .copy-btn.copied { color: var(--ok); border-color: var(--ok); }
  .hero-grid {
    width: min(72rem, calc(100vw - 2.5rem));
    margin-left: 50%;
    transform: translateX(-50%);
    display: grid;
    gap: 0 2.5rem;
    align-items: start;
    /* mobile: the language before the install lines — nobody pipes
       curl|sh on a phone, so the demo earns the fold there */
    grid-template-areas: "intro" "demo" "install";
  }
  .hero-intro { grid-area: intro; }
  .hero-demo { grid-area: demo; }
  .hero-install { grid-area: install; }
  @media (min-width: 50rem) {
    .hero-grid {
      grid-template-areas: "intro demo" "install demo";
      grid-template-columns: 1fr 1.15fr;
      grid-template-rows: auto 1fr;
    }
    .hero-demo { margin-top: var(--space-4); }
  }
  .hero-demo .astro-code { font-size: 0.85rem; }
  .refusal.wrap { white-space: pre-wrap; overflow-wrap: anywhere; }
  /* feature sections [D:hero-2]: short prose BESIDE its example —
     the gleam shape; stacked on narrow screens */
  .feature {
    width: min(72rem, calc(100vw - 2.5rem));
    margin-left: 50%;
    transform: translateX(-50%);
    display: grid;
    gap: 0 2.5rem;
    align-items: start;
    grid-template-columns: 1fr;
  }
  @media (min-width: 50rem) {
    .feature { grid-template-columns: minmax(0, 24rem) 1fr; }
  }
  .feature .fine { font-size: var(--text-sm); color: var(--muted); }
  .feature-demo { margin-top: var(--space-3); }
  .feature-demo .astro-code { font-size: 0.85rem; }
  .hero-band {
    width: min(72rem, calc(100vw - 2.5rem));
    margin-left: 50%;
    transform: translateX(-50%);
  }
  .hero-pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: 1.25rem;
    align-items: start;
  }
  .hero-cell pre { margin-top: 0.35rem; }
  .hero-label { margin-bottom: 0; color: var(--muted); font-size: 0.9rem; }
  .hero-caption { font-size: 0.9rem; color: var(--muted); }
  /* terminal chrome [D:site-style]: the caption is the COMMAND that
     produced the quoted output — provenance made visible, never
     decoration (the outputs stay e2e-pinned bytes) */
  .term {
    margin: var(--space-3) 0;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }
  .term figcaption {
    font: 0.78rem/1 "Iosevka Term Ext", ui-monospace, monospace;
    color: var(--muted);
    background: var(--code-bg);
    padding: 0.55rem 0.9rem;
    border-bottom: 1px solid var(--border);
  }
  .term pre {
    margin: 0;
    border: none;
    border-radius: 0;
  }
  .term .refusal { border-left: 3px solid var(--danger); }
  .term .report { border-left: 3px solid var(--accent); }
  .refusal, .report {
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-left: 3px solid var(--danger);
    color: var(--fg);
    font-size: 0.8rem;
    line-height: 1.5;
    padding: 0.7rem 0.9rem;
    border-radius: 6px;
    overflow-x: auto;
  }
  .report { border-left-color: var(--accent); }
</style>

<script>
  // the one script on the page: copy the install line. Progressive —
  // without JS the button does nothing and the text is still selectable.
  for (const btn of document.querySelectorAll(".copy-btn")) {
    btn.addEventListener("click", async () => {
      const el = document.getElementById(btn.dataset.copy);
      await navigator.clipboard.writeText(el.textContent.trim());
      btn.classList.add("copied");
      setTimeout(() => btn.classList.remove("copied"), 1200);
    });
  }
</script>
