---
// THE reference is one page [D:reference]: the written language
// sections first (rendered from docs/reference/*.md — their fences run
// in CI), then every generated module entry behind a signature index.
// The side nav carries both halves. Anchors are the reference's API:
// written pages keep their heading slugs, modules keep
// #<module>-<member> — they must not change.
import Base from "../../layouts/Base.astro";
import queilThemes from "../../lib/queil-weir.mjs";
import { Code } from "astro:components";
import { getCollection, render } from "astro:content";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import ref from "../../data/reference.json";

// cwd-anchored (the build runs from site/) — a bundled chunk's
// import.meta.url is not a stable base for repo-relative reads
const weirGrammar = JSON.parse(
  readFileSync(resolve(process.cwd(), "../editors/vscode/syntaxes/weir.tmLanguage.json"), "utf8"),
);

const written = await getCollection("reference");
// reading order, not collection order: lexical first, then the
// statement/command/type/pattern ladder; an unlisted page appends
const pageOrder = [
  "lexical",
  "statements",
  "commands",
  "types",
  "patterns",
  "interpolation",
  "scopes",
  "boundaries",
  "adapters",
  "modules",
  "loops",
  "errors",
];
written.sort(
  (a, b) =>
    (pageOrder.indexOf(a.id) + 1 || 99) - (pageOrder.indexOf(b.id) + 1 || 99),
);
const rendered = [];
for (const entry of written) {
  const { Content, headings } = await render(entry);
  const title = entry.body?.match(/^#\s+(.+)$/m)?.[1] ?? entry.id;
  rendered.push({ id: entry.id, title, Content, headings });
}

const anchor = (group, name) =>
  `${group.toLowerCase()}-${name.toLowerCase().replaceAll(" ", "-")}`;
const groups = [
  ...ref.modules.map((m) => ({ name: m.name, members: m.members })),
  { name: "Forms", members: ref.forms },
];
const memberCount = groups.reduce((n, g) => n + g.members.length, 0);

const toc = [
  ...rendered.flatMap((p) => [
    { depth: 2, slug: p.id, text: p.title },
    ...p.headings.filter((h) => h.depth === 2).map((h) => ({ depth: 3, slug: h.slug, text: h.text })),
  ]),
  { depth: 2, slug: "modules", text: "Modules" },
  ...groups.map((g) => ({ depth: 3, slug: g.name.toLowerCase(), text: g.name })),
];
---

<Base title="Reference" toc={toc}>
  <h1>Reference</h1>
  <p>
    The language, then every module — all {memberCount} entries. Every
    example runs against the release binary in CI, and the module
    entries are the binary's own documentation, the same text
    <code>#help</code> and hover show.
  </p>

  {rendered.map((p) => (
    <section class="written-page" id={p.id}>
      <p.Content />
    </section>
  ))}

  <h2 id="modules">Modules</h2>
  <nav class="sig-index">
    {groups.map((g) => (
      <section>
        <h3><a href={`#${g.name.toLowerCase()}`}>{g.name}</a></h3>
        <ul>
          {g.members.map((m) => (
            <li>
              <a href={`#${anchor(g.name, m.name)}`}><code>{m.signature ?? m.name}</code></a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </nav>

  {groups.map((g) => (
    <section>
      <h3 class="module-head" id={g.name.toLowerCase()}>{g.name}</h3>
      {g.members.map((m) => (
        <section>
          <h4 id={anchor(g.name, m.name)}>
            <a href={`#${anchor(g.name, m.name)}`}>{g.name === "Forms" ? m.name : `${g.name}.${m.name}`}</a>
          </h4>
          {m.signature && <Code code={m.signature} lang={weirGrammar} themes={queilThemes} defaultColor={false} />}
          {m.summary && <p>{m.summary}</p>}
          {m.example && <Code code={m.example} lang={weirGrammar} themes={queilThemes} defaultColor={false} />}
          {m.pointer && <p><em>{m.pointer}</em></p>}
        </section>
      ))}
    </section>
  ))}
</Base>

<style is:global>
  /* an embedded written page's h1 reads as a section heading — and
     its OWN h2/h3 step down a size each, or "Types" and "Scalars"
     render equal (the global h2 is already --text-xl) */
  .written-page h1 {
    font-size: var(--text-xl);
    margin-top: var(--space-5);
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.3rem;
  }
  .written-page h2 {
    font-size: var(--text-lg);
    margin-top: var(--space-4);
    border-bottom: none;
    padding-bottom: 0;
  }
  .written-page h3 {
    font-size: var(--text-base);
  }
  .module-head {
    font-size: var(--text-xl);
    margin-top: var(--space-5);
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.3rem;
  }
  .sig-index ul { list-style: none; padding-left: 0; margin: 0.25rem 0 0; }
  .sig-index li { margin: 0; line-height: 1.5; white-space: nowrap; overflow-x: auto; }
  .sig-index a { text-decoration: none; }
  .sig-index a:hover { text-decoration: underline; }
  .sig-index h3 { font-size: var(--text-lg); margin-top: var(--space-3); }
  .sig-index { margin-bottom: var(--space-5); border-bottom: 1px solid var(--border); padding-bottom: var(--space-4); }
</style>
