---
// The written language pages [D:reference] — lexical, and the sections
// to come. The GENERATED half lives on /reference/all/ (one page, side
// navigation); the per-module pages retired in its favour, their URLs
// redirecting into its anchors.
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const written = await getCollection("reference");
  return written.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const title = entry.body?.match(/^#\s+(.+)$/m)?.[1] ?? entry.id;
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

<Base title={title} toc={toc}>
  <Content />
</Base>
