---
// The one-page modules reference [D:reference]: the same generated
// entries as the per-module pages (option (b) — those remain; links in
// the wild keep working), concatenated behind a signature index so
// Ctrl+F finds a name or a type in the index and prose ("raises",
// "symlink") in the entries. Anchors are the reference's API:
// #<module>-<member>, lowercase, dash-joined — the per-module pages'
// member anchors with the module prefixed, and they must not change.
import Base from "../../layouts/Base.astro";
import nordWeir from "../../lib/nord-weir.mjs";
import { Code } from "astro:components";
import { readFileSync } from "node:fs";
import ref from "../../data/reference.json";

const weirGrammar = JSON.parse(
  readFileSync(
    new URL("../../../../editors/vscode/syntaxes/weir.tmLanguage.json", import.meta.url),
    "utf8",
  ),
);

const anchor = (group, name) =>
  `${group.toLowerCase()}-${name.toLowerCase().replaceAll(" ", "-")}`;

const groups = [
  ...ref.modules.map((m) => ({ name: m.name, members: m.members })),
  { name: "Forms", members: ref.forms },
];
const memberCount = groups.reduce((n, g) => n + g.members.length, 0);
---

<Base title="All modules">
  <h1>The modules, on one page</h1>
  <p>
    All {memberCount} entries — generated from the binary's own
    documentation, the same text <code>#help</code> and hover show.
    The index below links into the full entries; the
    <a href="/reference/">per-module pages</a> carry the same
    content one module at a time.
  </p>

  <nav class="sig-index">
    {groups.map((g) => (
      <section>
        <h2><a href={`#${g.name.toLowerCase()}`}>{g.name}</a></h2>
        <ul>
          {g.members.map((m) => (
            <li>
              <a href={`#${anchor(g.name, m.name)}`}><code>{m.signature ?? m.name}</code></a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </nav>

  {groups.map((g) => (
    <section>
      <h2 id={g.name.toLowerCase()}>{g.name}</h2>
      {g.members.map((m) => (
        <section>
          <h3 id={anchor(g.name, m.name)}>
            <a href={`#${anchor(g.name, m.name)}`}>{g.name === "Forms" ? m.name : `${g.name}.${m.name}`}</a>
          </h3>
          {m.signature && <Code code={m.signature} lang={weirGrammar} theme={nordWeir} />}
          {m.summary && <p>{m.summary}</p>}
          {m.example && <Code code={m.example} lang={weirGrammar} theme={nordWeir} />}
          {m.pointer && <p><em>{m.pointer}</em></p>}
        </section>
      ))}
    </section>
  ))}
</Base>

<style is:global>
  .sig-index ul { list-style: none; padding-left: 0; margin: 0.25rem 0 0; }
  .sig-index li { margin: 0; line-height: 1.5; white-space: nowrap; overflow-x: auto; }
  .sig-index a { text-decoration: none; }
  .sig-index a:hover { text-decoration: underline; }
  .sig-index h2 { font-size: var(--text-lg); margin-top: var(--space-3); border-bottom: none; padding-bottom: 0; }
  .sig-index { margin-bottom: var(--space-5); border-bottom: 1px solid var(--border); padding-bottom: var(--space-4); }
</style>
