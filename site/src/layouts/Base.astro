---
// the skeleton layout [D:site-skeleton]: structure and navigation only —
// the homepage/hero content is its own later work
const { title, toc } = Astro.props;
// the displayed version [D:site-version]: derived from the deploy's
// resolved tag (WEIR_RELEASE_TAG), never hardcoded — absent on local
// builds, so dev pages show no version rather than a wrong one
const releaseTag = process.env.WEIR_RELEASE_TAG || "";
// toc: optional [{ depth, slug, text }] — when present the page gets an
// always-visible (sticky) side navigation; below 1100px it yields to
// the one-column flow
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · weir` : "weir — a typed shell"}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/iosevka-term-ext-regular.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // theme before first paint [D:queil-theme]: stored choice wins,
      // else the OS setting — inline so a dark load never flashes light
      (() => {
        const t = localStorage.getItem("theme");
        if (t === "dark" || (!t && matchMedia("(prefers-color-scheme: dark)").matches))
          document.documentElement.classList.add("dark");
      })();
    </script>
    <style is:global>
      /* is:global, deliberately [D:guide-register]: Astro scopes styles
         to template-authored elements, and the markdown content that IS
         this site carries no scope attribute — a scoped stylesheet here
         styles the chrome and leaves every rendered doc browser-default
         (how the code blocks shipped unpadded: the rule existed, the
         scoping kept it from matching). */
      @font-face {
        font-family: "Iosevka Term Ext";
        src: url("/fonts/iosevka-term-ext-regular.woff2") format("woff2");
        font-weight: 400;
        font-display: swap;
      }
      @font-face {
        font-family: "Iosevka Term Ext";
        src: url("/fonts/iosevka-term-ext-bold.woff2") format("woff2");
        font-weight: 700;
        font-display: swap;
      }
      /* the palette is queil.net's [D:queil-theme]: monochrome page,
         the colour lives in the code; the accent is the palette's own
         keyword blue. Dark values are DERIVED (hue kept, lightness
         re-tuned) — html.dark swaps every token, so no element may
         hard-code a colour. */
      :root {
        --bg: #ffffff;
        --fg: #111111;
        --muted: #555555;
        --accent: #004396;
        --code-bg: #f4f4f4;
        --border: #d0d0d0;
        --danger: #c81040;
        --ok: #1a7f37;
        /* the type scale — five sizes, no arbitrary values per element */
        --text-sm: 0.88rem;
        --text-base: 1rem;
        --text-lg: 1.125rem;
        --text-xl: 1.35rem;
        --text-2xl: 1.9rem;
        /* the spacing scale — tighten within units, widen between them */
        --space-1: 0.25rem;
        --space-2: 0.5rem;
        --space-3: 1rem;
        --space-4: 1.75rem;
        --space-5: 3rem;
      }
      html.dark {
        --bg: #0e1113;
        --fg: #d6dade;
        --muted: #98a2ac;
        --accent: #7fb2f0;
        --code-bg: #161b1e;
        --border: #2a3138;
        --danger: #ff8098;
        --ok: #4ec97a;
      }
      /* dual-theme code: Shiki emits both palettes as custom
         properties (defaultColor off); the html class picks one */
      .astro-code, .astro-code span {
        color: var(--shiki-light);
        background-color: var(--shiki-light-bg);
        font-style: var(--shiki-light-font-style);
        font-weight: var(--shiki-light-font-weight);
      }
      html.dark .astro-code, html.dark .astro-code span {
        color: var(--shiki-dark);
        background-color: var(--shiki-dark-bg);
        font-style: var(--shiki-dark-font-style);
        font-weight: var(--shiki-dark-font-weight);
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        /* dense technical prose: taller leading than display text wants */
        font: 16px/1.7 system-ui, -apple-system, "Segoe UI", sans-serif;
      }
      header {
        border-bottom: 1px solid var(--border);
        padding: 0.75rem 1.25rem;
        display: flex;
        flex-wrap: wrap;   /* six links survive a narrow viewport */
        gap: 1.25rem;
        /* center, not baseline: the brand is a flex pair (mark + word)
           whose baseline sits above the nav's — centering aligns the
           row and puts the mark's middle bar at the line's middle */
        align-items: center;
      }
      header .brand {
        font-weight: 700;
        font-size: 1.1rem;
        color: var(--fg);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
      }
      .brand .b1 { fill: #004396; }
      .brand .b2 { fill: #00658a; }
      .brand .b3 { fill: #007575; }
      html.dark .brand .b1 { fill: #7fb2f0; }
      html.dark .brand .b2 { fill: #4fc1e8; }
      html.dark .brand .b3 { fill: #2fc6c6; }
      .nav-right {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }
      .nav-right .ver {
        color: var(--muted);
        text-decoration: none;
        font-size: var(--text-sm);
        font-family: "Iosevka Term Ext", ui-monospace, monospace;
      }
      .nav-right .ver:hover { color: var(--accent); }
      .icon-link {
        color: var(--muted);
        line-height: 0;
        padding: 0.45rem;
        border-radius: 6px;
      }
      .icon-link:hover { color: var(--accent); }
      #nav-toggle {
        display: none;
        border: 1px solid var(--border);
        background: var(--bg);
        color: var(--muted);
        border-radius: 6px;
        padding: 0.1rem 0.5rem;
        cursor: pointer;
        font-size: 1rem;
        line-height: 1.4;
      }
      #nav-toggle:hover { color: var(--accent); border-color: var(--accent); }
      /* the phone header: links collapse behind the hamburger and open
         as a full-width column — seven wrapped links were an unusable
         pile at this width, not a navigation */
      @media (max-width: 720px) {
        #nav-toggle { display: inline-block; }
        header nav {
          display: none;
          order: 10;
          flex-basis: 100%;
        }
        header.nav-open nav {
          display: flex;
          flex-direction: column;
          gap: 0;
        }
        header nav a {
          display: block;
          margin-right: 0;
          padding: 0.6rem 0;
          border-top: 1px solid var(--border);
        }
      }
      /* touch gets the full 44px hit area; pointers keep the compact nav */
      @media (pointer: coarse) {
        .icon-link { padding: 0.85rem; }
        #theme-toggle { padding: 0.6rem 0.85rem; }
      }
      #theme-toggle {
        border: 1px solid var(--border);
        background: var(--bg);
        color: var(--muted);
        border-radius: 6px;
        padding: 0.1rem 0.45rem;
        cursor: pointer;
        font-size: 1rem;
        line-height: 1.4;
      }
      #theme-toggle:hover { color: var(--accent); border-color: var(--accent); }
      header nav a { color: var(--muted); text-decoration: none; margin-right: 1rem; }
      header nav a:hover { color: var(--accent); }
      /* the measure: 65–70 characters — readability beats width, and it
         matters more the denser the content */
      main { max-width: 68ch; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
      /* the side navigation: sticky, scrolls its own overflow, never
         the page's. The measure is untouched — the grid centers the
         pair, and narrow viewports fall back to one column. */
      .with-toc {
        display: grid;
        grid-template-columns: 15rem minmax(0, 68ch);
        gap: 3rem;
        justify-content: center;
        padding: 0 1.25rem;
      }
      .with-toc main { margin: 0; max-width: 68ch; padding: 2rem 0 4rem; }
      .toc {
        position: sticky;
        top: 0;
        align-self: start;
        max-height: 100vh;
        overflow-y: auto;
        padding: 2rem 0.25rem 2rem 0;
        font-size: var(--text-sm);
      }
      .toc-title {
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: var(--fg);
      }
      .toc ul { list-style: none; margin: 0; padding: 0; }
      .toc li { margin: 0.15rem 0; }
      .toc li.d3 { padding-left: 0.9rem; }
      .toc a { color: var(--muted); text-decoration: none; display: block; }
      .toc a:hover { color: var(--accent); }
      /* the mobile stand-in: same links, a collapsed block above the
         content — the sticky aside has no room below the breakpoint */
      .toc-mobile { display: none; }
      @media (max-width: 1100px) {
        .with-toc { display: block; padding: 0; }
        .with-toc main { margin: 0 auto; padding: 2rem 1.25rem 4rem; }
        .toc { display: none; }
        .toc-mobile {
          display: block;
          border: 1px solid var(--border);
          border-radius: 6px;
          padding: 0.5rem 0.9rem;
          margin-bottom: var(--space-4);
          font-size: var(--text-sm);
        }
        .toc-mobile summary { cursor: pointer; font-weight: 600; }
        .toc-mobile ul { list-style: none; margin: 0.4rem 0 0; padding: 0; }
        .toc-mobile li.d3 { padding-left: 0.9rem; }
        .toc-mobile a { color: var(--muted); text-decoration: none; display: block; padding: 0.25rem 0; }
      }
      main a { color: var(--accent); }
      /* the ONE code treatment — inline spans, blocks, install rows all
         bound their code the same way: tinted, hairline-bordered, padded.
         Highlighted blocks carry their theme background inline, which
         wins over this tint; the border still bounds them. */
      pre {
        padding: 0.9rem 1.1rem;
        border-radius: 6px;
        overflow-x: auto;   /* long weir lines SCROLL, never wrap or bleed */
        max-width: 100%;
        font-size: var(--text-sm);
        line-height: 1.55;
        background: var(--code-bg);
        border: 1px solid var(--border);
      }
      code { font-family: "Iosevka Term Ext", ui-monospace, "SF Mono", Consolas, monospace; }
      kbd {
        font: 0.78em "Iosevka Term Ext", ui-monospace, "SF Mono", Consolas, monospace;
        background: var(--code-bg);
        border: 1px solid var(--border);
        border-bottom-width: 2px;
        border-radius: 4px;
        padding: 0.1em 0.4em;
        white-space: nowrap;
      }
      /* inline code reads as an OBJECT in the sentence, not as the
         sentence in another typeface: smaller, bounded, tinted */
      :not(pre) > code {
        background: var(--code-bg);
        padding: 0.16em 0.42em;
        border-radius: 4px;
        font-size: 0.85em;
      }
      h1, h2, h3 { line-height: 1.25; }
      h1 { font-size: var(--text-2xl); }
      h2 { font-size: var(--text-xl); margin-top: var(--space-5); border-bottom: 1px solid var(--border); padding-bottom: 0.3rem; }
      h3 { font-size: var(--text-lg); }
      table { border-collapse: collapse; display: block; overflow-x: auto; }
      th, td { border: 1px solid var(--border); padding: 0.35rem 0.65rem; }
      blockquote { margin: 0; padding-left: 1rem; border-left: 3px solid var(--border); color: var(--muted); }
    </style>
  </head>
  <body>
    <header>
      <a class="brand" href="/">
        <svg class="mark" viewBox="18 32 92 62" width="25" height="16.9" aria-hidden="true">
          <rect class="b1" x="20" y="34" width="56" height="12" rx="6" />
          <rect class="b2" x="36" y="57" width="56" height="12" rx="6" />
          <rect class="b3" x="52" y="80" width="56" height="12" rx="6" />
        </svg>weir</a>
      <nav id="site-nav">
        <a href="/docs/install/">Install</a>
        <a href="/docs/guide/">Guide</a>
        <a href="/reference/">Reference</a>
        <a href="/docs/tooling/">Tooling</a>
        <a href="/docs/coming-from/">Coming from…</a>
        <a href="/showcase/">Showcase</a>
        <a href="/changelog/">Changelog</a>
      </nav>
      <div class="nav-right">
        {releaseTag && (
          <a class="ver" href={`https://github.com/weir-shell/weir/releases/tag/${releaseTag}`}>{releaseTag}</a>
        )}
        <a class="icon-link" href="https://github.com/weir-shell/weir" aria-label="GitHub">
          <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
        </a>
        <button id="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">◐</button>
        <button id="nav-toggle" aria-label="Menu" aria-controls="site-nav" aria-expanded="false">☰</button>
      </div>
      <script is:inline>
        document.getElementById("nav-toggle").addEventListener("click", (e) => {
          const open = document.querySelector("header").classList.toggle("nav-open");
          e.currentTarget.setAttribute("aria-expanded", String(open));
        });
        document.getElementById("theme-toggle").addEventListener("click", () => {
          const dark = document.documentElement.classList.toggle("dark");
          const os = matchMedia("(prefers-color-scheme: dark)").matches;
          // back at the OS value → forget, so the OS keeps driving
          if (dark === os) localStorage.removeItem("theme");
          else localStorage.setItem("theme", dark ? "dark" : "light");
        });
      </script>
    </header>
    {
      toc?.length ? (
        <div class="with-toc">
          <aside class="toc" aria-label="On this page">
            <div class="toc-title">On this page</div>
            <ul>
              {toc.map((h) => (
                <li class={`d${h.depth}`}>
                  <a href={h.href ?? `#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </aside>
          <main>
            <details class="toc-mobile">
              <summary>On this page</summary>
              <ul>
                {toc.map((h) => (
                  <li class={`d${h.depth}`}>
                    <a href={h.href ?? `#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </details>
            <slot />
          </main>
        </div>
      ) : (
        <main>
          <slot />
        </main>
      )
    }
  </body>
</html>
