<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- the host holds this source to the LANGUAGE's standard [D:host-strictness]:
         weir makes a non-exhaustive match a hard error, F# only warns — so the
         warning has to bind. Clean at adoption; it does NOT reach the tuple
         matches that drifted, nor unused private values (F# emits nothing there) -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- ...but the ILC aggregates are about DEPENDENCIES, not this source
         [D:host-strictness]: IL2104/IL3053 say "FSharp.Core produced trim
         warnings" and nothing here can answer them, so promoting those
         fails the publish on every OS while teaching nobody. They stay
         VISIBLE as warnings; only the promotion is withdrawn. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104;IL3053</WarningsNotAsErrors>
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Speed</OptimizationPreference>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- the stamp lives in the BUILD, not publish.sh [D:windows-v1]: every
       publish path (dotnet publish, a future .ps1, CI) must stamp
       identically or the freshness gate cannot match. Same spelling as
       the old script: short hash, -dirty via porcelain, nogit fallback. -->
  <Target Name="WeirStamp" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo">
    <Exec Command="git rev-parse --short HEAD"
          ConsoleToMSBuild="true" IgnoreExitCode="true" ContinueOnError="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_WeirSha" />
      <Output TaskParameter="ExitCode" PropertyName="_WeirShaExit" />
    </Exec>
    <Exec Command="git status --porcelain"
          ConsoleToMSBuild="true" IgnoreExitCode="true" ContinueOnError="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_WeirDirty" />
    </Exec>
    <PropertyGroup>
      <!-- the HASH component: short sha, -dirty via porcelain, nogit fallback -->
      <_WeirHash Condition="'$(_WeirShaExit)' == '0'">$(_WeirSha)</_WeirHash>
      <_WeirHash Condition="'$(_WeirShaExit)' != '0'">nogit</_WeirHash>
      <_WeirHash Condition="'$(_WeirDirty)' != '' and '$(_WeirShaExit)' == '0'">$(_WeirHash)-dirty</_WeirHash>
      <!-- the TAG component [D:releases]: the release tag when building a
           release, else an honest 0.0.0-dev marker that sorts BELOW any
           release (an empty tag would be dishonest). The stamp is ALWAYS
           <tag>+<hash> — the tag leads for humans and ordering, the sha
           rides for exactness. The freshness gates (ci/check-fresh.sh,
           the fuzz stampGate) read the hash as the part after the last
           '+', so this format change keeps their stamp==HEAD contract. -->
      <_WeirTag Condition="'$(WeirRelease)' != ''">$(WeirRelease)</_WeirTag>
      <_WeirTag Condition="'$(WeirRelease)' == ''">0.0.0-dev</_WeirTag>
      <InformationalVersion>$(_WeirTag)+$(_WeirHash)</InformationalVersion>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="FParsec" Version="1.1.1" />
    <!-- pinned [D:aot-warnings]: implicit FSharp.Core floats — CI restored
         10.1.302 while local built 10.1.301, two silently different binaries -->
    <PackageReference Update="FSharp.Core" Version="10.1.302" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Version.fs" />
    <Compile Include="Types.fs" />
    <Compile Include="Ast.fs" />
    <Compile Include="Argv.fs" />
    <!-- before Check: the checker builds from-yaml Shapes; before Eval:
         the adapters parse/render through it [D:yaml-v1] -->
    <Compile Include="Yaml.fs" />
    <Compile Include="Check.fs" />
    <!-- after Check: the schema validator walks the TYPED template;
         before Script: check-time schema resolution [D:contracts-spine] -->
    <Compile Include="Http.fs" />
    <Compile Include="Contracts.fs" />
    <Compile Include="Parser.fs" />
    <Compile Include="Session.fs" />
    <Compile Include="Extern.fs" />
    <Compile Include="Diagnose.fs" />
    <Compile Include="Proc.fs" />
    <Compile Include="Eval.fs" />
    <Compile Include="Builtins.fs" />
    <!-- after Extern + Builtins: completion reuses the PATH cache and
         command-callable set for command-head suggestions [D:repl-quality] -->
    <Compile Include="Complete.fs" />
    <Compile Include="Prelude.fs" />
    <Compile Include="Script.fs" />
    <!-- after Script: the capability walker reads CheckedStmt trees
         [D:can-report] -->
    <Compile Include="Can.fs" />
    <Compile Include="Fmt.fs" />
    <Compile Include="Lsp.fs" />
    <Compile Include="Repl.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

</Project>
