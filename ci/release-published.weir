#!/usr/bin/env weir
// The tag-without-publish gate [D:release-gate]: `releases/latest`
// EXCLUDES drafts, and [D:releases] produces drafts — so tagging alone
// does NOT make the installers serve the release; a human must publish.
// The check is latest's TAG == the NEWEST stable tag, never bare
// reachability: once ANY release is published /latest answers 200
// forever, so a 200 proves nothing about the tag just cut (the blind
// spot that let a publish-wait poll report v0.0.31 shipped while
// /latest still served v0.0.29). A burned tag ages out on its own: the
// next release makes a newer tag the newest, and the burned one is
// never demanded again (the v0.0.30 precedent) — but the aging-out
// WINDOW is red and blocks the superseding release's own PR (the check
// eating its repair, the shape [D:release-assets] reversed with
// known-incomplete): ci/release-burned.yaml acknowledges the burn for
// that window [D:burned-tag-ack].

let repo = "weir-shell/weir"

// burned tags [D:burned-tag-ack]: a tag whose release never shipped is
// BURNED — immutable [D:tag-immutability], never re-pointed, superseded
// by the next tag. An entry carries its reason and is SWEPT below: a
// listed tag that IS published fails as stale; an aged-out entry (a
// newer stable tag exists) is named for removal WITHOUT failing — it
// suppresses nothing, and a hard stale-fail would re-open the exact
// red-window this file closes.
let burned =
    (File.read "ci/release-burned.yaml"
     |> from yaml {| burned: seq<{| tag: string; reason: string |}> |})
        .burned
    |> Seq.freeze

let burnedTags = burned |> Seq.map (fun e -> e.tag) |> Seq.freeze

// tags come from the checkout (the release tag is pushed before the
// draft is published). Only STABLE tags count [D:tag-immutability]: a
// prerelease suffix (v0.0.0-rc1) is EXCLUDED from releases/latest by
// GitHub's own semantics, so an unpublished-or-deleted rc is a normal
// state, not the missing-click defect — and tags are never deleted, so
// the gate must not demand publication for tags that cannot satisfy it.
let tags =
    git tag -l "v*"
    |> Seq.where (fun t -> not (Str.contains "-" t))
    |> Seq.where (fun t -> not (Seq.contains t burnedTags))
    |> Seq.freeze

if Seq.isEmpty tags then
    print "no stable unburned v* tag yet — nothing to check (pre-first-release; prerelease and burned tags are exempt)"
    exit 0

// newest by VERSION, not by text — v0.0.9 sorts after v0.0.31 textually
let verKey t =
    match t with
    | Regex @"^v(\d+)\.(\d+)\.(\d+)$" (ma, mi, pa) -> (Str.toInt ma) * 1000000 + (Str.toInt mi) * 1000 + (Str.toInt pa)
    | _ -> -1

let newest = tags |> Seq.maxBy verKey

// status is DATA — Http.send binds it, a 404 is a value not an error.
// GitHub's API requires a User-Agent; the default one [D:http-ua] covers it.
// GITHUB_TOKEN when present: CI runners share egress IPs, so the
// unauthenticated rate limit 403s routinely — auth lifts it.
let sendGh req =
    match Env.get "GITHUB_TOKEN" with
    | Some t -> Http.send { req with auth = Bearer (Secret.of t) }
    | None -> Http.send req

// the burned sweep: a still-current entry must reference a tag that is
// genuinely unpublished — /releases/tags/{tag} answers 200 for
// PUBLISHED only (a draft has no tag association until the click)
for e in burned do
    if verKey e.tag < verKey newest then
        print $"note: burned entry {e.tag} ('{e.reason}') aged out — {newest} supersedes it; remove it at leisure"
    else
        let r = sendGh (Http.get $"https://api.github.com/repos/{repo}/releases/tags/{e.tag}")
        if r.status == 200 then
            fail $"ci/release-burned.yaml lists {e.tag} ('{e.reason}') as burned but that release IS published — stale entry, remove it"

let rel = sendGh (Http.get $"https://api.github.com/repos/{repo}/releases/latest")

if rel.status == 200 then
    let latest = (rel.body |> from json {| tag_name: string |}).tag_name
    if latest == newest then
        print $"releases/latest is {latest} — the newest stable tag is published"
        // published is necessary, not SUFFICIENT [D:release-assets]:
        // v0.0.40 published with 5 of 10 assets (a transient 500
        // mid-upload + a partial manual recovery slipped past the draft
        // review), and a published release is immutable. The expected
        // asset list's ONE copy lives in ci/release-assets.weir —
        // invoked here, never restated. A KNOWN-incomplete release is
        // acknowledged in ci/release-known-incomplete.yaml (the
        // skill-omitted pattern: an entry carries its reason and is
        // SWEPT — listed-but-complete fails as stale) so a permanent
        // red cannot block the superseding release's own PR; a NEW
        // incomplete release still fails here.
        let knownIncomplete =
            (File.read "ci/release-known-incomplete.yaml"
             |> from yaml {| known: seq<{| tag: string; reason: string |}> |})
                .known
            |> Seq.freeze

        // the stale sweep: an acknowledged release must ACTUALLY be
        // incomplete, or the entry is rot and fails loudly
        for e in knownIncomplete do
            let sweep = weir ci/release-assets.weir --tag (e.tag) | complete
            if sweep.exitCode == 0 then
                fail $"ci/release-known-incomplete.yaml lists {e.tag} ('{e.reason}') but that release IS complete — stale entry, remove it"

        match knownIncomplete |> Seq.tryFind (fun e -> e.tag == latest) with
        | Some e ->
            print $"releases/latest {latest} is KNOWN-incomplete ({e.reason}) — acknowledged in ci/release-known-incomplete.yaml; immutable, superseded by the next complete release"
        | None ->
            weir ci/release-assets.weir --tag $latest | orFail $"releases/latest {latest} is published but INCOMPLETE (verdicts above) — a published release is immutable, so nothing repairs {latest} in place: fix forward, cut and publish release vNEXT (the supersede path) and acknowledge {latest} in ci/release-known-incomplete.yaml"

        exit 0
    fail $"releases/latest is {latest} but the newest stable tag is {newest} — that tag was pushed and never PUBLISHED, and the installers silently keep serving {latest}. If its draft exists: gh release edit {newest} --draft=false (or the Releases page); if the release run never built (a red gate), fix and re-release — or burn the tag: acknowledge it in ci/release-burned.yaml (tag + reason) and cut the next release; the gate then demands the newest unburned tag"

// a 404 is the missing-publish state with NO release published yet —
// /latest excluding drafts answers 404, never 403. Any other status is
// the API refusing the QUERY, and the draft repair would be the wrong
// teach for it.
if rel.status == 404 then
    fail $"releases/latest 404s but v* tag(s) exist — [D:releases] produces DRAFTS, which /latest excludes; the installers 404. PUBLISH THE DRAFT: gh release edit {newest} --draft=false (or the Releases page)"

fail $"releases/latest returned {rel.status} — the API refused the query, not a release state (an unpublished draft answers 404, and this is not one). Most often the unauthenticated rate limit on shared CI egress IPs: set GITHUB_TOKEN, or retry"
