#!/usr/bin/env weir
// The tag-without-publish gate [D:release-gate]: `releases/latest`
// EXCLUDES drafts, and [D:releases] produces drafts — so a tag with an
// unpublished draft 404s there, and install.sh / install.ps1 both fail
// with "could not resolve the latest release tag". Tagging alone does
// NOT make the installers work; a human must publish the draft. This
// fails LOUD on exactly that state, so the missing publish-click can't
// ship silently — it guards every release, not just the first.

let repo = "weir-shell/weir"

// tags come from the checkout (the release tag is pushed before the
// draft is published). Only STABLE tags count [D:tag-immutability]: a
// prerelease suffix (v0.0.0-rc1) is EXCLUDED from releases/latest by
// GitHub's own semantics, so an unpublished-or-deleted rc is a normal
// state, not the missing-click defect — and tags are never deleted, so
// the gate must not demand publication for tags that cannot satisfy it.
let tags =
    git tag -l "v*"
    |> Seq.where (fun t -> not (Str.contains "-" t))
    |> Seq.force

if Seq.isEmpty tags then
    print "no stable v* tag yet — nothing to check (pre-first-release; prerelease tags are exempt)"
    exit 0

// status is DATA — Http.send binds it, a 404 is a value not an error.
// GitHub's API requires a User-Agent; the default one [D:http-ua] covers it.
// GITHUB_TOKEN when present: CI runners share egress IPs, so the
// unauthenticated rate limit 403s routinely — auth lifts it.
let req = Http.get $"https://api.github.com/repos/{repo}/releases/latest"

let rel =
    match Env.get "GITHUB_TOKEN" with
    | Some t -> Http.send { req with auth = Bearer (Secret.of t) }
    | None -> Http.send req

if rel.status == 200 then
    print $"releases/latest resolves (200) — a published release exists for {tags |> Seq.length} tag(s)"
    exit 0

// ONLY a 404 is the missing-publish-click state — /latest excluding a
// draft answers 404, never 403. Any other status is the API refusing
// the QUERY, and the draft repair would be the wrong teach for it.
if rel.status == 404 then
    fail $"releases/latest 404s but v* tag(s) exist — [D:releases] produces DRAFTS, which /latest excludes; the installers 404. PUBLISH THE DRAFT: gh release edit <tag> --draft=false (or the Releases page)"

fail $"releases/latest returned {rel.status} — the API refused the query, not a release state (an unpublished draft answers 404, and this is not one). Most often the unauthenticated rate limit on shared CI egress IPs: set GITHUB_TOKEN, or retry"
