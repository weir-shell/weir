#!/usr/bin/env weir
// Commit areas, derived rather than remembered [D:commit-areas]: the
// area prefix on a commit subject is checked against the areas its
// diff actually touches — a fact about the commit, not an assertion
// by the author. The path map's single copy lives here; dev/PROCESS.md
// documents the shape and points at this file.
//
//   ci/commit-area.weir --range A..B     check every commit in a range
//   ci/commit-area.weir --commit SHA     check one commit
//
// Subject shape:  area: subject  |  area,area: subject  — the declared
// set must equal the derived set (a subset would let `docs` hide a
// parser change). On mismatch the failure prints the derived prefix
// [D:derived-prints].
//
// The riding rule: if any src/Weir file moved, the derived set is the
// src areas only — tests, pins, docs, and ledger entries ride the
// feature they verify or record. A commit with no src changes derives
// from the non-src map (ci / docs / ledger / tests).

type Cli = {
    /// commit range (A..B) to check
    range: Option<string>
    /// a single commit to check
    commit: Option<string>
}

let cli = Args.load Cli

// an unmapped src file fails, not falls back [D:derived-prints]: src
// areas are semantic groupings, so a new file is a decision — the map
// entry lands in the same commit
let areaOfSrc p =
    match p with
    // Script.fs's concerns sit in a file each [D:script-by-concern], each in
    // the area it is: Assemble is the statement grammar's first half
    | "src/Weir/Parser.fs" | "src/Weir/Assemble.fs" | "src/Weir/Ast.fs" | "src/Weir/Scan.fs"
    // the grammar's shared half and the hand-written happy path [D:hand-parser]
    | "src/Weir/Desugar.fs" | "src/Weir/Fast.fs" -> Some "parser"
    // Effects is the ambient/mutation partition [D:pure-stage2] — Purity's
    // sibling, the classification the checker enforces (and eval consults)
    | "src/Weir/Check.fs" | "src/Weir/Purity.fs" | "src/Weir/Effects.fs"
    // checking a statement, a module and a whole file, and what they find
    | "src/Weir/Statements.fs" | "src/Weir/ModuleLoader.fs" | "src/Weir/Analyze.fs" | "src/Weir/Diagnostics.fs"
    | "src/Weir/Types.fs" -> Some "checker"
    | "src/Weir/Eval.fs" | "src/Weir/Session.fs" | "src/Weir/Proc.fs" -> Some "eval"
    // the module table Builtins' members answer to [D:module-table]
    | "src/Weir/Builtins.fs" | "src/Weir/Prelude.fs" | "src/Weir/Modules.fs" -> Some "builtins"
    | "src/Weir/Repl.fs" | "src/Weir/Complete.fs" | "src/Weir/DynComplete.fs"
    // the REPL's colours and its init file
    | "src/Weir/ReplColor.fs" | "src/Weir/Init.fs" -> Some "repl"
    // the framing the language server and the debug adapter share [D:one-framing]
    | "src/Weir/Lsp.fs" | "src/Weir/Framing.fs" -> Some "lsp"
    // the editor's debugger, the language server's sibling [D:step-debugger]
    | "src/Weir/Debugger.fs" -> Some "dap"
    | "src/Weir/Fmt.fs" -> Some "fmt"
    // Serve is the server leg [D:http-serve] (Http's listener side of the
    // one boundary); SchemaTypes the schema→types generator core
    // [D:schema-types] (Infer's sibling, the other frontend of the one
    // decl emitter)
    | "src/Weir/Yaml.fs" | "src/Weir/Http.fs" | "src/Weir/Serve.fs" | "src/Weir/Infer.fs"
    | "src/Weir/SchemaTypes.fs" | "src/Weir/Table.fs" | "src/Weir/Toml.fs" | "src/Weir/Csv.fs" -> Some "adapters"
    // the runner (Script.fs) and the signature files' two halves
    | "src/Weir/Script.fs" | "src/Weir/Sigs.fs" | "src/Weir/SigGen.fs"
    | "src/Weir/Version.fs" | "src/Weir/Program.fs" | "src/Weir/Can.fs" | "src/Weir/Argv.fs"
    | "src/Weir/Extern.fs" | "src/Weir/Contracts.fs" | "src/Weir/Diagnose.fs"
    // the one PATH walk Extern and Contracts both make [D:one-path-walk]
    | "src/Weir/PathLookup.fs" | "src/Weir/Json.fs" -> Some "cli"
    // the ILC substitutions are build config, the .fsproj's sibling [D:binary-size]
    | p when Str.endsWith ".fsproj" p || p == "src/Weir/ILLink.Substitutions.xml" -> None
    | p when Str.startsWith "src/Weir/" p -> Some "UNMAPPED"
    | _ -> None

let areaOfOther p =
    if p == "docs/DECISIONS.md" || Str.startsWith "dev/" p then
        "ledger"
    // site is its own area [D:site-skeleton]: the content and deploy wiring
    // are not docs — a site commit riding `docs` would make the log lie
    elif Str.startsWith "site/" p then
        "site"
    elif Str.startsWith "ci/" p || Str.startsWith ".github/" p || Str.startsWith "tools/" p || Str.startsWith "tests/pty/" p then
        "ci"
    // the formatter pin and its settings are build config [D:fantomas-pinned]
    elif p == ".editorconfig" || Str.startsWith ".config/" p then
        "ci"
    elif Str.startsWith "publish." p || Str.startsWith "install." p || Str.startsWith "Dockerfile" p || p == "weir.slnx" || p == ".gitignore" || p == ".dockerignore" || p == ".gitattributes" || Str.endsWith ".fsproj" p || p == "src/Weir/ILLink.Substitutions.xml" then
        // a .fsproj with no accompanying .fs change is build config (it
        // rides the src it configures via areaOfSrc when both move; alone,
        // it is ci, never the docs fallback) [D:commit-areas]
        "ci"
    elif Str.startsWith "tests/" p then
        "tests"
    // editor extensions are code with their own release cadence
    // [D:editors-area]: a client change riding `docs` would make the log lie
    elif Str.startsWith "editors/" p then
        "editors"
    elif Str.startsWith "docs/" p || Str.startsWith "skills/" p || Str.startsWith "examples/" p || Str.startsWith "assets/" p then
        "docs"
    elif p == "README.md" || p == "SECURITY.md" || p == "NOTICE" || p == "LICENSE" || p == "CONTRIBUTING.md" || p == "CODE_OF_CONDUCT.md" || p == "THIRD-PARTY-NOTICES.txt" || p == "CLAUDE.md" || p == "CHANGELOG.md" then
        "docs"
    else
        // an unmapped non-src path keeps a fallback, said aloud —
        // .editorconfig must not block a commit [D:derived-prints]
        printerr $"commit-area note: '{p}' is unmapped — fallback: docs"
        "docs"

let checkCommit c =
    let subject = git log -1 --format=%s $c | line
    // merge commits are skipped [D:commit-areas]: their subjects are
    // GitHub-generated and their diffs are resolutions, not work — the
    // area lives on the commits being merged (rev-list --no-merges
    // covers ranges; this covers --commit)
    let parents = git rev-list --parents -n 1 $c | line |> Str.split " " |> Seq.length

    if parents > 2 then
        print $"commit-area SKIP: {c} is a merge ({subject})"
        true
    else
        let files = git show --format= --name-only $c |> Seq.where (fun f -> Str.trim f <> "") |> Seq.freeze
        let srcAreas = files |> Seq.choose (fun f -> areaOfSrc f) |> Seq.freeze
        let unmapped = srcAreas |> Seq.where (fun a -> a == "UNMAPPED") |> Seq.freeze

        if not (Seq.isEmpty unmapped) then
            let names =
                files |> Seq.where (fun f -> areaOfSrc f == Some "UNMAPPED") |> Str.join " "

            printerr $"commit-area FAIL: {c} touches unmapped src file(s): {names} — a new src file is an AREA DECISION; add its map entry to ci/commit-area.weir in this commit"
            false
        else
            let derived =
                if Seq.isEmpty srcAreas then
                    files |> Seq.map (fun f -> areaOfOther f) |> Seq.distinct |> Seq.sort |> Str.join ","
                else
                    srcAreas |> Seq.distinct |> Seq.sort |> Str.join ","

            if derived == "" then
                print $"commit-area SKIP: {c} has no files ({subject})"
                true
            else
                match Str.rmatch "^([a-z][a-z,]*): " subject with
                | None ->
                    printerr $"commit-area FAIL: {c} has no area prefix — subject should start '{derived}: ' ({subject})"
                    false
                | Some groups ->
                    let declaredRaw = groups |> Seq.head

                    // type prefixes retired [D:commit-areas]: the area
                    // answers where, and the diff can verify it; what-kind
                    // lives in prose
                    if declaredRaw == "add" || declaredRaw == "fix" || declaredRaw == "chore" || declaredRaw == "feat" || declaredRaw == "refactor" then
                        printerr $"commit-area FAIL: {c} uses the retired type prefix '{declaredRaw}:' — areas replaced types; subject should start '{derived}: ' ({subject})"
                        false
                    else
                        let declared = Str.split "," declaredRaw |> Seq.distinct |> Seq.sort |> Str.join ","

                        if declared <> derived then
                            printerr $"commit-area FAIL: {c} declares '{declared}' but the diff derives '{derived}' ({subject})"
                            false
                        else
                            print $"commit-area ok: {c} {declared}"
                            true

if cli.range == None && cli.commit == None then
    fail "usage: commit-area.weir --range A..B | --commit SHA"

let commits =
    match cli.range with
    | Some r -> $(git rev-list --no-merges $r) |> Seq.freeze
    | None -> [cli.commit |> Option.defaultValue ""]

let results = commits |> Seq.map (fun c -> checkCommit c) |> Seq.freeze

if results |> Seq.exists (fun ok -> not ok) then
    exit 1
