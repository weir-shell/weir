// no tmp/proc/serve/always scope: the foreground reaper path [D:sigint-reaps]; arms run commands
let a = Self.args |> Seq.freeze
let log = a[0]
let tag = a[1]
let ev s = File.append log [s]
[1..3] |> Seq.iter (fun k ->
    ev $"B main {k}"
    sleep $"0.1{tag}"
    let n = sh -c $"sleep 0.05{tag}; echo x" |> Seq.length
    ev $"B main got {n}")
[0..3] |> Seq.piter (fun i ->
    [1..4] |> Seq.iter (fun k ->
        ev $"B fan/arm{i} {k}"
        sh -c $"sleep 0.06{tag}"
        ()))
ev "J fan"
let w =
    [0..2] |> Seq.pfirst (fun i ->
        ev $"B race/r{i}"
        sleep $"0.{i}5{tag}"
        i)
ev "J race"
ev $"B main winner {w}"
within lock $"{a[2]}/l.lock"
    sleep $"0.2{tag}"
    ()
ev "DONE"
