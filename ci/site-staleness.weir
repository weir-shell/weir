#!/usr/bin/env weir
// The served-installer staleness check [D:site-deploy] —
// [D:release-gate]'s shape one layer out: weir.sh/install.sh embeds the
// tag it was generated for, so comparing that against releases/latest
// catches a site dispatch that never fired or a deploy that failed
// quietly — users silently getting an older weir, correct-but-behind and
// invisible without a check. Runs in ci.yml on every push, so the gap is
// caught within a commit of appearing, not when a user reports it.
//
// Status is DATA (Http.send binds it; only transport raises — and a
// transport raise IS the loud failure here, naming the URL). GitHub's
// API requires a User-Agent; the default one [D:http-ua] covers it.

type Release = { tag_name: string }

let repo = "weir-shell/weir"

// pre-first-release: nothing published, nothing served — nothing to
// check. Only STABLE tags count [D:tag-immutability]: prerelease tags
// never reach releases/latest or the production site, and they are
// never deleted, so they must not hold this gate red.
let tags =
    git tag -l "v*"
    |> Seq.where (fun t -> not (Str.contains "-" t))
    |> Seq.force

if Seq.isEmpty tags then
    print "no stable v* tag yet — nothing to check (pre-first-release; prerelease tags are exempt)"
    exit 0

// an unpublished latest release is [D:release-gate]'s finding, not this
// script's — skip rather than double-report the same defect
let rel =
    Http.get $"https://api.github.com/repos/{repo}/releases/latest"
    |> Http.send

if rel.status <> 200 then
    print $"releases/latest returned {rel.status} — release-published.weir owns that state; skipping the staleness check"
    exit 0

let latest = (rel.body |> from json Release).tag_name

// the site must serve an installer once a release exists — a 404 here IS
// the dispatch-never-fired state, not a skippable condition. send, not
// fetch: fetch's raise names only url+status, and this arm's job is the
// DIAGNOSIS below (a raise cannot be caught to add it)
let site = Http.get "https://weir.sh/install.sh" |> Http.send

if site.status <> 200 then
    fail $"weir.sh/install.sh returned {site.status} but release {latest} is published — the site deploy never fired or failed; check the site workflow run for the release"

// a 200 that is NOT the installer gets its own diagnosis [D:site-deploy]:
// a host serving an SPA fallback answers 200 with HTML for every missing
// path — a Seq.pick raise would say "no match", not what happened
let tagLines =
    site.body
    |> Seq.choose (fun l -> Str.rmatch "TAG=\"([^\"]+)\"" l)
    |> Seq.force

if Seq.isEmpty tagLines then
    fail $"weir.sh/install.sh answers 200 but carries no TAG= line — the site is serving something that is not the installer (an SPA fallback page?) while release {latest} is published; check the deploy's installer fetch"

let served = tagLines |> Seq.head |> Seq.head

if served <> latest then
    fail $"weir.sh/install.sh pins '{served}' but releases/latest is '{latest}' — users are getting an older weir; redeploy the site (site.yml workflow_dispatch)"

print $"site staleness ok: weir.sh serves {served} == releases/latest"
