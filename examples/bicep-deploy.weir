#!/usr/bin/env weir
// bicep deploy/snapshot/quality — translated from the F#/dbt script.
// Reshapes: subcommands via args matching; App-of-(stack, env) tuple ->
// --stack/--env flags; dbt plan{} discovery NOT translated (pass the
// target explicitly); per-target env via Env.fromFile with the sigil
// env slot !e(...) and the !e district header (the shEnv shape);
// use!-disposal -> logout on the success path (see GUIDE's cleanup
// idiom for the complete-ization pattern).

type Target = { Name: string; BicepPath: string; Stack: string; Env: string }
type XrEnv = { XR_AZURE_GITHUB_AUTH: Option<int>; XR_ACTION_ON_UNMANAGE: Option<string> }
type TokenEnv = { ACTIONS_ID_TOKEN_REQUEST_TOKEN: string; ACTIONS_ID_TOKEN_REQUEST_URL: string }
type Oidc = { value: string }

let subcommand = args |> Seq.tryHead |> Option.defaultTo ""

let xr = Env.load XrEnv
let onUnmanage = xr.XR_ACTION_ON_UNMANAGE |> Option.defaultTo "detachAll"

let header t = printerr $"== {t} =="

let targetEnv t = Env.fromFile $"bicep/envs/{t.Stack}-{t.Env}.env"

let envVal t name =
    targetEnv t |> Seq.where (fun e -> e.Name == name) |> Seq.map _.Value |> Seq.head

let quality t =
    header $"bicep quality: {t.Stack}"
    let e = targetEnv t
    !e
        bicep lint (t.BicepPath)
        bicep snapshot --mode validate (t.BicepPath) --subscription-id (envVal t "AZURE_SUBSCRIPTION_ID") --resource-group (envVal t "AZURE_DEFAULTS_GROUP")
    printerr "OK"

let snapshot t =
    header $"bicep snapshot: {t.Name}"
    let e = targetEnv t
    !e(bicep snapshot (t.BicepPath) --subscription-id (envVal t "AZURE_SUBSCRIPTION_ID") --resource-group (envVal t "AZURE_DEFAULTS_GROUP"))
    printerr "OK"

let deployStack t =
    header $"bicep deploy: {t.Name}"
    let e = targetEnv t
    !e(az stack group create --yes "--output=table" --name (t.Name) --parameters (t.BicepPath) --action-on-unmanage (onUnmanage) --deny-settings-mode none)

let azureLogin t =
    header "azure login"
    let tok = Env.load TokenEnv
    let oidc =
        $(curl -sS -f -H $"Authorization: Bearer {tok.ACTIONS_ID_TOKEN_REQUEST_TOKEN}" $"{tok.ACTIONS_ID_TOKEN_REQUEST_URL}&audience=api://AzureADTokenExchange" | from json Oidc)
        |> Seq.head
    let e = targetEnv t
    !e
        az login --output table --federated-token (oidc.value) --service-principal --username (envVal t "AZURE_CLIENT_ID") --tenant (envVal t "AZURE_TENANT_ID")
        az account set --subscription (envVal t "AZURE_SUBSCRIPTION_ID")

let deploy t =
    quality t
    let e = targetEnv t
    if (xr.XR_AZURE_GITHUB_AUTH |> Option.defaultTo 0) == 1 then
        azureLogin t
        deployStack t
        !e(az logout)
    else deployStack t

let usage = "usage: bicep.weir <deploy|snapshot|quality> --stack S --env E"

let stack = Args.value "--stack" |> Option.defaultTo ""
let env = Args.value "--env" |> Option.defaultTo ""

if stack == "" || env == "" then fail usage

let target =
    { BicepPath = $"bicep/apps/stacks/{stack}/{env}.bicepparam"
      Stack = stack
      Env = env
      Name = $"{stack}-{env}-apps" }

match subcommand with
| "deploy" -> deploy target
| "snapshot" -> snapshot target
| c when c == "quality" -> quality target
| _ -> fail usage
