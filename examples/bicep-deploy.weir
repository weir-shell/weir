#!/usr/bin/env weir
// bicep deploy/snapshot/quality — translated from the F#/dbt script.
// Reshapes: subcommands via the typed front door [D:typed-argv];
// App-of-(stack, env) tuple -> --stack/--env flags; dbt plan{} discovery NOT translated (pass the
// target explicitly); per-target env via Env.fromFile with the sigil
// env slot !e(...) and the !e district header (the shEnv shape);
// use!-disposal -> logout on the success path (see GUIDE's cleanup
// idiom for the complete-ization pattern).

type Target = {
    Name: string
    BicepPath: string
    Stack: string
    Env: string
}

// literal fallbacks live at the declaration [D:default-attr]
type Env = {
    [<Default 0>]
    AZURE_GITHUB_AUTH: int
    [<Default "detachAll">]
    ACTION_ON_UNMANAGE: string
}

type TokenEnv = {
    ACTIONS_ID_TOKEN_REQUEST_TOKEN: string
    ACTIONS_ID_TOKEN_REQUEST_URL: string
}

type Oidc = { value: string }

// the typed front door: three subcommands, one flags shape —
// --help derives, unknown subcommands did-you-mean
type CmdArgs = {
    [<Doc "the bicep stack">]
    stack: string
    [<Doc "the target environment">]
    env: string
}

type Cmd =
    | Deploy of CmdArgs
    | Snapshot of CmdArgs
    | Quality of CmdArgs

let cli = Args.load Cmd

let env = Env.load Env
let onUnmanage = env.ACTION_ON_UNMANAGE

let header t = printerr $"== {t} =="

let targetEnv t = Env.fromFile $"bicep/envs/{t.Stack}-{t.Env}.env"

let envVal t name =
    targetEnv t |> Seq.where (fun e -> e.name == name) |> Seq.map _.value |> Seq.head

let quality t =
    header $"bicep quality: {t.Name}"
    let e = targetEnv t
    !e
        bicep lint (t.BicepPath)
        bicep snapshot --mode validate (t.BicepPath) --subscription-id (envVal t "AZURE_SUBSCRIPTION_ID") --resource-group (envVal t "AZURE_DEFAULTS_GROUP")
    printerr "OK"

let snapshot t =
    header $"bicep snapshot: {t.Name}"
    let e = targetEnv t
    !e(bicep snapshot (t.BicepPath) --subscription-id (envVal t "AZURE_SUBSCRIPTION_ID") --resource-group (envVal t "AZURE_DEFAULTS_GROUP"))
    printerr "OK"

let deployStack t =
    header $"bicep deploy: {t.Name}"
    let e = targetEnv t
    !e(az stack group create --yes "--output=table" --name (t.Name) --parameters (t.BicepPath) --action-on-unmanage (onUnmanage) --deny-settings-mode none)

let azureLogin t =
    header "azure login"
    let tok = Env.load TokenEnv
    let oidc =
        $(curl -sS -f -H $"Authorization: Bearer {tok.ACTIONS_ID_TOKEN_REQUEST_TOKEN}" $"{tok.ACTIONS_ID_TOKEN_REQUEST_URL}&audience=api://AzureADTokenExchange" | from json Oidc)
        |> Seq.head
    let e = targetEnv t
    !e
        az login --output table --federated-token (oidc.value) --service-principal --username (envVal t "AZURE_CLIENT_ID") --tenant (envVal t "AZURE_TENANT_ID")
        az account set --subscription (envVal t "AZURE_SUBSCRIPTION_ID")

let deploy t =
    quality t
    let e = targetEnv t
    if env.AZURE_GITHUB_AUTH == 1 then
        azureLogin t
        deployStack t
        !e(az logout)
    else deployStack t

let toTarget a = {
    BicepPath = $"bicep/apps/stacks/{a.stack}/{a.env}.bicepparam"
    Stack = a.stack
    Env = a.env
    Name = $"{a.stack}-{a.env}-apps"
}

// the dispatch the checker exhaustiveness-verifies — adding a Cmd
// case is a check-time obligation, not a runtime usage string
match cli with
| Deploy a -> deploy (toTarget a)
| Snapshot a -> snapshot (toTarget a)
| Quality a -> quality (toTarget a)
