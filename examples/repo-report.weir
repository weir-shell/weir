#!/usr/bin/env weir
// repo-report — a typed look at a git repository
// usage: repo-report [path]

type Health =
    | Clean
    | Dirty of int

// first arg, or the current directory
let target =
    args
    |> Seq.tryHead
    |> Option.defaultValue "."

// cd returns the new cwd — bind it once, interpolate it everywhere
let workdir = cd target

print $"=== repo report: {workdir} ==="

// a command line on a let RHS binds its output; the porcelain adapter
// turns it into typed rows
let changes =
    git status --porcelain
    | from porcelain

let health =
    let count = changes |> Seq.length
    if changes |> Seq.isEmpty then Clean else Dirty count

let status =
    match health with
    | Clean -> "status: clean"
    | Dirty 1 -> "status: dirty (one change)"
    | Dirty n when n > 10 -> $"status: dirty ({n} changes — commit soon?)"
    | Dirty n -> $"status: dirty ({n} changes)"

print status

// a bare-comma destructuring binder: two views of the same rows
let staged, unstaged = changes |> Seq.where _.Staged, changes |> Seq.where _.Unstaged

print $"counts: {staged |> Seq.length} staged, {unstaged |> Seq.length} unstaged"

print "staged:"

staged
    |> Seq.map (fun c -> $"  {c.Path}")
    |> print

print "largest files:"

ls
    |> Seq.sortByDescending _.Bytes
    |> Seq.first 3
    |> Seq.map (fun f -> $"  {f.Name} ({f.Bytes} bytes)")
    |> print

print "recent commits:"

// command statements stream straight to stdout
git log -3 "--format=  %h %s"

print $"done in {workdir}"
