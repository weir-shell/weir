#!/usr/bin/env weir
// repo-report — a typed look at a git repository
// usage: repo-report [path]

type Health =
    | Clean
    | Dirty of int

// first arg, or the current directory
let target = Self.args |> Seq.tryHead |> Option.defaultValue "."

// cd returns the new cwd — bind it once, interpolate it everywhere
let workdir = cd target

print $"=== repo report: {workdir} ==="

// a command line on a let RHS binds its output; the Regex pattern
// turns porcelain lines into rows of a shape WE declare
type Change = { staged: bool; unstaged: bool; path: string }

let changes =
    git status --porcelain
    |> Seq.choose (function
        | Regex @"^(.)(.) (.*)$" (x, y, path) ->
            Some { staged = x <> " " && x <> "?"; unstaged = y <> " "; path = path }
        | _ -> None)
    |> Seq.force

// [] matches emptiness on the seq directly; cons is for when the
// head is worth BINDING — a wildcard completes this one
let health =
    match changes with
    | [] -> Clean
    | _ -> Dirty (changes |> Seq.length)

let status =
    match health with
    | Clean -> "status: clean"
    | Dirty 1 -> "status: dirty (one change)"
    | Dirty n when n > 10 -> $"status: dirty ({n} changes — commit soon?)"
    | Dirty n -> $"status: dirty ({n} changes)"

print status

// a bare-comma destructuring binder: two views of the same rows
let staged, unstaged = changes |> Seq.where _.staged, changes |> Seq.where _.unstaged

print $"counts: {staged |> Seq.length} staged, {unstaged |> Seq.length} unstaged"

print "staged:"

staged
    |> Seq.map (fun c -> $"  {c.path}")
    |> print

print "largest files:"

ls
    |> Seq.sortByDescending _.bytes
    |> Seq.first 3
    |> Seq.map (fun f -> $"  {f.name} ({f.bytes})")
    |> print

print "recent commits:"

// command statements stream straight to stdout
git log -3 "--format=  %h %s"

print $"done in {workdir}"
