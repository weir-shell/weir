#!/usr/bin/env weir
// repo-report — a typed look at a git repository
// usage: repo-report [path]

type Health =
    | Clean
    | Dirty of int

// first arg, or the current directory
let target =
    args
    |> Seq.tryHead
    |> Option.defaultTo "."

let workdir = cd target

print $"=== repo report: {pwd |> Seq.head} ==="

// typed rows straight out of git's porcelain format
let changes =
    cmd "git" ["status"; "--porcelain"]
    |> from porcelain

let health =
    let count = changes |> Seq.length
    if changes |> Seq.isEmpty then Clean else Dirty count

let status =
    match health with
    | Clean -> "status: clean"
    | Dirty n -> $"status: dirty ({n} changes)"

print status

print "staged:"

changes
    |> Seq.where _.Staged
    |> Seq.map (fun c -> $"  {c.Path}")
    |> print

print "largest files:"

ls
    |> Seq.sortBy (fun f -> 0 - f.Bytes)
    |> Seq.first 3
    |> Seq.map (fun f -> $"  {f.Name}")
    |> print

print $"done in {pwd |> Seq.head}"
