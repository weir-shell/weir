module Lib
// a DEMO MODULE: declaration-only by law (types + lets, no commands),
// imported qualified-always by the showcase

/// a context record crossing the module boundary — types cross, and
/// the importer builds one with the qualified literal Lib.Ctx { … }
type Ctx = { name: string; port: int }

/// derive a display label from a context
// the SIGNATURE is the export [D:module-signatures]: its types flow
// into the implementation's check, so the fields resolve against Ctx
let label : Ctx -> string

let label c = $"{c.name}:{show c.port}"
