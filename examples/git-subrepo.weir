#!/usr/bin/env weir
// git-subrepo — the FULL port, translated from the 1,500-line bash
// original as the translation flagship. The ~40 mutated globals became
// ONE Ctx record derived per step; the OK/CODE band became result
// unions; RUN's flag matrix became weir's three command spellings;
// BASH_REMATCH loops became Regex patterns; filter-branch became
// per-commit temp-index plumbing (trees built MINUS .gitrepo up
// front, so the deprecated pass and its refs/original cleanup do not
// exist here).
//
// Bounds, stated: no --squash; push grafts with the merge method
// (rebase joins stay on the pull path); no worktrees; no empty-repo
// clone; no --edit/--file commit messages; `config` is NOT ported —
// its `<key> [<value>]` shape is the positionals park's operand case,
// on record as that park's receipt.

// ---- the state the bash threaded ambiently ----------------------

type GitRepo = {
    Remote: string
    Branch: string
    Commit: string
    Parent: string
    Method: string
}

type Ctx = {
    Subdir: string
    Subref: string
    Gitrepo: string
    Repo: GitRepo
    UpstreamHead: string
    HeadBranch: string
}

type PullOutcome =
    | Pulled
    | UpToDate
    | JoinConflict of string

// ---- the front door: a typed union over subcommands [D:typed-argv]

type StatusArgs = {
    [<Doc "the subrepo directory">]
    subdir: string
}

type FetchArgs = {
    [<Doc "the subrepo directory">]
    subdir: string
}

type PullArgs = {
    [<Doc "the subrepo directory">]
    subdir: string
    [<Doc "pull even if the branch exists">]
    force: bool
}

type CloneArgs = {
    [<Doc "the upstream repository url">]
    remote: string
    [<Doc "the directory to clone into">]
    subdir: string
    [<Doc "the upstream branch (default: the remote HEAD branch)">]
    branch: Option<string>
}

type InitArgs = {
    [<Doc "the directory to convert into a subrepo">]
    subdir: string
    remote: Option<string>
    branch: Option<string>
}

type PushArgs = {
    [<Doc "the subrepo directory">]
    subdir: string
    [<Doc "push even when upstream moved">]
    force: bool
}

type BranchArgs = {
    [<Doc "the subrepo directory">]
    subdir: string
}

type CommitArgs = {
    [<Doc "the subrepo directory">]
    subdir: string
    force: bool
}

type CleanArgs = {
    [<Doc "the subrepo directory">]
    subdir: string
    [<Doc "also delete every refs/subrepo ref for the subdir">]
    force: bool
}

type Cmd =
    | Status of StatusArgs
    | Fetch of FetchArgs
    | Pull of PullArgs
    | Clone of CloneArgs
    | Init of InitArgs
    | Push of PushArgs
    | Branch of BranchArgs
    | Commit of CommitArgs
    | Clean of CleanArgs

// shared flags by containment [D:shared-flags]: quiet/verbose declared
// ONCE; the union field is the subcommand slot
type Cli = {
    [<Doc "suppress progress output">]
    quiet: bool
    [<Doc "narrate each step to stderr">]
    verbose: bool
    cmd: Cmd
}

let cli = Args.load Cli
let quiet = cli.quiet
let verbose = cli.verbose

let say msg = if not quiet then print msg
let step msg = if verbose then printerr $"* {msg}"

// ---- small git wrappers (bash: git:* functions over RUN) --------

let revExists r = git rev-list $r -1 | succeeds

let revParse r = git rev-parse $r | Seq.head

let branchExists b = revExists $"refs/heads/{b}"

let commitInRevList commit listHead = git rev-list $listHead | Seq.contains commit

let rawConfig file key = git config --file $file $key | complete

let configGet file key =
    let r = rawConfig file key
    if r.ExitCode == 0 then r.Stdout |> Seq.tryHead |> Option.defaultValue "" else ""

let makeRef name target = !(git update-ref $name $target)

let deleteRef name = !(git update-ref -d $name)

let deleteBranch b =
    if branchExists b then !(git branch -q -D $b)

// ---- encode-subdir (bash: 30 parameter expansions + a C-style
// loop) — one fold over replacement pairs -------------------------

let encodeSubref subdir =
    [
        "%", "%25"
        "..", "%2e%2e"

        " ", "%20"
        "~", "%7e"
        "^", "%5e"
        ":", "%3a"
        "?", "%3f"
        "*", "%2a"

        "[", "%5b"
        @"\", "%5c"
    ]
    |> Seq.fold (fun s (from0, to0) -> Str.replace from0 to0 s) subdir

// ---- .gitrepo reading and writing (bash: read-gitrepo-file /
// update-gitrepo-file mutating 6 globals) -------------------------

let readGitrepo gitrepo =
    let methodRaw = configGet gitrepo "subrepo.method"
    { Remote = configGet gitrepo "subrepo.remote"
      Branch = configGet gitrepo "subrepo.branch"
      Commit = configGet gitrepo "subrepo.commit"
      Parent = configGet gitrepo "subrepo.parent"
      Method = if methodRaw == "rebase" then "rebase" else "merge" }

let gitrepoHeader =
    [ "; DO NOT EDIT (unless you know what you are doing)"
      ";"
      "; This subdirectory is a git \"subrepo\", and this file is maintained by the"
      "; git-subrepo command. See https://github.com/ingydotnet/git-subrepo#readme"
      ";" ]

let writeGitrepo gitrepo repo =
    if not (File.exists gitrepo) then gitrepoHeader |> File.write gitrepo
    !
        git config --file $gitrepo subrepo.remote (repo.Remote)
        git config --file $gitrepo subrepo.branch (repo.Branch)
        git config --file $gitrepo subrepo.commit (repo.Commit)
        git config --file $gitrepo subrepo.parent (repo.Parent)
        git config --file $gitrepo subrepo.method (repo.Method)

let commitMessage verb ctx =
    $"git subrepo {verb} (merge) {ctx.Subdir}"

// ---- context construction ---------------------------------------

let makeCtx subdir =
    let subref = encodeSubref subdir
    let gitrepo = Path.combine subdir ".gitrepo"
    if not (File.exists gitrepo) then fail $"No '{gitrepo}' file."
    { Subdir = subdir
      Subref = subref
      Gitrepo = gitrepo
      Repo = readGitrepo gitrepo
      UpstreamHead = ""
      HeadBranch = $(git symbolic-ref --short --quiet HEAD) |> Seq.head }

// clone/init reach the same shape BEFORE a .gitrepo exists
let makeFreshCtx subdir repo =
    { Subdir = subdir
      Subref = encodeSubref subdir
      Gitrepo = Path.combine subdir ".gitrepo"
      Repo = repo
      UpstreamHead = ""
      HeadBranch = $(git symbolic-ref --short --quiet HEAD) |> Seq.head }

// ---- environment/repo asserts (bash: assert-*) ------------------

let assertRepoReady ctx =
    step "Assert repo state"
    if ctx.HeadBranch |> Str.isMatch @"^subrepo/" then fail "Can't pull while a subrepo branch is checked out."
    !
        // --exit-code instead of --quiet: orFail streams, so the
        // failing paths SHOW [D:exit-reifiers]
        git diff-files --exit-code --ignore-submodules | orFail "Can't pull subrepo. Unstaged changes."
        git diff-index --quiet --cached --ignore-submodules HEAD | orFail "Can't pull subrepo. Index has changes."

// ---- fetch (bash: subrepo:fetch) --------------------------------

let fetchUpstream ctx =
    if ctx.Repo.Remote == "none" then fail $"Can't fetch subrepo. Remote is 'none' in '{ctx.Gitrepo}'."
    step $"Fetch the upstream: {ctx.Repo.Remote} ({ctx.Repo.Branch})."
    !(git fetch --no-tags --quiet (ctx.Repo.Remote) (ctx.Repo.Branch))
    let head = revParse "FETCH_HEAD^0"
    step $"Create ref 'refs/subrepo/{ctx.Subref}/fetch'."
    makeRef $"refs/subrepo/{ctx.Subref}/fetch" head
    { ctx with UpstreamHead = head }

// ---- the graft machinery (bash: subrepo:branch's loop +
// filter-branch) — trees built MINUS .gitrepo via a temp index ----

// the tree of commit:subdir with .gitrepo removed — GIT_INDEX_FILE
// plumbing replaces filter-branch
let subdirTree subdir commit =
    let idx = $(mktemp -u) |> Seq.head
    let e = Env.ofPairs ["GIT_INDEX_FILE", idx]
    !e
        git read-tree $"{commit}:{subdir}"
        git rm -q --cached --ignore-unmatch .gitrepo
    let tree = $e(git write-tree) |> Seq.head
    !(rm -f $idx)
    tree

// author-preserving commit-tree with explicit parents (bash: the
// GIT_AUTHOR_* prefix; committer stays current, cherry-pick-style)
let commitTreeAs date email name msg tree parents =
    let author = Env.ofPairs ["GIT_AUTHOR_DATE", date; "GIT_AUTHOR_EMAIL", email; "GIT_AUTHOR_NAME", name]
    let parentArgs = parents |> Seq.fold (fun acc p -> ["-p"; p] |> Seq.append acc) []
    $author(git commit-tree -m $msg $@parentArgs $tree | complete) |> _.Stdout |> Seq.head

type Walk = {
    Prev: string
    Ancestor: string
    FirstG: string
    LastG: string
}

// one grafted commit per mainline commit that touched the subdir —
// parents: the previous graft, plus the upstream commit when the
// .gitrepo reference moved (the merge-method join)
let graftStep ctx w commit =
    let blob = $(git config --blob $"{commit}:{ctx.Gitrepo}" subrepo.commit | complete)
    if blob.ExitCode <> 0 then w // no .gitrepo in this commit: skip
    else
        let gCommit = blob.Stdout |> Seq.tryHead |> Option.defaultValue ""
        let parentsLine = $(git show -s --format=%P $commit) |> Seq.tryHead |> Option.defaultValue ""
        let isChild = (w.Ancestor == "") || (parentsLine |> Str.contains (w.Ancestor))
        if not isChild then w // not on the single selected path: skip
        else
            // un-hoisted [D:block-let-cmd]: the wrapper existed only
            // because the grammar refused a local binding
            let hasContent = git cat-file -e $"{commit}:{ctx.Subdir}" | succeeds
            if not hasContent then
                // EMPTY-placeholder commits bounded out: keep the path
                { w with Ancestor = commit }
            else
                // fixed-arity seq pattern: exactly the three author lines
                match $(git log -1 --date=default --format=%ad%n%ae%n%an $commit) |> Seq.force with
                | [date; email; name] ->
                    let msg = $(git log -1 --format=%B $commit) |> Str.join "\n"
                    let tree = subdirTree (ctx.Subdir) commit
                    let firstG = if w.FirstG == "" then gCommit else w.FirstG
                    let joins = if (w.FirstG == "") || (not (gCommit == w.LastG)) then [gCommit] else []
                    let parents = joins |> Seq.append (if w.Prev == "" then [] else [w.Prev])
                    step $"Graft {commit}"
                    let newC = commitTreeAs date email name msg tree parents
                    { Prev = newC; Ancestor = commit; FirstG = firstG; LastG = gCommit }
                | _ -> w // malformed author info: skip the commit

let graftBranch ctx branch =
    if branchExists branch then step $"Branch '{branch}' already exists."
    else
        if ctx.Repo.Parent == "" then fail $"No subrepo.parent in '{ctx.Gitrepo}' (the no-parent filter-branch path is bounded out)."
        let ancestorOk = git merge-base --is-ancestor (ctx.Repo.Parent) HEAD | succeeds

        if not ancestorOk then
            fail $"The last sync point {ctx.Repo.Parent} is not an ancestor of HEAD (a rebase moved it?)."
        step $"Walk {ctx.Repo.Parent}..HEAD"
        let walked =
            $(git rev-list --reverse --ancestry-path --topo-order $"{ctx.Repo.Parent}..HEAD")
            |> Seq.fold (fun w c -> graftStep ctx w c) { Prev = ""; Ancestor = ""; FirstG = ""; LastG = "" }
        if walked.Prev == "" then fail $"Nothing to graft: no commit in {ctx.Repo.Parent}..HEAD touches '{ctx.Subdir}'."
        !(git branch -q $branch (walked.Prev))
        makeRef $"refs/subrepo/{ctx.Subref}/branch" (walked.Prev)

// ---- commit (bash: subrepo:commit) — put a fetched upstream tree
// into the subdir and commit to the mainline ----------------------

let commitSubrepo verb force ctx commitRef =
    if not (revExists commitRef) then fail $"Commit ref '{commitRef}' does not exist."
    if not force then
        if not (commitInRevList (ctx.UpstreamHead) commitRef) then
            fail $"Can't commit: '{commitRef}' doesn't contain upstream HEAD."
    let tracked = $(git ls-files -- (ctx.Subdir)) |> Seq.length
    if tracked > 0 then !(git rm -q -r -- (ctx.Subdir))
    step $"Put remote subrepo content into '{ctx.Subdir}/'."
    !(git read-tree $"--prefix={ctx.Subdir}" -u $commitRef)
    writeGitrepo (ctx.Gitrepo) { ctx.Repo with Commit = ctx.UpstreamHead; Parent = revParse "HEAD" }
    !
        git add -f -- (ctx.Gitrepo)
        git commit -q -m (commitMessage verb ctx)
    makeRef $"refs/subrepo/{ctx.Subref}/commit" commitRef

// ---- pull (bash: subrepo:pull — branch, join, commit). The bash
// joins in a WORKTREE; here `git merge-tree --write-tree` does the
// real merge in plumbing, no worktree (the rebase method is bounded
// to merge on this path — a rebase join needs a checkout) ----------

let pull ctx0 =
    let ctx = fetchUpstream ctx0
    if ctx.UpstreamHead == ctx.Repo.Commit then UpToDate
    else
        let branch = $"subrepo/{ctx.Subref}"
        deleteBranch branch
        step $"Create subrepo branch '{branch}'."
        graftBranch ctx branch
        let localHead = revParse branch
        let joined = $(git merge-tree --write-tree $branch $"refs/subrepo/{ctx.Subref}/fetch" | complete)
        if joined.ExitCode <> 0 then
            JoinConflict (joined.Stdout |> Seq.append (joined.Stderr) |> Str.join "\n")
        else
            let tree = joined.Stdout |> Seq.head
            let merged =
                $(git commit-tree -p $localHead -p $"refs/subrepo/{ctx.Subref}/fetch" -m $"subrepo pull merge" $tree)
                |> Seq.head
            makeRef $"refs/subrepo/{ctx.Subref}/pull" merged
            step $"Commit the new '{ctx.Subdir}' content."
            commitSubrepo "pull" true { ctx with Repo = { ctx.Repo with Commit = ctx.UpstreamHead } } merged
            deleteBranch branch
            Pulled

// ---- clone (bash: subrepo:clone, the fresh path) ----------------

let detectHeadBranch remote =
    // cons patterns replace the tryHead/Option layering [D:seq-patterns]
    let symrefs =
        $(git ls-remote --symref $remote HEAD)
        |> Seq.choose (fun l ->
            match l with
            | Regex @"^ref: refs/heads/(\S+)\s+HEAD" b -> Some b
            | _ -> None)

    match symrefs with
    | b :: _ -> b
    | [] ->
        // a bare file remote can carry a dangling HEAD: fall back to
        // the first advertised branch
        let heads =
            $(git ls-remote --heads $remote)
            |> Seq.choose (fun l ->
                match l with
                | Regex @"refs/heads/(\S+)$" b -> Some b
                | _ -> None)

        match heads with
        | b :: _ -> b
        | [] -> "master"

let clone remote subdir branch =
    if not (revExists "HEAD") then fail "You can't clone into an empty repository."
    let tracked = $(git ls-files -- $subdir) |> Seq.length
    if (tracked > 0) || File.exists (Path.combine subdir ".gitrepo") then
        fail $"The subdir '{subdir}' is already tracked (reclone via --force is bounded out; use pull)."
    step $"Fetch '{remote}' ({branch})."

    !(git fetch --no-tags --quiet $remote $branch)
    let head = revParse "FETCH_HEAD^0"
    let repo = { Remote = remote; Branch = branch; Commit = head; Parent = ""; Method = "merge" }
    let ctx = { makeFreshCtx subdir repo with UpstreamHead = head }

    makeRef $"refs/subrepo/{ctx.Subref}/fetch" head
    commitSubrepo "clone" true ctx head
    say $"Subrepo '{remote}' ({branch}) cloned into '{subdir}'."

// ---- init (bash: subrepo:init) ----------------------------------

let init subdir remote branch =
    let tracked = $(git ls-files -- $subdir) |> Seq.length
    if tracked == 0 then fail $"The subdir '{subdir}' is not part of this repo."
    if File.exists (Path.combine subdir ".gitrepo") then fail $"The subdir '{subdir}' is already a subrepo."
    let repo =
        { Remote = remote |> Option.defaultValue "none"
          Branch = branch |> Option.defaultValue "master"
          Commit = ""
          Parent = revParse "HEAD"
          Method = "merge" }
    let ctx = makeFreshCtx subdir repo
    writeGitrepo (ctx.Gitrepo) repo
    !
        git add -f -- (ctx.Gitrepo)
        git commit -q -m (commitMessage "init" ctx)
    makeRef $"refs/subrepo/{ctx.Subref}/commit" (revParse "HEAD")
    say $"Subrepo created from '{subdir}' (remote: {repo.Remote})."

// ---- push (bash: subrepo:push, merge-method graft) --------------

let push force ctx0 =
    let branch = $"subrepo/{ctx0.Subref}"
    let fetched = $(git fetch --no-tags --quiet (ctx0.Repo.Remote) (ctx0.Repo.Branch) | complete)
    let fetchErr = fetched.Stderr |> Str.join "\n"
    let newUpstream =
        (fetched.ExitCode <> 0) && (fetchErr |> Str.toLower |> Str.contains "couldn't find remote ref")
    if (fetched.ExitCode <> 0) && not newUpstream then fail $"Fetch for push failed: {fetchErr}"
    let ctx =
        if newUpstream then ctx0
        else
            let head = revParse "FETCH_HEAD^0"
            makeRef $"refs/subrepo/{ctx0.Subref}/fetch" head
            if (not force) && (not (head == ctx0.Repo.Commit)) then
                fail "There are new changes upstream, you need to pull first."
            { ctx0 with UpstreamHead = head }
    deleteBranch branch
    graftBranch ctx branch
    let newHead = revParse branch
    if (not newUpstream) && (newHead == ctx.UpstreamHead) then
        deleteBranch branch
        say $"Subrepo '{ctx.Subdir}' has no new commits to push."
    else
        if (not force) && (not newUpstream) then
            if not (commitInRevList (ctx.UpstreamHead) branch) then
                fail $"Can't push: '{branch}' doesn't contain upstream HEAD {ctx.UpstreamHead}."
        step $"Push branch '{branch}' to '{ctx.Repo.Remote}' ({ctx.Repo.Branch})."
        if force then
            !(git push -q --force (ctx.Repo.Remote) $"{branch}:{ctx.Repo.Branch}")
        else
            !(git push -q (ctx.Repo.Remote) $"{branch}:{ctx.Repo.Branch}")
        makeRef $"refs/subrepo/{ctx.Subref}/push" branch
        deleteBranch branch
        writeGitrepo (ctx.Gitrepo) { ctx.Repo with Commit = newHead; Parent = revParse "HEAD" }
        !
            git add -f -- (ctx.Gitrepo)
            git commit -q -m (commitMessage "push" ctx)
        say $"Subrepo '{ctx.Subdir}' pushed to '{ctx.Repo.Remote}' ({ctx.Repo.Branch})."

// ---- clean (bash: subrepo:clean) --------------------------------

let clean force ctx =
    let branch = $"subrepo/{ctx.Subref}"
    if branchExists branch then
        deleteBranch branch
        say $"Removed branch '{branch}'."
    if force then
        $(git show-ref)
        |> Seq.choose (fun line ->
            match line with
            | Regex @"^[0-9a-f]+ (refs/subrepo/\S+)$" r -> Some r
            | _ -> None)
        |> Seq.where (Str.contains (ctx.Subref))
        |> Seq.force
        |> Seq.iter (fun r ->
            deleteRef r
            say $"Removed ref '{r}'.")

// ---- status (bash: status-refs' while-read + BASH_REMATCH) ------

let statusRefs ctx =
    $(git show-ref)
    |> Seq.choose (fun line ->
        match line with
        | Regex @"^([0-9a-f]+) refs/subrepo/.*/(branch|commit|fetch|pull|push)$" (sha, kind) ->
            Some $"    {Str.toUpper kind} Ref:  {sha}"
        | _ -> None)

let status ctx =
    print $"Git subrepo '{ctx.Subdir}':"
    if branchExists $"subrepo/{ctx.Subref}" then print $"  Subrepo Branch:  subrepo/{ctx.Subref}"
    print $"  Remote URL:      {ctx.Repo.Remote}"
    print $"  Tracking Branch: {ctx.Repo.Branch}"
    if not (ctx.Repo.Commit == "") then print $"  Pulled Commit:   {ctx.Repo.Commit}"
    if verbose then statusRefs ctx |> Seq.iter print

// ---- dispatch — the match the checker exhaustiveness-verifies:
// adding a Cmd case makes this a check-time obligation ------------

match cli.cmd with
| Status a ->
    status (makeCtx a.subdir)

| Fetch a ->
    let ctx = fetchUpstream (makeCtx a.subdir)
    say $"Fetched '{ctx.Subdir}' from '{ctx.Repo.Remote}' ({ctx.Repo.Branch})."

| Pull a ->
    let ctx = makeCtx a.subdir
    assertRepoReady ctx
    (match pull ctx with
        | Pulled -> say $"Subrepo '{ctx.Subdir}' pulled from '{ctx.Repo.Remote}' ({ctx.Repo.Branch})."
        | UpToDate -> say $"Subrepo '{ctx.Subdir}' is up to date."
        | JoinConflict out ->
            printerr $"The join failed:"
            printerr out
            exit 1)

| Clone a ->
    // the Option match lives HERE, where a.branch is nominally typed
    // (params never infer from ctor patterns — the standing bound)
    let branch =
        match a.branch with
        | Some b -> b
        | None -> detectHeadBranch (a.remote)

    clone (a.remote) (a.subdir) branch

| Init a ->
    init (a.subdir) (a.remote) (a.branch)

| Push a ->
    let ctx = makeCtx a.subdir
    assertRepoReady ctx
    push (a.force) ctx

| Branch a ->
    let ctx = fetchUpstream (makeCtx a.subdir)
    graftBranch ctx $"subrepo/{ctx.Subref}"
    say $"Created branch 'subrepo/{ctx.Subref}'."

| Commit a ->
    let ctx = fetchUpstream (makeCtx a.subdir)
    commitSubrepo "commit" (a.force) ctx $"refs/subrepo/{ctx.Subref}/fetch"
    say $"Subrepo '{ctx.Subdir}' committed."

| Clean a ->
    clean (a.force) (makeCtx a.subdir)
